---
/**
 * The widget page (the Sketch frame "18 Widget da cidade", ticket #29): choose a city, see its embeddable widget at 390 and 320 px wide and
 * copy the one-line snippet. Reached from "Para jornalistas e associações" on "Sobre os dados".
 */
import Base from '@/layouts/Base.astro'
import WidgetBuilder from '@/components/WidgetBuilder'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { NAV_CHIP_QUIET_PRIMARY } from '@/shared/link-classes'
import PageMain from '@/components/PageMain.astro'

const base = siteBase()
// The #113 base-path helper (`base` stays for the WidgetBuilder island, which takes the base argument).
const href = siteHref
const fixture = await datasetFixture()
---
<Base title="Widget da cidade · Voto a Voto" description="Cole no seu site o resultado de uma cidade e um link de volta.">
  <PageMain md="480" data-page="widget">
    <a class={NAV_CHIP_QUIET_PRIMARY} href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Widget da cidade</h1>
    <p class="mt-1 text-step-1 text-muted-foreground">Cole no seu site: o resultado de uma cidade e um link de volta.</p>
    <WidgetBuilder client:load base={base} origin={siteOrigin()} />
    <noscript><p class="mt-2 text-step-1" data-nojs>Montar o snippet precisa de JavaScript. O widget de uma cidade fica em /embed/uf/cidade/ (por exemplo, /embed/rj/cidade-exemplo/).</p></noscript>
    <p class="mt-3 text-center text-step-1 text-muted-foreground" data-note>O widget não tem script nem análise de uso: nada é medido a partir do seu site. Mostra sempre a fonte e a edição, e não tem barras de rolagem em 320 e 390 px.</p>
    {/* The #113 shared footer with this page's variant (#116): the " · " separator and the plain about link. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </PageMain>
</Base>
