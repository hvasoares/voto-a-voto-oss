---
import Base from '@/layouts/Base.astro'
import { COMPARE_CYCLES, formatSignedInt, type CompareCycle } from '@/lib/compare'
import { buildCompareRows, stateStats } from '@/lib/compare-data'
import { formatInt } from '@site/shared/city-model'
import { normalizeBase, withBase } from '@site/paths'

export async function getStaticPaths() {
  return COMPARE_CYCLES.map((ciclo) => ({ params: { ciclo: String(ciclo) } }))
}

const ciclo = Number(Astro.params.ciclo) as CompareCycle
const other = COMPARE_CYCLES.find((c) => c !== ciclo)!
// The frame's rows: the two candidates of 2026 (short labels come from candidates.csv, never hard-coded).
const sidesOf = (row: (typeof rows)[number]) => [
  { side: row.left, token: 'lula' },
  { side: row.rival, token: 'bolsonaro' },
] as const

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const rows = (await buildCompareRows(await stateStats(), ciclo)).slice(0, 6)
// The frame's intro; the 2018 page adds the note that names the 2018 candidates (screen 11b).
const note2018 = ciclo === 2018 ? ' Candidatos de 2018: o do PT (13) e Bolsonaro (17).' : ''
const intro = `Eleição presidencial 2026 (2º turno) comparada com a de ${ciclo} (2º turno), nos mesmos municípios.${note2018} Percentuais = % dos votos válidos; votos = 2026 menos ${ciclo}. Os 6 estados com mais votos válidos.`
---

<Base title={`Comparar com ${ciclo} · Voto a Voto`}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-16" id="main" data-page={`comparar-${ciclo}`}>
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px]" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px]">Comparar com {ciclo}</h1>

    <nav class="mt-1 grid grid-cols-2 rounded-md border border-border p-px" aria-label="Ciclo de comparação" data-component="cycle-tabs">
      {COMPARE_CYCLES.map((c) =>
        c === ciclo ? (
          <span class="flex min-h-11 items-center justify-center rounded-md bg-primary px-3 text-body font-bold leading-[17px] text-primary-foreground" aria-current="page" data-tab={String(c)}>{c}</span>
        ) : (
          <a class="flex min-h-11 items-center justify-center rounded-md bg-secondary px-3 text-body font-bold leading-[17px]" href={href(`/comparar/${c}/`)} data-tab={String(c)}>{c}</a>
        ),
      )}
    </nav>

    <p class="mt-2" data-component="intro">{intro}</p>

    <ul class="mt-2 list-none p-0" data-component="compare-rows">
      {rows.map((row) => (
        <li class="border-t border-border py-2.5 first:border-t-0" data-uf={row.uf}>
          <div class="flex items-baseline justify-between gap-2">
            <a class="min-h-11 text-body font-bold leading-[17px] focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={href(`/${row.uf}/`)}>{row.uf.toUpperCase()}</a>
            <span class="text-small leading-[14px] text-muted-foreground">{formatInt(row.validos)} votos válidos</span>
          </div>
          <div class="mt-1">
            {sidesOf(row).map(({ side, token }) => (
              <div class="flex items-start py-[3px] text-body leading-[17px]" data-side={side.label}>
                <span class={`mt-[3px] mr-[5px] h-[11px] w-[11px] flex-none rounded-[2px] ${token === 'lula' ? 'bg-lula' : 'bg-bolsonaro'}`} aria-hidden="true"></span>
                <span class="min-w-0 flex-1 wrap-anywhere">
                  <strong class="font-bold">{side.label}</strong>
                  {' '}{side.pct26}% · {ciclo}: {side.pctOld}% · <span class="tabular-nums">{formatSignedInt(side.diffVotes)}</span> votos
                  <span class="sr-only"> ({side.votos26} em 2026; {side.votosOld} em {ciclo})</span>
                </span>
              </div>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </main>
  <footer class="mx-auto w-full max-w-[430px] mt-2 border-t border-border px-5 pb-6 pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</Base>