---
/**
 * The A3 city sheet (#66): ONE page for every city (the place is in the address, `?mora=uf/cidade`), drawn in the browser from the city's own shard. Printing is the
 * browser's own print command (`@page A3`). No page links here yet except the press page; the address is the way in.
 */
import Base from '@/layouts/Base.astro'
import PressSheet from '@/components/PressSheet'
import { normalizeBase, withBase } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-press'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { loadCityRoutes } from '@/lib/city-routes'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const say = (key: string) => message(DEFAULT_VOICE, key as never)
const fixture = await datasetFixture()
const edition = await currentEdition()
const [first] = await loadCityRoutes()
const example = first ? `?mora=${first.uf}/${first.slug}` : '?mora=uf/cidade'
---
<Base title={`${say('press.sheet.title')} · Voto a Voto`}>
  <main class="mx-auto min-w-0 w-full max-w-[880px] flex-1 px-5 pt-3" id="main" data-page="imprensa-folha">
    <div class="print:hidden">
      <a class="inline-flex min-h-11 items-center text-body font-bold text-primary" href={href('/imprensa/')}>{say('press.back')}</a>
      <h1 class="mt-1 font-serif text-title font-normal leading-[30px]">{say('press.sheet.title')}</h1>
    </div>
    <PressSheet client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} example={example} />
    <noscript><p class="mt-2 text-small leading-[17px]" data-nojs>{say('press.sheet.nojs')}</p></noscript>
  </main>
</Base>
<style is:global>
  @page { size: 297mm 420mm; margin: 0; }
  @media print {
    html, body { background: #faf7f0 !important; }
    body { padding: 0 !important; margin: 0 !important; }
    body > div > *:not(main) { display: none !important; }
    [data-page='imprensa-folha'] { max-width: none; width: 297mm; height: 420mm; padding: 0; margin: 0; overflow: hidden; }
    [data-page='imprensa-folha'] .sheet { width: 297mm; height: 420mm; box-sizing: border-box; padding: 16mm; margin: 0; display: flex; flex-direction: column; }
    [data-page='imprensa-folha'] [data-sheet], [data-page='imprensa-folha'] [data-sheet-page] { height: 420mm; }
    [data-page='imprensa-folha'] .sheet__chart { flex: 1 1 0; min-height: 0; }
    [data-page='imprensa-folha'] .sheet__chart svg { width: 100% !important; height: 100% !important; }
    [data-page='imprensa-folha'] .sheet__foot { margin-top: 6mm; }
    [data-page='imprensa-folha'] .sheet__qr svg { width: 60mm !important; height: 60mm !important; }
    [data-page='imprensa-folha'] .sheet__foot p { font-size: 6mm; line-height: 8mm; }
    [data-page='imprensa-folha'] .sheet__source { font-size: 5mm; }
  }
</style>
