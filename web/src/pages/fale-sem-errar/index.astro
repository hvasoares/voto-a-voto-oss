---
/**
 * "Fale sem errar" (#67; the Sketch frame "C3 Fale sem errar"): the guide for people who talk about a city live or on video. Ready phrases for a city (a React island: the city
 * is in the address, `?mora=uf/cidade`, or chosen in the field), the "Não diga" list, the published wording rules and a citation line with the current edition. No ads and no
 * analytics: the page uses the quiet shell (no metrics boot) and its island does not import the analytics. Nothing links here yet: the address is the way in.
 */
import QuietDoc from '@/layouts/QuietDoc.astro'
import CreatorGuide from '@/components/CreatorGuide'
import { normalizeBase, withBase } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-guide'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { editionLabel } from '@/lib/editions'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const say = (key: string, params: Record<string, string | number> = {}) => message(DEFAULT_VOICE, key as never, params)
const edition = await currentEdition()
const label = editionLabel(edition)
const never = [1, 2, 3, 4]
const rules = [1, 2, 3, 4, 5, 6]
---
<QuietDoc title={`${say('guide.title')} · Voto a Voto`} description={say('guide.sub')}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[720px] lg:pt-8" id="main" data-page="fale-sem-errar">
    <a class="inline-flex min-h-11 items-center text-body font-bold text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-1 font-serif text-title font-normal leading-[30px] lg:text-[34px] lg:leading-[40px]">{say('guide.title')}</h1>
    <p class="mt-1 text-body leading-[19px] text-muted-foreground">{say('guide.sub')}</p>
    <CreatorGuide client:load base={base} origin={siteOrigin()} edition={label}>

    <section class="mt-4 border-t border-border pt-3" aria-labelledby="nao-diga" data-never>
      <h2 id="nao-diga" class="font-serif text-section font-normal leading-[30px]">{say('guide.never.title')}</h2>
      <ul class="mt-2">
        {never.map((n) => (
          <li class="flex gap-3 border-t border-border py-2">
            <span aria-hidden="true" class="font-bold text-destructive">×</span>
            <div>
              <p class="text-body font-bold leading-[19px]">{say(`guide.never.${n}`)}</p>
              <p class="text-small leading-[17px] text-muted-foreground">{say(`guide.never.${n}.say`)}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-4 border-t border-border pt-3" aria-labelledby="regras" data-rules>
      <h2 id="regras" class="font-serif text-section font-normal leading-[30px]">{say('guide.rules.title')}</h2>
      <ul class="mt-2 list-disc pl-5 text-body leading-[21px]">
        {rules.map((n) => <li>{say(`guide.rules.${n}`)}</li>)}
      </ul>
    </section>
    </CreatorGuide>

    <p class="mt-3 text-small leading-[17px] text-muted-foreground">{say('guide.cite.note')}</p>
    <p class="mt-3 flex flex-wrap justify-between gap-x-6 text-body font-bold leading-[19px]" data-guide-links>
      <a class="min-h-11 py-2 text-primary" href={href('/overlay/')} data-link-overlay>{say('guide.link.overlay')}</a>
      <a class="min-h-11 py-2 text-primary" href={href('/adivinhe/')} data-link-game>{say('guide.link.game')}</a>
    </p>
    <p class="mt-3 text-small leading-[17px] text-muted-foreground" data-noads>{say('guide.noads')}</p>
    <footer class="mt-3 border-t border-border pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
      Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </main>
</QuietDoc>
