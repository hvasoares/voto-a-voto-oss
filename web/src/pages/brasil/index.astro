---
/**
 * Screen 8 (ticket #10): Brasil e regiões — the national and regional runoff view.
 * Fully server-rendered static HTML: the screen has no interaction of its own beyond ordinary links,
 * so no React island (conventions: "plain HTML first"); the numbers are the build-time aggregation of
 * web/src/lib/brasil.ts over the chosen DATA_DIR. National totals include the overseas posts, the
 * regions exclude them and say so.
 */
import { formatInt } from '@/shared/city-model'
import { normalizeBase, withBase } from '@/paths'
import Base from '@/layouts/Base.astro'
import { isFixtureDataset, loadBrasil } from '@/lib/brasil-load'
import { cn } from '@/lib/utils'
import PageDataDownload from '@/components/PageDataDownload.astro'
import Seal from '@/components/Seal.astro'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'
import { nerdsPath } from '@/lib/nerds/paths'
import { placesWithShards } from '@/lib/nerds/shards'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const view = await loadBrasil()
const fixture = await isFixtureDataset()
const nerds = placesWithShards()
// Fact records (#62): every bar and region links to its record; the seal is written from the build's checks.
const facts = await getFactPage('brasil', `${view.ano}-${view.turno}`)
const links = factLinks(facts.facts, '/brasil/', base)
const seal = await sealOf(facts)

// Colors of the Sketch frame 8: the first candidate of a bar (lower ballot number) is the red one,
// the second the blue one; the turnout bar fills "Compareceram" with the dark taupe (v2/ring) and
// "Não" — the abstention slice — with v2/abstencao. Bars carry the 2 px paper gap the frame shows
// between slices; the national bar is inset by a gutter step and 28 px tall, region bars full width.
// Slice labels are 600 10 px (the old-site state-page/cycle-bar idiom); NB: `text-small` must not go
// through cn() with a text color here (tailwind-merge drops the unknown token class) — every segment
// carries its own text size.
const candidateSeg = 'bg-[var(--c-lula)] text-[var(--c-accent-fg)] text-[10px] font-semibold'
const secondSeg = 'bg-[var(--c-bolsonaro)] text-[var(--c-accent-fg)] text-[10px] font-semibold'
const turnoutSeg = 'bg-[var(--c-ring)] text-[var(--c-ink)] text-[10px] font-semibold leading-[13px]'
const notTurnoutSeg = 'bg-[var(--c-abstencao)] text-[var(--c-ink)] text-[10px] font-semibold leading-[13px]'
const segBase = 'flex min-w-0 items-center justify-center overflow-hidden whitespace-nowrap'
---
<Base title="Brasil e regiões · Voto a Voto">
  <main class="mx-auto w-full min-w-0 max-w-[430px] flex-1 px-5 pt-16 pb-2 md:max-w-[760px] lg:pt-8" id="main" data-brasil-view>
    {
      fixture && (
        <p role="note" class="-mx-5 -mt-16 mb-10 lg:-mt-8 lg:mb-6 bg-[var(--c-flag)] px-[var(--gutter)] py-2 text-center font-bold text-small text-[var(--c-ink)]">
          EXEMPLO · DADOS FICTÍCIOS, NÃO SÃO RESULTADOS REAIS
        </p>
      )
    }
    <p class="mb-3 print:hidden">
      <a class="-ml-2 inline-flex min-h-12 min-w-[116px] items-center rounded-[var(--radius)] border border-border bg-background px-4 text-[15px] text-[var(--c-ink)] lg:ml-0 lg:min-h-8 lg:min-w-0 lg:border-0 lg:px-0 lg:text-[14px] lg:text-primary" href={href('/')}>‹ Início</a>
    </p>
    <h1 class="font-serif text-[26px] font-normal leading-[36px] wrap-anywhere lg:text-[44px] lg:leading-[52px]">Brasil e regiões</h1>
    {/* State-page ramp of the old site, measured from the same design family (site/src/shared/base.css
    .state-page): title 26/36, subtitle 14/16 pulled 4px up against the title, back button 15px. */}
    <p class="mt-[-4px] text-[13px] leading-[15px] text-muted-foreground">2º turno de {view.ano}</p>
    <p class="mt-1"><a class="inline-flex min-h-11 items-center text-body font-bold text-primary" data-link="nerds" href={href(`/${nerdsPath({ level: 'brasil' })}`)}>Dados para nerds ›</a></p>

    <section class="pt-6" aria-labelledby="brasil-votos-validos" data-brasil-national>
      <h2 id="brasil-votos-validos" class="pl-4 text-[13px] font-bold leading-[14px]">Brasil, votos válidos</h2>
      <div class="mx-4 mt-2 flex h-7 gap-[2px]" role="img" aria-label="Votos válidos no Brasil, por candidato" data-brasil-bar>
        {view.nationalCandidates.map((c, i) => (
          <span
            class={cn(segBase, i === 0 ? candidateSeg : secondSeg)}
            style={`flex-grow:${c.pctScaled};flex-basis:0`}
            title={`${c.labelFull}: ${formatInt(c.votos)} votos (${c.pctText}%)`}
          >
            {i === 0 ? `${c.label} ${formatInt(c.votos)} · ${c.pctText}%` : `${c.label} ${formatInt(c.votos)}`}
          </span>
        ))}
      </div>
      <p class="mt-2 pl-4 text-small text-[var(--c-ink)]">
        100% da barra = votos válidos de {view.nationalCandidates[0]!.labelFull} + {view.nationalCandidates[1]!.labelFull}
      </p>
      <p class="mt-1 pl-4"><Fragment set:html={calcLink(links(`pais-${view.nationalCandidates[0]!.numero}`))} /></p>
    </section>

    <section class="pt-6" aria-labelledby="brasil-por-regiao" data-brasil-regioes>
      <h2 id="brasil-por-regiao" class="font-serif text-[16px] font-normal leading-[21px]">Por região</h2>
      {/* the frame's legend caption runs at ~10 px with a ~12 px pitch and breaks after "(Não =" */}
      <p class="mt-1 text-[10px] leading-[12px] text-muted-foreground">
        Barra de cima: % dos votos válidos. Barra de baixo: % do eleitorado (Não ={' '}
        <br />não compareceram).
      </p>
      <ul class="mt-1 list-none p-0">
        {view.regions.map((r) => (
          <li class="pt-1.5" data-regiao={r.regiao}>
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-[13px] font-bold leading-[16px]">{r.label}</h3>
              <p class="text-right text-[11px] text-[var(--c-ink)]">{r.shareText}% dos votos válidos do país</p>
            </div>
            <div class="mt-1 flex h-6 gap-[2px]" role="img" aria-label={`${r.label}: votos válidos, por candidato`}>
              {r.candidates.map((c, i) => (
                <span
                  class={cn(segBase, i === 0 ? candidateSeg : secondSeg)}
                  style={`flex-grow:${c.pctScaled};flex-basis:0`}
                  title={`${c.labelFull}: ${c.pctText}% dos votos válidos da região`}
                >
                  {`${c.label} ${c.pctText}%`}
                </span>
              ))}
            </div>
            <div class="mt-0.5 flex h-6 gap-[2px]" role="img" aria-label={`${r.label}: eleitorado que compareceu e que não compareceu`}>
              <span class={cn(segBase, turnoutSeg)} style={`flex-grow:${r.compareceramScaled};flex-basis:0`}>{`Compareceram ${r.compareceramText}%`}</span>
              <span class={cn(segBase, notTurnoutSeg)} style={`flex-grow:${1000 - r.compareceramScaled};flex-basis:0`}>{`Não ${r.naoText}%`}</span>
            </div>
            <p class="mt-0.5 text-[10px] leading-[13px] text-muted-foreground" data-brancos-nulos>
              Brancos {r.brancosText}% · Nulos {r.nulosText}% do comparecimento.
            </p>
            <p class="mt-0.5 text-right"><Fragment set:html={calcLink(links(`${r.regiao}-parcela`))} /></p>
            {nerds.regioes.includes(r.regiao) && <p class="mt-0.5 text-right"><a class="inline-flex min-h-11 items-center text-small font-bold text-primary" data-link="nerds-regiao" href={href(`/${nerdsPath({ level: 'regiao', id: r.regiao })}`)}>Dados da região ›</a></p>}
          </li>
        ))}
      </ul>
      <p class="mt-3 text-[10px] leading-[13px] text-[var(--c-ink)]" data-brasil-note>
        Não compareceram = eleitorado que não compareceu. Brancos e nulos fazem parte do comparecimento e aparecem em cada região.
      </p>
    </section>

    <Seal lines={seal} />

    <nav class="mt-5 flex items-center justify-between border-t border-border pt-2" aria-label="Próximo">
      <a class="inline-flex min-h-11 items-center text-body font-bold text-foreground" href={href('/mapa/')}>Ver mapa por estado ›</a>
      <a class="inline-flex min-h-11 items-center text-body font-bold text-foreground" data-link="compare" href={href('/cara-a-cara/?nivel=regiao')}>Comparar regiões ›</a>
      <PageDataDownload href={href('/brasil/dados.json')} filename="brasil.json" placement="row" />
    </nav>
  </main>
  <footer class="mx-5 mt-2 pb-6 pt-2 text-center text-small md:mx-auto md:max-w-[720px] lg:text-left text-muted-foreground" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</Base>