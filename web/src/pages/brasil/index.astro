---
/**
 * Screen 8 (ticket #10): Brasil e regiões — the national and regional runoff view.
 * Fully server-rendered static HTML: the screen has no interaction of its own beyond ordinary links,
 * so no React island (conventions: "plain HTML first"); the numbers are the build-time aggregation of
 * web/src/lib/brasil.ts over the chosen DATA_DIR. National totals include the overseas posts, the
 * regions exclude them and say so.
 */
import { formatInt } from '@site/shared/city-model'
import { normalizeBase, withBase } from '@site/paths'
import Base from '@/layouts/Base.astro'
import { isFixtureDataset, loadBrasil } from '@/lib/brasil-load'
import { cn } from '@/lib/utils'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const view = await loadBrasil()
const fixture = await isFixtureDataset()

// Colors of the Sketch frame 8: the first candidate of a bar (lower ballot number) is the red one,
// the second the blue one; turnout bar = warm grey bar, "Não" barely filled.
const candidateSeg = 'bg-[var(--c-lula)] text-[var(--c-accent-fg)]'
const secondSeg = 'bg-[var(--c-bolsonaro)] text-[var(--c-accent-fg)]'
const turnoutSeg = 'bg-[var(--c-abstencao)] text-[var(--c-ink)]'
const notTurnoutSeg = 'bg-[var(--c-paper-2)] text-[var(--c-ink)]'
const segBase = 'flex min-w-0 items-center justify-center overflow-hidden text-small'
---
<Base title="Brasil e regiões · Voto a Voto">
  <main class="min-w-0 flex-1 px-5 pt-16 pb-2" id="main" data-brasil-view>
    {
      fixture && (
        <p role="note" class="-mx-5 -mt-16 mb-10 bg-[var(--c-flag)] px-[var(--gutter)] py-2 text-center font-bold text-small text-[var(--c-ink)]">
          EXEMPLO · DADOS FICTÍCIOS, NÃO SÃO RESULTADOS REAIS
        </p>
      )
    }
    <p class="mb-3 print:hidden">
      <a class="inline-flex min-h-11 items-center rounded-[var(--radius)] border border-border bg-background px-4 text-lead text-[var(--c-ink)]" href={href('/')}>‹ Início</a>
    </p>
    <h1 class="font-serif text-title font-normal leading-[33px] wrap-anywhere">Brasil e regiões</h1>
    <p class="mt-1 text-lead text-muted-foreground">2º turno de {view.ano}</p>

    <section class="pt-10" aria-labelledby="brasil-votos-validos" data-brasil-national>
      <h2 id="brasil-votos-validos" class="pl-4 text-body font-bold leading-[20px]">Brasil, votos válidos</h2>
      <div class="mt-3 flex h-6" role="img" aria-label="Votos válidos no Brasil, por candidato" data-brasil-bar>
        {view.nationalCandidates.map((c, i) => (
          <span
            class={cn(segBase, i === 0 ? candidateSeg : secondSeg)}
            style={`flex-grow:${c.pctScaled};flex-basis:0`}
            title={`${c.labelFull}: ${formatInt(c.votos)} votos (${c.pctText}%)`}
          >
            {i === 0 ? `${c.label} ${formatInt(c.votos)} · ${c.pctText}%` : `${c.label} ${formatInt(c.votos)}`}
          </span>
        ))}
      </div>
      <p class="mt-2 pl-4 text-small text-[var(--c-ink)]">
        100% da barra = votos válidos de {view.nationalCandidates[0]!.labelFull} + {view.nationalCandidates[1]!.labelFull}
      </p>
    </section>

    <section class="pt-10" aria-labelledby="brasil-por-regiao" data-brasil-regioes>
      <h2 id="brasil-por-regiao" class="font-serif text-section font-normal leading-[25px]">Por região</h2>
      <p class="mt-1 text-small leading-[16px] text-muted-foreground">
        Barra de cima: % dos votos válidos. Barra de baixo: % do eleitorado (Não = não compareceram).
      </p>
      <ul class="mt-1 list-none p-0">
        {view.regions.map((r) => (
          <li class="pt-5" data-regiao={r.regiao}>
            <div class="flex items-baseline justify-between gap-2">
              <h3 class="text-lead font-bold leading-[20px]">{r.label}</h3>
              <p class="text-right text-small text-[var(--c-ink)]">{r.shareText}% dos votos válidos do país</p>
            </div>
            <div class="mt-2 flex h-6" role="img" aria-label={`${r.label}: votos válidos, por candidato`}>
              {r.candidates.map((c, i) => (
                <span
                  class={cn(segBase, i === 0 ? candidateSeg : secondSeg)}
                  style={`flex-grow:${c.pctScaled};flex-basis:0`}
                  title={`${c.labelFull}: ${c.pctText}% dos votos válidos da região`}
                >
                  {`${c.label} ${c.pctText}%`}
                </span>
              ))}
            </div>
            <div class="mt-1 flex h-6" role="img" aria-label={`${r.label}: eleitorado que compareceu e que não compareceu`}>
              <span class={cn(segBase, turnoutSeg)} style={`flex-grow:${r.compareceramScaled};flex-basis:0`}>{`Compareceram ${r.compareceramText}%`}</span>
              <span class={cn(segBase, notTurnoutSeg)} style={`flex-grow:${1000 - r.compareceramScaled};flex-basis:0`}>{`Não ${r.naoText}%`}</span>
            </div>
            <p class="mt-1 text-small leading-[16px] text-muted-foreground" data-brancos-nulos>
              Brancos {r.brancosText}% · Nulos {r.nulosText}% do comparecimento.
            </p>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-small leading-[18px] text-[var(--c-ink)]" data-brasil-note>
        Não compareceram = eleitorado que não compareceu. Brancos e nulos fazem parte do comparecimento e aparecem em cada região.
      </p>
    </section>

    <nav class="mt-5 border-t border-border pt-2" aria-label="Próximo">
      <a class="inline-flex min-h-11 items-center text-body font-bold text-foreground" href={href('/mapa/')}>Ver mapa por estado ›</a>
    </nav>
  </main>
  <footer class="mx-5 mt-2 pb-6 pt-2 text-center text-small text-muted-foreground" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</Base>