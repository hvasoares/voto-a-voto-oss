---
/**
 * The share sheet of /brasil/ (#91): the SAME sheet as the City card's (`components/ShareScreen.astro`), scope `brasil` (#137). The picture and its words are
 * pre-rendered from the page's own numbers (`lib/brasil-content.ts`); without scripts the picture and the text are on the page and only the buttons are missing.
 */
import ShareScreen from '@/components/ShareScreen.astro'
import BrasilScreen from '@/components/BrasilScreen.astro'
import { shareScreenConfig } from '@/lib/screen-scopes'

const config = await shareScreenConfig({ scope: 'brasil' })
---
<ShareScreen config={config}>
  <BrasilScreen slot="backdrop" backdrop />
</ShareScreen>
