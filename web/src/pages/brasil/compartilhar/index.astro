---
/**
 * The share sheet of /brasil/ (#91): the SAME sheet as the City card's (`/:uf/:slug/compartilhar/`): a bottom sheet over the page as its dimmed backdrop (from 768 px a centred
 * dialog), the picture, the message text, the `ShareActions` island (the system share where the browser has it; otherwise Copiar link and Baixar imagem) and Mostrar QR.
 * The picture and its words are pre-rendered from the page's own numbers (`lib/brasil-content.ts`: headline sentence from the catalog, no winner, no ranking, no cause);
 * without scripts the picture and the text are on the page and only the buttons are missing.
 */
import Base from '@/layouts/Base.astro'
import BrasilScreen from '@/components/BrasilScreen.astro'
import ShareActions from '@/components/ShareActions'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { FOOTER_LINK } from '@/shared/link-classes'
import { isFixtureDataset, loadBrasil } from '@/lib/brasil-load'
import { brasilContent } from '@/lib/brasil-content'
import { brasilNoJs, brasilShareNote } from '@/lib/sentences/brasil'
import { currentEdition } from '@/lib/editions-load'
import { siteOrigin } from '@/lib/share-url'

const base = siteBase()
// The #113 base-path helper (`base` stays for brasilContent's base argument).
const href = siteHref
const view = await loadBrasil()
const fixture = await isFixtureDataset()
const edition = await currentEdition()
const content = brasilContent(view, { origin: siteOrigin(), base, fixture, edition: edition.id })
---
<Base title="Compartilhar · Brasil e regiões" description={content.variants.standard.alt}>
  <div>
    <div data-share-backdrop aria-hidden="true" inert class="pointer-events-none select-none opacity-35">
      <BrasilScreen backdrop />
    </div>

    {/* From 768 px the sheet is a centered dialog over a dimmed page (from 1024 px the top bar stays above the dimming). */}
    <div class="fixed inset-0 z-40 hidden bg-[rgba(28,27,24,0.45)] md:block lg:top-16" aria-hidden="true" data-share-dim></div>

    <section
      data-share-sheet
      id="main"
      data-view="brasil"
      data-filename={content.filename}
      class="fixed inset-x-0 bottom-0 z-50 max-h-[100dvh] overflow-y-auto rounded-t-2xl border border-border bg-background px-5 pt-2 pb-6 shadow-[0_-4px_16px_rgba(28,27,24,0.25)] md:inset-x-auto md:bottom-auto md:left-1/2 md:top-[110px] md:max-h-[calc(100dvh-140px)] md:w-[480px] md:-translate-x-1/2 md:rounded-2xl md:px-7 md:pb-7 md:pt-6"
    >
      <span class="mx-auto block h-1.5 w-16 rounded-full bg-muted md:hidden" aria-hidden="true"></span>
      <div class="flex items-baseline justify-between">
        <h1 class="font-serif text-step-4 font-normal">Compartilhar resultado</h1>
        <a class="inline-flex min-h-11 items-center px-1 text-step-2 font-bold" href={href('/brasil/')} data-close>Fechar<span class="hidden md:inline" aria-hidden="true"> ×</span></a>
      </div>
      <div class="mx-auto mt-2 flex-none md:max-w-[240px] [&>svg]:mx-auto [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" data-share-picture data-card="brasil" set:html={content.svg} />
      <p class="mt-3 text-step-1 text-muted-foreground" data-note>{brasilShareNote()}</p>
      <noscript><p class="mt-1 text-step-1" data-nojs>{brasilNoJs()}</p></noscript>
      <ShareActions client:idle text={content.variants.standard.text} svg={content.svg} filename={content.filename} link={content.url} />
      <a class="mt-2 flex min-h-11 w-full items-center justify-center rounded-md border border-border bg-background text-step-2 font-bold text-foreground" href={href('/brasil/qr/')} data-qr-link>
        Mostrar QR
      </a>
      {/* The #113 shared footer with this sheet's variant (#114): the about link carries the shared tap-target token. */}
      <SiteFooter
        source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
        separator=" · "
        aboutClass={FOOTER_LINK}
        class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
      />
    </section>
  </div>
</Base>
