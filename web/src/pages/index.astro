---
import { UF_TILES } from '@/slots/home/uf-grid'
import { normalizeBase, withBase } from '@/paths'
import CitySearch from '@/components/CitySearch'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { COMPARAR, EXPLORE } from '@/lib/explore'
import { DESTINATIONS, destinationLink } from '@/lib/destinations'
import TaskRow from '@/components/TaskRow.astro'
import { loadStateCodes } from '@/lib/states'
import { loadUfMap } from '@/lib/uf-map'
import { UF_NOME, ufFullLabel } from '@/lib/uf-names'
import { LOCATE_HINT } from '@/lib/locate-messages'
import Base from '@/layouts/Base.astro'

const base = normalizeBase(import.meta.env.BASE_URL)
const available = new Set(await loadStateCodes())
const ufMap = loadUfMap()
const href = (path: string) => withBase(base, path)
// "Três ciclos por estado" needs a state: the first one the dataset has (as in the vanilla home).
const firstUf = [...available].sort()[0] ?? 'rj'
const tile = cn(buttonVariants({ variant: 'secondary' }), 'h-11 w-11 rounded-md border-border text-step-2! font-bold text-foreground pb-0.5')
---
<Base title="Voto a Voto">
  {/* Phone: one column. 768 px: the same column, centered. 1024 px and up (#51): the title, search and the task block on the
      left, the state picker on the right; the shell's top bar carries the wordmark, so the h1 stays for screen readers only. */}
  <main class="mx-auto w-full min-w-0 max-w-[720px] flex-1 px-5 pt-16 lg:grid lg:max-w-[1240px] lg:grid-cols-[560px_1fr] lg:gap-x-20 lg:gap-y-0 lg:pt-16" id="main">
    <div class="lg:col-start-1 lg:row-start-1">
    <h1 class="font-serif text-step-4 font-normal wrap-anywhere lg:sr-only">Voto a Voto</h1>
    <p class="font-serif text-step-2 lg:text-[44px] lg:leading-[60px]">Eleição presidencial 2026, cidade por cidade.</p>
    <p class="mt-0.5 text-step-1 text-muted-foreground lg:mt-2 lg:text-lead lg:leading-[20px]">Compare com 2018 e 2022.</p>
    <p class="mt-0.5 text-step-1 text-muted-foreground lg:text-lead lg:leading-[20px]" data-finality>Final, não ao vivo.</p>
    <div id="busca" class="scroll-mt-4 lg:mt-4 lg:[&_[data-slot=input-group]]:h-14!"><CitySearch client:interaction base={base} /></div>
    <p class="mt-1.5 text-step-1" data-island-failed hidden>A busca não está disponível agora. Escolha um estado abaixo.</p>
    <noscript><p class="mt-1.5 text-step-1">A busca precisa de JavaScript. Escolha um estado abaixo.</p></noscript>
    <div class="relative mb-[-2px] mt-[10px] flex h-14 items-start rounded-lg border border-border bg-secondary pl-[11px]" data-place-shortcut data-base={base} hidden>
      <span class="flex min-w-0 max-w-[200px] flex-col gap-[3px] pt-[7px]">
        <span class="text-step-1 uppercase text-muted-foreground" data-place-label>Sua cidade</span>
        <a class="text-step-2 font-bold wrap-anywhere text-primary" data-place-link href={href('/')}></a>
      </span>
      <button type="button" class="absolute bottom-[-1px] right-[11px] h-11 cursor-pointer border-0 bg-transparent p-0 pt-[10px] text-step-1 text-muted-foreground underline" data-place-forget>esquecer meus dados</button>
    </div>
    <div class="mt-[10px] [[data-place-shortcut]:not([hidden])+&]:mt-3" data-locate data-base={base} hidden>
      <button type="button" class="flex h-11 w-full cursor-pointer items-center justify-center gap-2 rounded-lg border-[1.5px] border-primary bg-background px-3 text-step-2 font-bold text-primary disabled:opacity-60" data-locate-button>
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.4"></circle><circle cx="8" cy="8" r="2.4" fill="currentColor"></circle></svg>
        Usar minha localização
      </button>
      <p class="mt-1.5 text-step-1 text-muted-foreground">{LOCATE_HINT}</p>
      <p class="mt-1.5 text-step-1" role="status" aria-live="polite" data-locate-status hidden></p>
    </div>
    </div>
    <div class="lg:col-start-2 lg:row-span-2 lg:row-start-1">
    <p class="mt-1.5 text-step-1 lg:mt-[2px] lg:text-body"><span class="lg:hidden">Ou escolha um estado. Toque para ver os municípios.</span><span class="hidden lg:inline">Ou escolha um estado. Clique para ver os municípios.</span></p>
    <nav class="mt-1 grid justify-center gap-px [grid-auto-rows:44px] [grid-template-columns:repeat(7,44px)] lg:hidden" aria-label="Estados" data-uf-grid>
      {UF_TILES.map((t) =>
        available.has(t.uf) ? (
          <a class={tile} style={`grid-column:${t.col};grid-row:${t.row}`} href={href(`/${t.uf}/`)} data-uf={t.uf} data-nome={UF_NOME[t.uf]} aria-label={ufFullLabel(t.uf)}>{t.uf.toUpperCase()}</a>
        ) : (
          <span class={cn(tile, 'select-none')} style={`grid-column:${t.col};grid-row:${t.row}`} data-uf={t.uf} aria-disabled="true">{t.uf.toUpperCase()}</span>
        ),
      )}
    </nav>
    {/* 1024 px and up: the SVG map replaces the tile grid (#53). Static inline SVG, every state a link; below 1024 px it is not drawn. */}
    {/* A lazy iframe that is not drawn is never requested: the phone's HTML carries no map (it would add ~5 KB gzip), see layouts/FragmentDoc.astro. */}
    <iframe class="mt-6 hidden w-full max-w-[560px] border-0 lg:block" style={`aspect-ratio:${ufMap.width}/${ufMap.height}`} src={href('/fragmentos/mapa-uf/')} title="Mapa do Brasil por estado: escolha um estado" loading="lazy" data-uf-map-frame></iframe>
    </div>
    <div class="lg:col-start-1 lg:row-start-2">
    <section class="mt-2 lg:mt-12" aria-labelledby="tarefas" data-tasks>
    <h2 id="tarefas" class="font-serif text-step-3! font-normal lg:text-[22px]! lg:leading-[30px]!">O que você quer fazer?</h2>
    {/* The entries in the order a visit unfolds (data-task is the stable hook); "comparar" (id="comparar") is the chooser (#101). #102 inserts
        "Usar os dados" and #103 anything else after "entender". A link to a screen that does not exist yet is not shown. */}
    <ul class="mt-[5px] list-none p-0 lg:mt-3">
      <li data-task="ver-cidade"><TaskRow href="#busca" title="Ver minha cidade" sub="Busque pelo nome ou use a localização" /></li>
      <li data-task="compartilhar"><TaskRow href={href('/') + destinationLink('compartilhar')} title="Compartilhar um resultado" sub="Escolha a cidade e toque em Compartilhar" /></li>
      <li data-task="comparar" id="comparar" class="border-t border-border pt-3 scroll-mt-4">
        <strong class="block text-step-2 font-bold lg:text-[19px] lg:leading-[22px]" id="comparar-titulo">Comparar</strong>
        <span class="block text-step-1 text-muted-foreground lg:text-[14px] lg:leading-[16px]">O que você quer comparar?</span>
        <ul class="list-none p-0" aria-labelledby="comparar-titulo">
          {/* A needs-a-city option links to the search with its destination (plain link, no script); home-place.ts points it straight at the city when one is remembered. */}
          {COMPARAR.map((o) => (
            <li>
              {'destination' in o
                ? <TaskRow href={href('/') + destinationLink(o.destination)} title={o.title} sub={o.sub} data={{ 'place-to': DESTINATIONS[o.destination].to }} />
                : <TaskRow href={href(o.to.replace(':uf', firstUf))} title={o.title} sub={o.sub} />}
            </li>
          ))}
        </ul>
      </li>
      <li data-task="conferir"><TaskRow href={href('/sobre-os-dados/#confira-voce-mesmo')} title="Conferir um número" sub="De onde vem cada número e como conferir" /></li>
      <li data-task="entender" class="border-t border-border pt-3">
        <strong class="block text-step-2 font-bold lg:text-[19px] lg:leading-[22px]" id="entender">Entender o país e os estados</strong>
        <ul class="list-none p-0" aria-labelledby="entender">
          {EXPLORE.filter((e) => e.task === 'entender').map((e) => <li><TaskRow href={href(e.to.replace(':uf', firstUf))} title={e.title} sub={e.sub} /></li>)}
        </ul>
      </li>
    </ul>
    </section>
    </div>
  </main>
  <footer class="mx-5 mt-2 border-t border-border pb-2 text-center text-step-1 text-primary md:mx-auto md:w-full md:max-w-[680px] lg:mt-16 lg:max-w-[1200px] lg:border-t-0 lg:text-left" data-component="source-footer">
    Dados oficiais do TSE · <a class="inline-flex min-h-11 items-center" href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
  <script>
    import '@/scripts/tile-analytics'
    import '@/scripts/home-place'
    import '@/scripts/home-locate'
  </script>
</Base>
