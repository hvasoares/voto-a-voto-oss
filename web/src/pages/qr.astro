---
/**
 * Mostrar QR demo (ticket #9) on the placeholder route /qr/: the same QrScreen as the city and Brasil routes, scope `demo` (the fixture
 * city, whichever DATA_DIR the build uses). It stays so the shared screen is demoable without an address context; noindex and linked
 * from nowhere but the demo share sheet (#137).
 */
import QrScreen from '@/components/QrScreen.astro'
import { qrScreenConfig } from '@/lib/screen-scopes'
const config = await qrScreenConfig({ scope: 'demo' })
---
<QrScreen config={config} />
