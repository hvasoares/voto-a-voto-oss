---
import Base from '@/layouts/Base.astro'
import { siteHref } from '@/paths'
---
<Base title="Página não encontrada · Voto a Voto">
  <main class="min-w-0 flex-1 px-5 pt-16" id="main" data-fallback="pending">
    <h1 class="font-serif text-step-4 font-normal" data-fallback-title>Página não encontrada</h1>
    <p class="mt-2 text-step-2 text-muted-foreground" data-fallback-text>Confira o endereço ou volte ao início para buscar sua cidade.</p>
    {/* The #113 base-path helper. */}
    <p class="mt-4"><a href={siteHref('/')} class="font-bold">‹ Início</a></p>
  </main>
  <script>
    import '@/scripts/fallback'
  </script>
</Base>
