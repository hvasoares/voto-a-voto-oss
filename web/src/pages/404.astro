---
import Base from '@/layouts/Base.astro'
import { normalizeBase, withBase } from '@/paths'

const base = normalizeBase(import.meta.env.BASE_URL)
---
<Base title="Página não encontrada · Voto a Voto">
  <main class="min-w-0 flex-1 px-5 pt-16" id="main" data-fallback="pending">
    <h1 class="font-serif text-title font-normal leading-[30px]" data-fallback-title>Página não encontrada</h1>
    <p class="mt-2 text-lead text-muted-foreground" data-fallback-text>Confira o endereço ou volte ao início para buscar sua cidade.</p>
    <p class="mt-4"><a href={withBase(base, '/')} class="font-bold">‹ Início</a></p>
  </main>
  <script>
    import '@/scripts/fallback'
  </script>
</Base>
