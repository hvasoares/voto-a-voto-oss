---
/**
 * Share sheet demo (ticket #7) on the placeholder route /compartilhar/: the one ShareScreen with the scope `demo` (the fixture city and the
 * round of the Sketch frame "3 Folha de compartilhamento"), so the sheet stays demoable without a shared address context. The real routes
 * are /:uf/:slug/compartilhar/ and /brasil/compartilhar/ (#50, #91); the demo is noindex and linked from nowhere (#137).
 */
import ShareScreen from '@/components/ShareScreen.astro'
import ShareDemoBackdrop from '@/components/ShareDemoBackdrop.astro'
import { shareScreenConfig } from '@/lib/screen-scopes'

const config = await shareScreenConfig({ scope: 'demo' })
---
<ShareScreen config={config}>
  <ShareDemoBackdrop slot="backdrop" />
</ShareScreen>
