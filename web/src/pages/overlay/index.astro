---
/**
 * The overlay builder (#68; the Sketch frame "C2 Overlay para live"): pick a place, a measure, a cycle, a size and a background, see the overlay and copy its address for the OBS
 * browser source. Quiet shell: no analytics. Nothing links here yet: the address is the way in (the creator guide links to it once it ships).
 */
import QuietDoc from '@/layouts/QuietDoc.astro'
import OverlayBuilder from '@/components/OverlayBuilder'
import { normalizeBase, withBase } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-overlay'
import { siteOrigin } from '@/lib/share-url'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const say = (key: string) => message(DEFAULT_VOICE, key as never)
---
<QuietDoc title={`${say('overlay.title')} · Voto a Voto`} description={say('overlay.sub')}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[720px] lg:max-w-[1200px] lg:pt-8" id="main" data-page="overlay">
    <a class="inline-flex min-h-11 items-center text-body font-bold text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-1 font-serif text-title font-normal leading-[30px] lg:text-[34px] lg:leading-[40px]">{say('overlay.title')}</h1>
    <p class="mt-1 text-body leading-[19px] text-muted-foreground">{say('overlay.sub')}</p>
    <OverlayBuilder client:load base={base} origin={siteOrigin()} />
    <noscript><p class="mt-2 text-small leading-[17px]" data-nojs>Montar o endereço precisa de JavaScript. O overlay fica em /overlay/tela/ com a cidade no endereço, como ?c=rj/cidade-exemplo&amp;m=nv&amp;a=2026.</p></noscript>
    <script>
      import '@/scripts/overlay-pending'
    </script>
    <footer class="mt-4 border-t border-border pt-2 text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
      Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </main>
</QuietDoc>
