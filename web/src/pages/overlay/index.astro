---
/**
 * The overlay builder (#68; the Sketch frame "C2 Overlay para live"): pick a place, a measure, a cycle, a size and a background, see the overlay and copy its address for the OBS
 * browser source. Quiet shell: no analytics. Nothing links here yet: the address is the way in (the creator guide links to it once it ships).
 */
import QuietDoc from '@/layouts/QuietDoc.astro'
import OverlayBuilder from '@/components/OverlayBuilder'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-overlay'
import { siteOrigin } from '@/lib/share-url'
import { installPendingCapture } from '@/scripts/island-pending'

const base = siteBase()
// The #113 base-path helper (`base` stays for the OverlayBuilder island, which takes the base argument).
const href = siteHref
const say = (key: string) => message(DEFAULT_VOICE, key as never)
// The builder is client:load: a tap can land while not a single module of the page has loaded yet
// (the #68 flake). The held-tap capture therefore goes into the page INLINE — the installer is
// self-contained so its source is a runnable script (island-pending.ts documents the two deliveries).
const pendingCapture = `(${installPendingCapture.toString()})()`
---
<QuietDoc title={`${say('overlay.title')} · Voto a Voto`} description={say('overlay.sub')}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[720px] lg:max-w-[1200px] lg:pt-8" id="main" data-page="overlay">
    <a class="inline-flex min-h-11 items-center text-step-2 font-bold text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-1 font-serif text-step-4 font-normal">{say('overlay.title')}</h1>
    <p class="mt-1 text-step-2 text-muted-foreground">{say('overlay.sub')}</p>
    <OverlayBuilder client:load base={base} origin={siteOrigin()} />
    <noscript><p class="mt-2 text-step-1" data-nojs>Montar o endereço precisa de JavaScript. O overlay fica em /overlay/tela/ com a cidade no endereço, como ?c=rj/cidade-exemplo&amp;m=nv&amp;a=2026.</p></noscript>
    <script is:inline set:html={pendingCapture} />
    {/* The #113 shared footer with this page's variant (#116): the " · " separator and the plain about link. */}
    <SiteFooter
      source="Fonte: TSE, dados finais"
      separator=" · "
      aboutClass=""
      class="mt-4 border-t border-border pt-2 text-step-1 text-primary"
    />
  </main>
</QuietDoc>
