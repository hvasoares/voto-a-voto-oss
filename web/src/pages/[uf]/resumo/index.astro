---
/**
 * State recap (the Sketch frame "17 Resumo do estado", ticket #28): one state across 2018, 2022 and 2026, the two runoff
 * candidates' shares, the change in points and ONE generated headline, as a picture that the existing share flow sends with the
 * link. Pre-rendered per state from the three-cycle aggregates (overseas posts excluded); the picture and the words come
 * from the catalog, so the text alternative, the share text and the headline are one sentence. Reached from the state page.
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import RecapShare from '@/components/RecapShare'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { loadRecap, recapUfs } from '@/lib/recap-data'
import { recapContent } from '@/lib/recap-content'
import { recapSubtitle, recapTitle } from '@/lib/sentences/recap'
import { message, DEFAULT_VOICE } from '@/lib/sentences/catalog'
import { UF_NOME } from '@/lib/uf-names'
import Seal from '@/components/Seal.astro'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'
import { NAV_CHIP_QUIET_PRIMARY } from '@/shared/link-classes'
import PageMain from '@/components/PageMain.astro'

export async function getStaticPaths() {
  return (await recapUfs()).map((uf) => ({ params: { uf } }))
}

const { uf } = Astro.params
const base = siteBase()
// The #113 base-path helper (`base` stays for recapContent and the fact links, which take the base argument).
const href = siteHref
const fixture = await datasetFixture()
const edition = await currentEdition()
const recap = (await loadRecap(uf!))!
const stateName = UF_NOME[uf!] ?? uf!.toUpperCase()
const content = recapContent(recap, { stateName, origin: siteOrigin(), base, fixture, edition: edition.id })
const hasData = recap.rows.some((r) => r.status === 'data')
// Fact records (#62): the shares and the changes of the picture are the records of the state's three cycles (/fato/estado/<uf>/tres-ciclos/), one link per cycle with data, and the seal.
const facts = await getFactPage(`estado/${uf}`, 'tres-ciclos')
const links = factLinks(facts.facts, `/${uf}/resumo/`, base)
const seal = await sealOf(facts)
const calcCycles = recap.rows.filter((r) => r.status === 'data').map((r) => ({ ano: r.ano, link: calcLink(links(`${r.ano}-variacao`)) }))
---
<Base title={`${recapTitle()} · ${stateName} · Voto a Voto`} description={content.variants.standard.alt}>
  <PhoneHeader />
  <PageMain md="480" data-page="resumo" data-uf={uf}>
    <a class={NAV_CHIP_QUIET_PRIMARY} href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">{recapTitle()}</h1>
    <p class="mt-1 text-step-1 text-muted-foreground" data-subtitle>{recapSubtitle(recap, { stateName })}</p>
    {hasData ? (
      <>
        <div class="mt-3 [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" data-recap-picture set:html={content.svg} />
        <noscript><p class="mt-1 text-step-1" data-nojs>Compartilhar e baixar a imagem precisam de JavaScript; a frase acima da imagem pode ser copiada.</p></noscript>
        <RecapShare client:idle uf={uf!} text={content.variants.standard.text} svg={content.svg} filename={content.filename} link={content.url} label={message(DEFAULT_VOICE, 'recap.share')} />
      </>
    ) : (
      <p class="mt-4 text-step-2" data-nodata>{content.variants.standard.alt}</p>
    )}
    {hasData && (
      <ul class="mt-2 flex list-none flex-wrap gap-x-4 gap-y-1 p-0 text-step-1" data-recap-calc>
        {calcCycles.map((c) => <li><span class="text-muted-foreground">{c.ano} </span><Fragment set:html={c.link} /></li>)}
      </ul>
    )}
    <Seal lines={seal} />
    <a class="mt-1 flex min-h-11 w-full items-center justify-center text-step-2 font-bold text-primary" href={href(`/tres-ciclos/${uf}/`)} data-link="cycles">Ver os três ciclos do estado ›</a>
    {/* The #113 shared footer with this page's variant (#114): the plain about link after the " · " separator. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </PageMain>
</Base>
