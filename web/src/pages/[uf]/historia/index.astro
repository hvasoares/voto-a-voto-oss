---
/**
 * The state story (the Sketch frame "13d Sequência de Stories do estado", ticket #47): six to eight vertical cards for a state, one idea and one number each, the most surprising fact on the
 * second card and the share card last, as a row you swipe (the `StorySequence` island) that is a stacked list without scripts. Each card is a standalone picture with the address of its position
 * (`/<uf>/historia/#2`). Built for the states whose sequence has six to eight cards (`story-data.ts`). No entry point links here yet: the page is reached by its address.
 */
import Base from '@/layouts/Base.astro'
import StorySequence from '@/components/StorySequence'
import Seal from '@/components/Seal.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase } from '@/paths'
import { loadStory, storyUfs } from '@/lib/story-data'
import { storyCalc } from '@/lib/story-content'
import { storySay } from '@/lib/story'
import { datasetFixture } from '@/lib/shard-files'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'
import '@/styles/story.css'
import PageMain from '@/components/PageMain.astro'

export async function getStaticPaths() {
  const base = siteBase()
  return (await storyUfs(base)).map((uf) => ({ params: { uf } }))
}

const { uf } = Astro.params
const base = siteBase()
const fixture = await datasetFixture()
const story = (await loadStory(uf!, base))!
// Fact records (#62): the number of a card has its record (the calculation link); a card whose number has none does not build.
const pages = { municipios: await getFactPage(`estado/${uf}`, 'municipios'), 'tres-ciclos': await getFactPage(`estado/${uf}`, 'tres-ciclos') }
const linksOf = (page: 'municipios' | 'tres-ciclos') => factLinks(pages[page].facts, `/${uf}/historia/`, base)
const cards = story.cards.map((c) => {
  const where = c.kind === 'recap' || c.kind === 'share' ? undefined : storyCalc(c.kind)
  return { n: c.n, svg: c.svg, text: c.variants.standard.text, link: c.url, filename: c.filename, caption: c.caption, address: c.address, calc: where ? calcLink(linksOf(where.page as 'municipios' | 'tres-ciclos')(where.anchor)) : undefined }
})
const seal = await sealOf(pages['tres-ciclos'])
const words = { region: storySay('story.region', {}, { name: story.stateName }), dots: storySay('story.dots'), dot: storySay('story.dot', {}, {}), share: storySay('story.share'), linkNote: storySay('story.link.note'), nojs: storySay('story.nojs') }
---
<Base title={`${storySay('story.title', {}, { name: story.stateName })} · Voto a Voto`} description={story.cards[1]!.variants.standard.alt}>
  <PageMain md="480" data-page="historia" data-uf={uf}>
    <h1 class="mt-2 font-serif text-step-4 font-normal">{story.stateName}</h1>
    <p class="mt-1 text-step-1 text-muted-foreground" data-subtitle>{storySay('story.sub', {}, { n: cards.length })}</p>
    <StorySequence client:load cards={cards} words={words} />
    <p class="mt-2 text-center text-step-1 text-muted-foreground">{storySay('story.note')}</p>
    <Seal lines={seal} />
    {/* The #113 shared footer with this page's variant (#114): the plain about link after the " · " separator. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </PageMain>
</Base>
