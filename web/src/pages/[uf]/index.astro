---
/**
 * State page (the approved Sketch frame "5 Estado", ported from site/src/slots/state/slot.ts by #50).
 * Pre-rendered one page per state, straight from the shards — same markup contract as the vanilla app
 * (`[data-state-list] a.state-row`, `[data-state-results]`, the map area for #16/#17); the search script
 * reads the rows already in the page and makes no request.
 */
import { countLabel, rowMarkup, stateRows } from '@/slots/state/state-list'
import { normalizeBase, withBase } from '@/paths'
import Base from '@/layouts/Base.astro'
import { datasetFixture, loadSearchShard, loadStateShard, loadStateUfs } from '@/lib/shard-files'

export async function getStaticPaths() {
  const ufs = await loadStateUfs()
  return ufs.map((uf) => ({ params: { uf }, props: {} }))
}

const { uf } = Astro.params
const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const state = (await loadStateShard(uf!))!
const label = uf!.toUpperCase()
const fixture = await datasetFixture()
const pageTitle = `Estado selecionado: ${label}`
const banner = fixture ? 'EXEMPLO · DADOS FICTÍCIOS, NÃO SÃO RESULTADOS REAIS' : undefined
const sub = `${fixture ? 'Município fictício' : 'Município'} · ${label}`
const rows = stateRows(state.cities)
---
<Base title={`${pageTitle} · Voto a Voto`}>
  <div class="screen state-page">
    <header class="app-header">
      <a class="brand" href={href('/')}>Voto a Voto</a>
      <span class="app-header__sep" aria-hidden="true"></span>
      <span class="app-header__context">Presidente 2026</span>
    </header>
    {banner && <div class="banner" role="note">{banner}</div>}
    <main class="page__main" id="main">
      <a class="back" href={href('/')}>‹ Início</a>
      <h1 class="page__title">{pageTitle}</h1>
      <p class="page__subtitle">{countLabel(rows.length)}</p>
      <div class="state-map" data-placeholder="state-map" data-ticket="16 17" data-uf={uf} data-map-area><span>Espaço do mapa de municípios</span></div>
      <div class="state-search" data-state-search data-uf={uf}>
        <input class="state-search__input" type="search" name="q" placeholder={`Busque sua cidade em ${label}`} aria-label={`Busque sua cidade em ${label}`} autocomplete="off" autocapitalize="off" spellcheck="false" enterkeyhint="search" />
      </div>
      <noscript><p class="state-note">A busca precisa de JavaScript. Use a lista abaixo.</p></noscript>
      <div class="state-results" data-state-results aria-live="polite" hidden></div>
      <ul class="state-list" data-state-list aria-label="Municípios">
        {rows.map((r) => <Fragment set:html={rowMarkup(href(`/${uf}/${r.slug}/`), r.nome, sub)} />)}
      </ul>
      <nav class="state-links" aria-label="Mais sobre o estado">
        <a data-link="map" href={href('/mapa/')}>Ver mapa por estado ›</a>
        <a data-link="cycles" href={href(`/tres-ciclos/${uf}/`)}>Ver os três ciclos do estado ›</a>
      </nav>
    </main>
    <footer class="source-footer" data-component="source-footer">{fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'} · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a></footer>
  </div>
  <script>
    import '@/scripts/state-search'
  </script>
</Base>