---
/**
 * City card route (the approved Sketch frame "2 Cartão da cidade"; this route was the shard-contract page of #49,
 * the card replaced it in #50). The body is the shared CityCard component; the script switches panels client-side.
 * Pre-rendered with all six cycle/round panels in the HTML (no scripts needed to have every cycle) straight from the
 * city's own shard; the page as a whole loads nothing — no /data/ request at all.
 */
import Base from '@/layouts/Base.astro'
import CityCard from '@/components/CityCard.astro'
import { loadCityRoutes } from '@/lib/city-routes'
import { displayName, ufLabel } from '@/shared/city-search'

export async function getStaticPaths() {
  return (await loadCityRoutes()).map((city) => ({ params: { uf: city.uf, slug: city.slug }, props: { nome: city.nome } }))
}

const { uf, slug } = Astro.params
const { nome } = Astro.props as { nome: string }
const name = displayName(nome)
---
<Base title={`${name} · ${ufLabel(uf!)} · Voto a Voto`}>
  <CityCard uf={uf!} slug={slug!}>
    <script>
      import '@/scripts/city-card'
    </script>
  </CityCard>
</Base>