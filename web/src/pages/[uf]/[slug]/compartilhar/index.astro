---
/**
 * Real share route (the approved Sketch frame "3 Folha de compartilhamento", ticket #7's route wired by #50): the one ShareScreen with the
 * city scope (#137). The sheet floats over the real city card as backdrop (aria-hidden and inert). Pre-rendered for the city card's default
 * view; when the address asks another card view (?ciclo/?turno), the ShareSheet island fetches ONLY this city's own shard and re-derives the
 * picture, the text and the file name (nothing else is ever fetched). The demo is /compartilhar/.
 */
import ShareScreen from '@/components/ShareScreen.astro'
import CityCard from '@/components/CityCard.astro'
import { shareScreenConfig } from '@/lib/screen-scopes'
import { loadCityRoutes } from '@/lib/city-routes'

export async function getStaticPaths() {
  return (await loadCityRoutes()).map((city) => ({ params: { uf: city.uf, slug: city.slug }, props: { nome: city.nome } }))
}

const { uf, slug } = Astro.params
const { nome } = Astro.props as { nome: string }

const config = await shareScreenConfig({ scope: 'city', uf: uf!, slug: slug!, nome })
---
<ShareScreen config={config}>
  <CityCard slot="backdrop" uf={uf!} slug={slug!} backdrop />
</ShareScreen>
