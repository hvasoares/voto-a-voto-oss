---
/**
 * Curiosities of a city (the Sketch frame "21 Curiosidades da cidade", ticket #33): up to three facts that rank the city
 * among the cities of its size band, each with the group size and the cycles compared, worded as a comparison and never as a
 * finding. This is the phone's own screen; from 1024 px the same card sits inside the city card and this page is not linked.
 * Pre-rendered only for the cities that have facts (a city with too few peers has no card and no page); no scripts.
 */
import Base from '@/layouts/Base.astro'
import { normalizeBase, withBase } from '@/paths'
import { message } from '@/lib/sentences/catalog'
import { registerBootScript } from '@/lib/sentences/register-store'
import { factsOf } from '@/lib/curiosities'
import { loadCityRoutes } from '@/lib/city-routes'
import { datasetFixture, loadCuriositiesFile } from '@/lib/shard-files'
import { displayName } from '@/shared/city-search'
import { curiosityCard } from '@/slots/city/curiosities'

export async function getStaticPaths() {
  const file = await loadCuriositiesFile()
  return (await loadCityRoutes()).filter((c) => file?.facts[`${c.uf}/${c.slug}`]).map((c) => ({ params: { uf: c.uf, slug: c.slug }, props: { nome: c.nome } }))
}

const { uf, slug } = Astro.params
const { nome } = Astro.props as { nome: string }
const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const name = displayName(nome)
const facts = factsOf((await loadCuriositiesFile())!, uf!, slug!)
const fixture = await datasetFixture()
const banner = fixture ? 'EXEMPLO · DADOS FICTÍCIOS, NÃO SÃO RESULTADOS REAIS'.replace(' · ', '  ·  ') : undefined
const voice = { locale: 'pt-BR', register: 'standard' } as const
---
<Base title={`Curiosidades · ${name} · Voto a Voto`}>
  <div class="screen curio-page">
    <script is:inline set:html={registerBootScript} />
    <header class="app-header">
      <a class="brand" href={href('/')}>Voto a Voto</a>
      <span class="app-header__sep" aria-hidden="true"></span>
      <span class="app-header__context">Presidente 2026</span>
    </header>
    {banner && <div class="banner" role="note">{banner}</div>}
    <main class="page__main" id="main">
      <a class="back" href={href('/')}>‹ Início</a>
      <h1 class="page__title">{name}</h1>
      <Fragment set:html={curiosityCard(facts, 'page')} />
      <p class="curio__footer"><span data-register="standard">{message(voice, 'curio.footer')}</span><span data-register="plain">{message({ ...voice, register: 'plain' }, 'curio.footer')}</span></p>
      <a class="curio__back" href={href(`/${uf}/${slug}/`)}>‹ {message(voice, 'curio.back')}</a>
    </main>
    <footer class="source-footer" data-component="source-footer">
      Fonte: TSE, dados finais<a class="source-footer__about" href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </div>
</Base>
