---
/**
 * Real Mostrar QR route (ticket #9): the one QrScreen template (`components/QrScreen.astro`) with the city scope (#137); the QR is a
 * build-time glyph of this city's canonical link.
 */
import QrScreen from '@/components/QrScreen.astro'
import { qrScreenConfig } from '@/lib/screen-scopes'
import { loadCityRoutes } from '@/lib/city-routes'

export async function getStaticPaths() {
  return (await loadCityRoutes()).map((city) => ({ params: { uf: city.uf, slug: city.slug }, props: { nome: city.nome } }))
}

const { uf, slug } = Astro.params
const { nome } = Astro.props as { nome: string }
const config = await qrScreenConfig({ scope: 'city', uf: uf!, slug: slug!, nome })
---
<QrScreen config={config} />
