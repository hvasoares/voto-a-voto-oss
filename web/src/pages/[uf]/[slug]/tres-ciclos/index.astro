---
/**
 * Three cycles of a city (the approved Sketch frame "9 Três ciclos (cidade)", ported from site/src/slots/city-cycles/slot.ts by #50), a STUB since private#216 (the
 * `tres-ciclos` family of the lighter-site milestone), the pattern of the QR page (private#208) and the calculation page (private#214):
 *   1. the page is `PageStub` (noindex, the stub's link back to the city card); its address, title, the fixture banner and the desktop download link are as before;
 *   2. it writes NO data file: the numbers of both rounds of the three cycles are in the city's shard (`city/<uf>/<slug>.json`, linked by the city card), which
 *      `scripts/city-cycles.ts` reads through the one loader;
 *   3. `lib/cycles-page-draw.ts` draws the panels with `buildCycleBlock` and `roundPanel`, the pure pair the build used, and `lib/cycles-mount.ts` switches the rounds;
 *   4. `data-page-path` on the `<main>` is the city's address in the shard.
 * A visitor without scripts reads the stub's sentence and has the link back to the city card (the stacked no-script page is gone, by the owner's decision, D-043).
 */
import PageStub from '@/components/PageStub.astro'
import FixtureBanner from '@/components/FixtureBanner.astro'
import PageDataDownload from '@/components/PageDataDownload.astro'
import { siteHref } from '@/paths'
import { cityDataPath } from '@/lib/api'
import { SHARD_VERSION } from 'virtual:data-shards'
import '@/lib/sentences/catalog-shell'
import { message } from '@/lib/sentences/catalog'
import { loadCityRoutes } from '@/lib/city-routes'
import { datasetFixture } from '@/lib/shard-files'
import { displayName } from '@/shared/city-search'

export async function getStaticPaths() {
  return (await loadCityRoutes()).map((city) => ({ params: { uf: city.uf, slug: city.slug }, props: { nome: city.nome } }))
}

const { uf, slug } = Astro.params
const { nome } = Astro.props
const voice = { locale: 'pt-BR', register: 'standard' } as const
const fixture = await datasetFixture()
---
<PageStub title={['Três ciclos', displayName(nome), 'Voto a Voto'].join(' · ')}
  what={message(voice, 'stub.what.cycles')}
  path={`${uf}/${slug}/tres-ciclos/`}
  backHref={`/${uf}/${slug}/`}
  backLabel="Cartão da cidade"
  md="720"
  extra="cycles-page"
  data-page="tres-ciclos"
  data-page-path={`${uf}/${slug}`}>
  <FixtureBanner show={fixture} class="banner" role="note" wideSeparator />
  {/* The desktop link to the shard the page is drawn from (#64): an address, not data; the draw moves it above the page footer, where it always stood. */}
  <PageDataDownload href={siteHref(cityDataPath(SHARD_VERSION, uf!, slug!))} filename={`${uf}-${slug}.json`} />
</PageStub>
<script>
  import '@/scripts/city-cycles'
</script>
