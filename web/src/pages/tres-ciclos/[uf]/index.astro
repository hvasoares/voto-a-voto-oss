---
import Base from '@/layouts/Base.astro'
import { CYCLES, type CycleBlock } from '@/lib/compare'
import { cycleBlocksFor, labelsOf, otherLargestStates, stateOrder, stateStats, type StateStats } from '@/lib/compare-data'
import { siteBase, siteHref } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import Seal from '@/components/Seal.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import FactHighlight from '@/components/FactHighlight'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'
import { loadArcsFile, loadStateShard } from '@/lib/shard-files'
import { episodeLabel, pivotText, seasonPivot, seasonSay } from '@/lib/season'
import { NAV_CHIP_QUIET_PRIMARY } from '@/shared/link-classes'
import '@/styles/season.css'
import PageMain from '@/components/PageMain.astro'
import { footerClass } from '@/shared/page-shell'

const { uf } = Astro.params

export async function getStaticPaths() {
  // One page per state, in the deterministic screen-13 order: 2026 R2 valid votes first, ties by UF.
  return stateOrder(await stateStats()).map(({ uf }) => ({ params: { uf } }))
}

const base = siteBase()
// The #113 base-path helper (`base` stays for the fact links, which take the base argument).
const href = siteHref
const all = await stateStats()
const state = all.find((x) => x.uf === uf)!
const order = stateOrder(all)
const chips = order // every state the dataset has; the row scrolls sideways on the phone
const outros = otherLargestStates(all, uf)
const blocks = cycleBlocksFor(state)
// Fact records (#62): the page's one calculation entry (#155) opens them; the seal is written from the build's checks.
const facts = await getFactPage(`estado/${uf}`, 'tres-ciclos')
const links = factLinks(facts.facts, `/tres-ciclos/${uf}/`, base)
const seal = await sealOf(facts)
// The legend follows the dataset's names through the identity table (never invented): each colour names its candidate of every cycle,
// "Haddad (2018) e Lula (2022 e 2026)" for the red, the same candidate-and-years form for the blue.
const years = (anos: number[]) => (anos.length > 1 ? `${anos.slice(0, -1).join(', ')} e ${anos.at(-1)}` : String(anos[0]))
const legendFor = (side: 'left' | 'rival') => {
  const byName = new Map<string, number[]>()
  for (const ano of CYCLES) byName.set(labelsOf(state, ano)[side], [...(byName.get(labelsOf(state, ano)[side]) ?? []), ano])
  return [...byName].map(([name, anos]) => `${name} (${years(anos)})`).join(' e ')
}
const legend = { red: legendFor('left'), blue: legendFor('rival') }
const sides = (b: CycleBlock) => [{ s: b.left!, token: 'lula' }, { s: b.rival!, token: 'bolsonaro' }] as const
// The season (#42): the pivot between episodes 2 and 3 from the city arcs of the state (#41), with its fact record.
const arcsFile = await loadArcsFile()
const cityCount = (await loadStateShard(uf))?.cities.length ?? 0
const pivot = seasonPivot(blocks, arcsFile?.byState[uf], cityCount)
const pivotLine = pivotText(pivot)
const miniRows = (st: StateStats) => Array.from({ length: CYCLES.length }, (_, i) => ({ i, b: cycleBlocksFor(st)[i]! }))
---

<Base title={`Três ciclos por estado · ${uf.toUpperCase()} · Voto a Voto`}>
  <PageMain md="760" data-page="tres-ciclos-estado">
    <a class={NAV_CHIP_QUIET_PRIMARY} href={href('/')}>‹ Início</a>
    <div class="mt-2 flex items-center justify-between gap-2">
      <h1 class="font-serif text-step-4 font-normal">Três ciclos por estado</h1>
      <Fragment set:html={calcLink(links(facts.facts[0]!.anchor))} />
    </div>
    <p class="mt-1 text-step-1 text-muted-foreground lg:text-step-2" data-component="intro">Presidente 2026 (2º turno) comparado com 2022 e 2018, no mesmo estado. Barra = % dos votos válidos do 2º turno.</p>

    <nav class="mt-3 -mx-5 flex min-h-11 items-center gap-1.5 overflow-x-auto px-5 pb-1 lg:mx-0 lg:mt-5 lg:flex-wrap lg:gap-2.5 lg:overflow-visible lg:px-0" aria-label="Estados" data-component="uf-chips">
      {chips.map((chip) =>
        chip.uf === uf ? (
          <span class="flex h-11 flex-none items-center rounded bg-primary px-2.5 text-step-2 font-bold text-primary-foreground" aria-current="page">{chip.uf.toUpperCase()}</span>
        ) : (
          <a class="flex h-11 flex-none items-center rounded border border-border bg-secondary px-2.5 text-step-2 font-bold text-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={href(`/tres-ciclos/${chip.uf}/`)}>{chip.uf.toUpperCase()}</a>
        ),
      )}
    </nav>

    <p class="season-sub" data-season-sub data-chrono={seasonSay('season.order.sub.chrono')} data-reverse={seasonSay('season.order.sub.reverse')}>{seasonSay('season.sub')}</p>
    <div class="season-order" role="group" aria-label={seasonSay('season.order.label')} data-season-order hidden>
      <button type="button" data-order="chronological" aria-pressed="true">{seasonSay('season.order.chrono')}</button>
      <button type="button" data-order="reverse" aria-pressed="false">{seasonSay('season.order.reverse')}</button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-season-status data-chrono={seasonSay('season.order.announce.chrono')} data-reverse={seasonSay('season.order.announce.reverse')}></p>

    {/* The season: three episodes in reading order, the pivot between the 2nd and the 3rd; every episode is an anchor (#2018, #2022, #2026). `scripts/season-order.ts` can reverse the whole list. */}
    <section class="season" data-component="cycles" data-season aria-label={`Três ciclos de ${uf.toUpperCase()}`}>
      {blocks.flatMap((b, i) => {
        const episode = (
          <div class="season-ep py-[2px] lg:py-3" id={String(b.ano)} data-cycle={String(b.ano)} data-episode={i + 1}>
            <p class="season-ep__head"><span>{episodeLabel(i + 1, b.ano)}</span><a href={`#${b.ano}`}>#{b.ano}</a></p>
            <h2 class="text-step-1 font-bold lg:font-serif lg:text-step-4 lg:font-normal">{uf.toUpperCase()} · {b.ano}</h2>
            {b.status === 'data' ? (
              <>
                <div class="mt-[4px] flex h-[26px] min-w-0 overflow-hidden rounded lg:h-[36px]" role="img" aria-label={`Barras: ${b.left!.label} ${b.left!.pct}%, ${b.rival!.label} ${b.rival!.pct}% dos votos válidos`}>
                  {sides(b).map(({ s, token }) => (
                    <span data-seg={`${b.ano}-${token === 'lula' ? 'a' : 'b'}`} class={`flex min-w-0 items-center justify-center px-1 text-step-1 font-bold text-white ${token === 'lula' ? 'bg-lula' : 'bg-bolsonaro'}`} style={`flex: 0 0 ${s.tenths / 10}%`}>
                      <span class="wrap-anywhere text-center">{s.label} {s.pct}%</span>
                    </span>
                  ))}
                </div>
                <p class="mt-[1px] text-step-1 text-muted-foreground lg:mt-1" data-change={b.changePp ? 'yes' : 'no'}>
                  {b.changePp ? (
                    <>{b.left!.label}: {b.changePp} pp vs {b.changeVs}</>
                  ) : (
                    <>{message(DEFAULT_VOICE, 'recap.start')}</>
                  )}
                </p>
              </>
            ) : (
              <p class="mt-1 text-step-1 text-muted-foreground">sem dados</p>
            )}
          </div>
        )
        return i === 1 ? [episode, <aside class="season-pivot" data-pivot={pivot.kind}><p>{pivotLine}</p></aside>] : [episode]
      })}
    </section>
    <p class="season-note" data-season-note data-chrono={seasonSay('season.order.note.chrono')} data-reverse={seasonSay('season.order.note.reverse')}>{seasonSay('season.order.note.chrono')}</p>

    <p class="mt-1 text-step-1 text-muted-foreground" data-component="legend">
      Vermelho = {legend.red}. Azul = {legend.blue}.
    </p>
    <p class="mt-1 text-step-1 text-muted-foreground">
      As barras mostram só os votos válidos do 2º turno: abstenção, brancos e nulos ficam de fora. Variações calculadas sem arredondar os percentuais.
    </p>

    {/* The one island of the page: from 1024 px, the sentences light the bar segment and the table cell and write the calculation beside them; a phone loads none of it. */}
    <FactHighlight client:media="(min-width: 1024px)" href={href(`/fato/estado/${uf}/tres-ciclos/`)} />

    <Seal lines={seal} />

    <nav class="mt-1 flex flex-wrap items-center justify-between gap-x-8 gap-y-1" aria-label="Mais sobre o estado" data-component="state-links">
      <a class="flex min-h-11 min-w-[9rem] flex-1 items-center text-step-2 font-bold" href={href(`/${uf}/`)}>Ver o estado ›</a>
      {state.topCity && <a class="flex min-h-11 min-w-[10rem] flex-[1.4] shrink items-center justify-end text-right text-step-2 font-bold wrap-anywhere" href={href(`/${uf}/${state.topCity.slug}/tres-ciclos/`)}>Ver os três ciclos de uma cidade ›</a>}
    </nav>

    <section class="mt-2" data-component="outros-estados" aria-labelledby="outros-estados">
      <h2 class="font-serif text-step-3 font-normal" id="outros-estados">Outros estados</h2>
      <ul class="mt-1 list-none p-0">
        {outros.map(({ uf: uf2 }) => {
          const s2 = all.find((x) => x.uf === uf2)!
          const ms = miniRows(s2)
          return (
            <li class="border-t border-border py-[4px]" data-uf={uf2}>
              <div class="grid grid-cols-[auto_1fr_90px] items-center gap-2 lg:grid-cols-[60px_repeat(3,minmax(0,1fr))] lg:grid-rows-[auto_auto] lg:gap-x-5 lg:gap-y-0.5 lg:py-2">
                <a class="text-step-2 font-bold text-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={href(`/tres-ciclos/${uf2}/`)}>{uf2.toUpperCase()}</a>
                <div class="min-w-0 lg:contents" data-mini-bars>
                  {ms.map(({ i, b }) =>
                    b!.status === 'data' ? (
                      <div class="flex h-[16px] items-center gap-[5px]" data-cycle={String(b!.ano)}>
                        <span class="w-7 flex-none text-right text-step-1 text-muted-foreground">{b!.ano}</span>
                        <span class="flex h-[10px] min-w-0 flex-1 overflow-hidden rounded-[2px]" aria-hidden="true">
                          <span class="bg-lula" style={`flex-basis: ${b!.left!.tenths / 10}%`}></span>
                          <span class="flex-1 bg-bolsonaro"></span>
                        </span>
                      </div>
                    ) : (
                      <div class="flex h-[16px] items-center gap-[5px]" data-cycle={String(b!.ano)}>
                        <span class="w-7 flex-none text-right text-step-1 text-muted-foreground">{b!.ano}</span>
                        <span class="text-step-1 text-muted-foreground">sem dados</span>
                      </div>
                    ),
                  )}
                </div>
                <div class="text-left text-step-1 text-foreground lg:contents" data-mini-pcts>
                  {ms.map(({ i, b }) => (
                    <div data-cycle={String(b!.ano)}>
                      {b!.status === 'data'
                        ? `${b!.left!.label} ${b!.left!.pct}%`
                        : 'sem dados'}
                    </div>
                  ))}
                </div>
              </div>
            </li>
          )
        })}
      </ul>
    </section>
  </PageMain>
  {/* The #113 shared footer with this page's variant (#114): the plain about link after the " · " separator. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    separator=" · "
    aboutClass=""
    class={footerClass()}
  />
  <script>
    import '@/scripts/season-order'
  </script>
</Base>