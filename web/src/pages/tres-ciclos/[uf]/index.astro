---
import Base from '@/layouts/Base.astro'
import { CYCLES, type CycleBlock } from '@/lib/compare'
import { cycleBlocksFor, labelsOf, otherLargestStates, stateOrder, stateStats, type StateStats } from '@/lib/compare-data'
import { normalizeBase, withBase } from '@/paths'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import Seal from '@/components/Seal.astro'
import FactHighlight from '@/components/FactHighlight'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'

const { uf } = Astro.params

export async function getStaticPaths() {
  // One page per state, in the deterministic screen-13 order: 2026 R2 valid votes first, ties by UF.
  return stateOrder(await stateStats()).map(({ uf }) => ({ params: { uf } }))
}

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const all = await stateStats()
const state = all.find((x) => x.uf === uf)!
const order = stateOrder(all)
const chips = order // every state the dataset has; the row scrolls sideways on the phone
const outros = otherLargestStates(all, uf)
const blocks = cycleBlocksFor(state)
// Fact records (#62): every cycle links to its records; the seal is written from the build's checks.
const facts = await getFactPage(`estado/${uf}`, 'tres-ciclos')
const links = factLinks(facts.facts, `/tres-ciclos/${uf}/`, base)
const seal = await sealOf(facts)
// The legend follows the dataset's names (never invented): 2026 left, the 2018 rival, the 2026 rival.
const legend = { left: labelsOf(state, 2026).left, old: labelsOf(state, 2018).rival, left26: labelsOf(state, 2026).rival }
const sides = (b: CycleBlock) => [{ s: b.left!, token: 'lula' }, { s: b.rival!, token: 'bolsonaro' }] as const
const miniRows = (st: StateStats) => Array.from({ length: CYCLES.length }, (_, i) => ({ i, b: cycleBlocksFor(st)[i]! }))
---

<Base title={`Três ciclos por estado · ${uf.toUpperCase()} · Voto a Voto`}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-16 md:max-w-[760px] lg:pt-8" id="main" data-page="tres-ciclos-estado">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px] lg:min-h-8 lg:border-0 lg:px-0 lg:text-[14px] lg:font-normal lg:text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px] lg:text-[46px] lg:leading-[56px]">Três ciclos por estado</h1>
    <p class="mt-1 text-tiny leading-[12px] text-muted-foreground lg:text-[15px] lg:leading-[20px]" data-component="intro">Presidente 2026 (2º turno) comparado com 2022 e 2018, no mesmo estado. Barra = % dos votos válidos do 2º turno.</p>

    <nav class="mt-3 -mx-5 flex min-h-11 items-center gap-1.5 overflow-x-auto px-5 pb-1 lg:mx-0 lg:mt-5 lg:flex-wrap lg:gap-2.5 lg:overflow-visible lg:px-0" aria-label="Estados" data-component="uf-chips">
      {chips.map((chip) =>
        chip.uf === uf ? (
          <span class="flex h-11 flex-none items-center rounded bg-primary px-2.5 text-body font-bold text-primary-foreground" aria-current="page">{chip.uf.toUpperCase()}</span>
        ) : (
          <a class="flex h-11 flex-none items-center rounded border border-border bg-secondary px-2.5 text-body font-bold text-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={href(`/tres-ciclos/${chip.uf}/`)}>{chip.uf.toUpperCase()}</a>
        ),
      )}
    </nav>

    <section class="mt-1" data-component="cycles" aria-label={`Três ciclos de ${uf.toUpperCase()}`}>
      {blocks.map((b) => (
        <div class="py-[2px] lg:py-3" data-cycle={String(b.ano)}>
          <h2 class="text-small font-bold leading-[15px] lg:font-serif lg:text-[24px] lg:font-normal lg:leading-[30px]">{uf.toUpperCase()} · {b.ano}</h2>
          {b.status === 'data' ? (
            <>
              <div class="mt-[4px] flex h-[26px] min-w-0 overflow-hidden rounded lg:h-[36px]" role="img" aria-label={`Barras: ${b.left!.label} ${b.left!.pct}%, ${b.rival!.label} ${b.rival!.pct}% dos votos válidos`}>
                {sides(b).map(({ s, token }) => (
                  <span data-seg={`${b.ano}-${token === 'lula' ? 'a' : 'b'}`} class={`flex min-w-0 items-center justify-center px-1 text-small font-bold text-white ${token === 'lula' ? 'bg-lula' : 'bg-bolsonaro'}`} style={`flex: 0 0 ${s.tenths / 10}%`}>
                    <span class="wrap-anywhere text-center">{s.label} {s.pct}%</span>
                  </span>
                ))}
              </div>
              <p class="mt-[1px] text-tiny leading-[12px] text-muted-foreground lg:mt-1 lg:text-[14px] lg:leading-[18px]" data-change={b.changePp ? 'yes' : 'no'}>
                {b.changePp ? (
                  <>{b.left!.label}: {b.changePp} pp vs {b.changeVs}</>
                ) : (
                  <>{message(DEFAULT_VOICE, 'recap.start')}</>
                )}
              </p>
              <p class="mt-[2px] text-right"><Fragment set:html={calcLink(links(`${b.ano}-a`))} /></p>
            </>
          ) : (
            <p class="mt-1 text-tiny leading-[12px] text-muted-foreground">sem dados</p>
          )}
        </div>
      ))}
    </section>

    <p class="mt-1 text-tiny leading-[12px] text-muted-foreground" data-component="legend">
      Vermelho = {legend.left}. Azul = {legend.old} (2018 e 2022) e {legend.left26} (2026).
    </p>
    <p class="mt-1 text-tiny leading-[12px] text-muted-foreground">
      As barras mostram só os votos válidos do 2º turno: abstenção, brancos e nulos ficam de fora. Variações calculadas sem arredondar os percentuais.
    </p>

    {/* The one island of the page: from 1024 px, the sentences light the bar segment and the table cell and write the calculation beside them; a phone loads none of it. */}
    <FactHighlight client:media="(min-width: 1024px)" href={href(`/fato/estado/${uf}/tres-ciclos/`)} />

    <Seal lines={seal} />

    <nav class="mt-1 flex flex-wrap items-center justify-between gap-x-8 gap-y-1" aria-label="Mais sobre o estado" data-component="state-links">
      <a class="flex min-h-11 min-w-[9rem] flex-1 items-center text-body font-bold" href={href(`/${uf}/`)}>Ver o estado ›</a>
      {state.topCity && <a class="flex min-h-11 min-w-[10rem] flex-[1.4] shrink items-center justify-end text-right text-body font-bold wrap-anywhere" href={href(`/${uf}/${state.topCity.slug}/tres-ciclos/`)}>Ver os três ciclos de uma cidade ›</a>}
    </nav>

    <section class="mt-2" data-component="outros-estados" aria-labelledby="outros-estados">
      <h2 class="font-serif text-section font-normal leading-[25px]" id="outros-estados">Outros estados</h2>
      <ul class="mt-1 list-none p-0">
        {outros.map(({ uf: uf2 }) => {
          const s2 = all.find((x) => x.uf === uf2)!
          const ms = miniRows(s2)
          return (
            <li class="border-t border-border py-[4px]" data-uf={uf2}>
              <div class="grid grid-cols-[auto_1fr_90px] items-center gap-2 lg:grid-cols-[60px_repeat(3,minmax(0,1fr))] lg:grid-rows-[auto_auto] lg:gap-x-5 lg:gap-y-0.5 lg:py-2">
                <a class="text-body font-bold leading-[17px] text-foreground focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={href(`/tres-ciclos/${uf2}/`)}>{uf2.toUpperCase()}</a>
                <div class="min-w-0 lg:contents" data-mini-bars>
                  {ms.map(({ i, b }) =>
                    b!.status === 'data' ? (
                      <div class="flex h-[16px] items-center gap-[5px]" data-cycle={String(b!.ano)}>
                        <span class="w-7 flex-none text-right text-tiny leading-[16px] text-muted-foreground">{b!.ano}</span>
                        <span class="flex h-[10px] min-w-0 flex-1 overflow-hidden rounded-[2px]" aria-hidden="true">
                          <span class="bg-lula" style={`flex-basis: ${b!.left!.tenths / 10}%`}></span>
                          <span class="flex-1 bg-bolsonaro"></span>
                        </span>
                      </div>
                    ) : (
                      <div class="flex h-[16px] items-center gap-[5px]" data-cycle={String(b!.ano)}>
                        <span class="w-7 flex-none text-right text-tiny leading-[16px] text-muted-foreground">{b!.ano}</span>
                        <span class="text-tiny leading-[16px] text-muted-foreground">sem dados</span>
                      </div>
                    ),
                  )}
                </div>
                <div class="text-left text-tiny leading-[16px] text-foreground lg:contents" data-mini-pcts>
                  {ms.map(({ i, b }) => (
                    <div data-cycle={String(b!.ano)}>
                      {b!.status === 'data'
                        ? `${b!.left!.label} ${b!.left!.pct}%`
                        : 'sem dados'}
                    </div>
                  ))}
                </div>
              </div>
            </li>
          )
        })}
      </ul>
    </section>
  </main>
  <footer class="mx-auto w-full max-w-[430px] mt-2 border-t border-border px-5 pb-6 pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</Base>