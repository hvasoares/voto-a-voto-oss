---
/**
 * Card generator (the Sketch frame "15 Gerador de cartão", ticket #25): pick a city, one measure and a size and get a
 * ready-to-post image with ONE number, one line and the short address, drawn in the browser by the same family of drawing
 * functions as the share sheet. The page is the island's frame; the picture needs JavaScript (a canvas), so the noscript note
 * says so. Reached from the share dialog's link (the city arrives in the address: ?cidade=rj/cidade-exemplo).
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import CardGenerator from '@/components/CardGenerator'
import { normalizeBase, withBase } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const fixture = await datasetFixture()
---
<Base title="Gerador de cartão · Voto a Voto" description="Escolha uma cidade e uma medida e baixe uma imagem pronta para postar, em três tamanhos.">
  <PhoneHeader />
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[480px] lg:pt-8" id="main" data-page="gerador">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px] lg:min-h-8 lg:border-0 lg:px-0 lg:text-[14px] lg:font-normal lg:text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px]">Gerador de cartão</h1>
    <p class="mt-1 text-small leading-[14px] text-muted-foreground">Escolha uma cidade e uma medida. A imagem sai pronta para postar.</p>
    <div class="mt-3">
      <CardGenerator client:load base={base} origin={siteOrigin()} fixture={fixture} />
    </div>
    <noscript><p class="mt-2 text-small leading-[17px]" data-nojs>O gerador desenha a imagem no seu navegador e precisa de JavaScript.</p></noscript>
    <p class="mt-2 text-center text-[11px] leading-[14px] text-muted-foreground" data-note>A imagem é desenhada no seu navegador. Nada é enviado. Funciona também sem compartilhamento de arquivos: baixe e anexe.</p>
    <footer class="mt-2 border-t border-border pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
      {fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'} · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </main>
</Base>
