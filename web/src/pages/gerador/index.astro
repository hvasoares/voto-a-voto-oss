---
/**
 * Card generator (the Sketch frame "15 Gerador de cartão", ticket #25): pick a city, one measure and a size and get a
 * ready-to-post image with ONE number, one line and the short address, drawn in the browser by the same family of drawing
 * functions as the share sheet. The page is the island's frame; the picture needs JavaScript (a canvas), so the noscript note
 * says so. Reached from the share dialog's link (the city arrives in the address: ?cidade=rj/cidade-exemplo).
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import CardGenerator from '@/components/CardGenerator'
import SiteFooter from '@/components/SiteFooter.astro'
import { normalizeBase, siteHref } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'

const base = normalizeBase(import.meta.env.BASE_URL)
// The #113 base-path helper (`base` stays for the CardGenerator island, which takes the base argument).
const href = siteHref
const fixture = await datasetFixture()
const edition = await currentEdition()
---
<Base title="Gerador de cartão · Voto a Voto" description="Escolha uma cidade e uma medida e baixe uma imagem pronta para postar, em três tamanhos.">
  <PhoneHeader />
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[480px] lg:pt-8" id="main" data-page="gerador">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-step-2 font-bold lg:min-h-8 lg:border-0 lg:px-0 lg:text-step-1 lg:font-normal lg:text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Gerador de cartão</h1>
    <p class="mt-1 text-step-1 text-muted-foreground">Escolha uma cidade e uma medida. A imagem sai pronta para postar.</p>
    <div class="mt-3">
      <CardGenerator client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} />
    </div>
    <p class="mt-2 text-center text-step-1" data-open-card>Já tem um cartão? <a href={href('/abrir-cartao/')}>Abrir cartão ›</a></p>
    <noscript><p class="mt-2 text-step-1" data-nojs>O gerador desenha a imagem no seu navegador e precisa de JavaScript.</p></noscript>
    <p class="mt-2 text-center text-step-1 text-muted-foreground" data-note>A imagem é desenhada no seu navegador. Nada é enviado. Funciona também sem compartilhamento de arquivos: baixe e anexe.</p>
    {/* The #113 shared footer with this page's variant (#116): the " · " separator and the plain about link. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </main>
</Base>
