---
/**
 * The page of the calculation (#61, #62; the Sketch frames "Fato (página do cálculo)" and, on desktop, "Fato com o selo conferido"), a STUB plus a data file since
 * private#214 (the `fato` family of the lighter-site milestone), the pattern of the QR page (private#208) and the share sheet (private#210):
 *   1. the page is `PageStub` with the family's words and its address: its address, title and `noindex` are the stub's; the link back is the stub's, with the
 *      catalog's label of the page the numbers are on (`#152`: `scripts/fact-page.ts` binds the way back);
 *   2. the build writes `data/v<fingerprint>/fato/<scope>/<page>.json` through the one writer (`integrations/fact-pages.ts`), from the records that passed
 *      `assertPublishable` and got their seal in `loadFactPages` (the gate stays at build time, and so does the seal: the browser draws the file's lines);
 *   3. the page script (`scripts/fact-page.ts`) hands the file to `drawFactPage` (`lib/fact-page-draw.ts`), which draws every record with the sentence module
 *      (`lib/sentences/phrase.ts`) and lights the record the fragment `#<medida>` names;
 *   4. `data-page-path` on the `<main>` is how the script knows which file this page owns.
 * A visitor without scripts reads the stub's sentence and has the link back. The records are the ones the pages were drawn from (`lib/facts/pages.ts`).
 */
import PageStub from '@/components/PageStub.astro'
import '@/styles/fact.css'
import '@/lib/sentences/catalog-shell'
import '@/lib/sentences/catalog-facts'
import { message } from '@/lib/sentences/catalog'
import { loadFactPages } from '@/lib/facts/pages'

export async function getStaticPaths() {
  return (await loadFactPages()).map((p) => ({ params: { path: `${p.scope}/${p.page}` }, props: { fp: p } }))
}

const { fp } = Astro.props
const voice = { locale: 'pt-BR', register: 'standard' } as const
const title = `${message(voice, 'fact.title')} · ${fp.title} · Voto a Voto`
---
<PageStub title={title}
  what={message(voice, 'stub.what.fact')}
  path={`fato/${fp.scope}/${fp.page}/`}
  backHref={fp.back.path}
  backLabel={fp.back.label}
  md="720"
  extra="fact-page"
  data-page="fato"
  data-page-path={`${fp.scope}/${fp.page}`}
/>
<script>
  import '@/scripts/fact-page'
</script>
