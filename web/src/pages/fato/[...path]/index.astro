---
/**
 * The page of the calculation (#61, #62; the Sketch frames "Fato (página do cálculo)" and, on desktop, "Fato com o selo conferido"): the fact records of one
 * page of the site (a city's cycle and round, its comparisons, Brasil e regiões, a comparison, a state's three cycles), each with its sentence,
 * its inputs, its formula, its source and the edition, and the "conferido" seal. Readable without scripts: the the calculation link links land on the record
 * of the figure (`#<medida>`, lit by :target). The records are the ones the pages were drawn from (`lib/facts/pages.ts`).
 */
import Base from '@/layouts/Base.astro'
import '@/styles/fact.css'
import Seal from '@/components/Seal.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteHref } from '@/paths'
import { loadFactPages, sealOf } from '@/lib/facts/pages'
import { currentEdition } from '@/lib/editions-load'
import { editionLabel, editionPath, releasePath } from '@/lib/editions'
import { registerBootScript } from '@/lib/sentences/register-store'
import { message } from '@/lib/sentences/catalog'
import AppHeader from '@/components/AppHeader.astro'
import { wayBackScript } from '@/lib/facts/link'
import FixtureBanner from '@/components/FixtureBanner.astro'

export async function getStaticPaths() {
  return (await loadFactPages()).map((p) => ({ params: { path: `${p.scope}/${p.page}` }, props: { fp: p } }))
}

const { fp } = Astro.props
const { facts } = fp
// The #113 base-path helper.
const href = siteHref
const std = (key: Parameters<typeof message>[1], params?: Record<string, string | number>) => message({ locale: 'pt-BR', register: 'standard' }, key, params)
const edition = await currentEdition()
const seal = await sealOf(fp)
const sources = [...new Map(facts.map((f) => [f.source!.url + f.source!.name, f.source!])).values()]
const methods = [...new Map(facts.flatMap((f) => (f.method ? [[f.method.href, f.method] as const] : []))).values()]
const title = `${std('fact.title')} · ${fp.title} · Voto a Voto`
---
<Base title={title}>
  <div class="screen fact-page">
    <script is:inline set:html={registerBootScript} />
    <script is:inline set:html={wayBackScript} />
    <AppHeader />
    <FixtureBanner show={fp.fixture} class="banner" role="note" wideSeparator />
    <main class="page__main" id="main">
      <a class="back" href={href(fp.back.path)} data-back>{fp.back.label}</a>
      <h1 class="page__title">{std('fact.title')}</h1>
      <p class="page__subtitle">{fp.subtitle}</p>
      <div class="facts">
        {facts.map((f) => (
          <section class="fact" id={f.anchor} data-fact={f.id}>
            <h2 class="fact__title">{f.title}</h2>
            {(['standard', 'plain'] as const).map((register) => <p class="fact__sentence" data-register={register}>{f.sentences[register]}</p>)}
            <h3 class="fact__label">{std('fact.inputs')}</h3>
            <dl class="fact__inputs">
              {f.inputs.map((i) => (
                <div>
                  <dt>{i.label}{i.field && <small>{i.field}</small>}</dt>
                  <dd>{i.value}</dd>
                </div>
              ))}
            </dl>
            <h3 class="fact__label">{std('fact.formula')}</h3>
            <p class="fact__formula">{f.calculation!.formula}</p>
            <ol class="fact__worked">{f.calculation!.worked.map((w) => <li>{w}</li>)}</ol>
            {f.shown && f.shown !== f.title && <p class="fact__shown">{std('fact.shown', { value: f.shown })}</p>}
            <p class="fact__id">{std('fact.id')}: <code>{f.id}</code></p>
          </section>
        ))}
      </div>
      <Seal lines={seal} />
      <p class="fact__rounding">{std('fact.rounding')}</p>
      <p class="fact__neutral">{std('fact.neutral')}</p>
      {fp.note && <p class="fact__neutral" data-limits>{fp.note}</p>}
      <h2 class="fact__block">{std('fact.source')}</h2>
      <ul class="fact__links">
        {sources.map((s) => <li><a href={s.url}>{s.name} ›</a></li>)}
        <li><a href={href(editionPath(edition.id))} data-edition-link>{std('fact.edition', { date: editionLabel(edition) })} ›</a></li>
        <li><a href={href(`${releasePath(edition.id)}dicionario.csv`)}>dicionario.csv ›</a></li>
        {methods.map((m) => <li><a href={m.href}>{m.name} ›</a></li>)}
      </ul>
    </main>
    {/* The #113 shared footer with this page's variant (#116): the card default (keyboard-only about link, no separator). */}
    <SiteFooter source={fp.fixture ? std('fact.source.fixture') : std('fact.source.tse')} />
  </div>
</Base>
