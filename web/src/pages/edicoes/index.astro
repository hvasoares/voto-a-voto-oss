---
/**
 * Every edition, newest first (ticket #59). Plain HTML: no island, no data fetch.
 */
import Base from '@/layouts/Base.astro'
import { editionLabel, editionPath, FEED_PATH } from '@/lib/editions'
import { currentEdition, loadEditions } from '@/lib/editions-load'
import { formatInt } from '@/shared/city-model'
import { siteHref } from '@/paths'
import SiteFooter from '@/components/SiteFooter.astro'
import { NAV_CHIP_QUIET } from '@/shared/link-classes'
import PageMain from '@/components/PageMain.astro'
import { footerClass } from '@/shared/page-shell'

// The #113 base-path helper; no local `base` remains (nothing here takes the base argument).
const href = siteHref
const editions = loadEditions()
const current = await currentEdition()
---

<Base title="Edições dos dados · Voto a Voto">
  <PageMain md="760" data-page="edicoes">
    <a class={NAV_CHIP_QUIET} href={href('sobre-os-dados/#edicoes')}>‹ Sobre os dados</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Edições dos dados</h1>
    <p class="mt-[5px]">Cada edição é uma cópia datada dos dados, em um endereço que nunca muda depois de publicado. Os números do site vêm da edição mais recente; as anteriores continuam acessíveis.</p>
    <ul class="mt-2 list-none p-0" data-component="edition-list">
      {editions.map((e) => (
        <li class="border-t border-border py-2 first:border-t-0" data-edition={e.id}>
          <a class="font-bold" href={href(editionPath(e.id))}>Edição de {editionLabel(e)}</a>
          {e.id === current.id && <span class="ml-1 text-step-1 text-muted-foreground">(a que o site mostra)</span>}
          <span class="block text-step-1 text-muted-foreground">{formatInt(e.counts.municipalities)} municípios, {formatInt(e.counts.overseas_posts)} postos no exterior</span>
        </li>
      ))}
    </ul>
    <p class="mt-2"><a href={href(FEED_PATH)} data-feed-link>Feed Atom das edições</a></p>
  </PageMain>
  {/* The #113 shared footer with this page's variant (#115): the source note with no about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    aboutLink={false}
    class={footerClass({ md: '760' })}
  />
</Base>
