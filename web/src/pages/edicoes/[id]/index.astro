---
/**
 * One edition (ticket #59), at its immutable address. Plain HTML: id, date, counts, notes, how it was published and
 * the size and SHA-256 of each file it froze.
 */
import Base from '@/layouts/Base.astro'
import { formatUtc, shortHash } from '@/lib/about'
import { citation, editionLabel, editionPath, releasePath, type Edition } from '@/lib/editions'
import { currentEdition, loadEditions } from '@/lib/editions-load'
import { siteOrigin } from '@/lib/share-url'
import { formatInt } from '@/shared/city-model'
import { siteHref } from '@/paths'
import SiteFooter from '@/components/SiteFooter.astro'
import { NAV_CHIP_QUIET } from '@/shared/link-classes'
import PageMain from '@/components/PageMain.astro'
import { footerClass } from '@/shared/page-shell'

export function getStaticPaths() {
  return loadEditions().map((edition) => ({ params: { id: edition.id }, props: { edition } }))
}
const { edition } = Astro.props as { edition: Edition }
// The #113 base-path helper; no local `base` remains (nothing here takes the base argument).
const href = siteHref
const current = await currentEdition()
const address = `${siteOrigin()}${href(editionPath(edition.id))}`
const counts = edition.counts
---

<Base title={`Edição de ${editionLabel(edition)} · Voto a Voto`}>
  <PageMain top="bar" md="760" data-page="edicao" data-edition={edition.id}>
    <a class={NAV_CHIP_QUIET} href={href('edicoes/')}>‹ Edições</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Edição de {editionLabel(edition)}</h1>
    <p class="mt-[5px]">Identificador <strong data-edition-id>{edition.id}</strong>. Esta edição não muda: os arquivos abaixo têm tamanho e SHA-256 registrados em <a href={href(editionPath(edition.id) + 'edition.json')}>edition.json</a>.{edition.id === current.id ? ' É a edição que as páginas do site mostram hoje.' : ' As páginas do site mostram hoje outra edição.'}</p>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="conteudo">
      <h2 class="font-serif text-step-3 font-normal" id="conteudo">O que tem nesta edição</h2>
      <ul class="mt-[5px] list-disc space-y-1 pl-5" data-component="edition-counts">
        <li>{formatInt(counts.municipalities)} municípios e {formatInt(counts.overseas_posts)} {counts.overseas_posts === 1 ? 'posto de votação' : 'postos de votação'} no exterior.</li>
        {Object.entries(counts.municipalities_per_cycle).map(([ano, n]) => <li>{ano}: {formatInt(n)} municípios com dados.</li>)}
        <li>{formatInt(counts.rows['votes.csv'] ?? 0)} linhas de votos por candidato e {formatInt(counts.rows['turnout.csv'] ?? 0)} de comparecimento.</li>
      </ul>
      <ul class="mt-1 list-disc space-y-1 pl-5" data-component="edition-notes">
        {edition.notes.map((note) => <li>{note}</li>)}
      </ul>
    </section>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="como-citar">
      <h2 class="font-serif text-step-3 font-normal" id="como-citar">Como citar</h2>
      <p class="mt-[5px] break-words" data-component="citation">{citation(edition, address)}</p>
      <p class="mt-1 text-step-1 text-muted-foreground">Um número citado desta edição continua o mesmo para quem abrir o endereço depois.</p>
    </section>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="dados-abertos" data-component="release">
      <h2 class="font-serif text-step-3 font-normal" id="dados-abertos">Dados abertos desta edição</h2>
      <p class="mt-[5px]">Os resultados por município em CSV e NDJSON, com dicionário de dados, LEIAME, arquivo de citação e SHA-256 de cada arquivo. Os endereços pertencem a esta edição e nunca mudam.</p>
      <p class="mt-1" data-release-identifier>Identificador: <strong>{edition.release.identifier}</strong>. Licença: <a href="https://creativecommons.org/licenses/by/4.0/deed.pt-br">{edition.release.license}</a>, com atribuição ao TSE e ao projeto. Leia o <a href={href(releasePath(edition.id) + 'LEIAME.md')}>LEIAME</a> para os cuidados (empates, exterior, ciclos sem dados).</p>
      <ul class="mt-1 list-none p-0" data-component="release-files">
        {Object.entries(edition.release.files).map(([name, f]) => (
          <li class="border-t border-border py-2 first:border-t-0 first:pt-0" data-release-file={name}>
            <a class="font-bold break-all" href={href(releasePath(edition.id) + name)}>{name}</a>
            <span class="block text-step-1">{formatInt(f.bytes)} bytes · SHA-256 <span title={f.sha256}>{shortHash(f.sha256)}</span></span>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="publicacao">
      <h2 class="font-serif text-step-3 font-normal" id="publicacao">Como foi publicada</h2>
      <p class="mt-[5px]" data-publication={edition.publication.mode}>{edition.publication.mode === 'automatic' ? 'Publicação automática, depois das verificações abaixo.' : 'Publicação manual, a partir de dados que passaram nas conferências do repositório.'}</p>
      {edition.publication.checks.length > 0 && (
        <ul class="mt-1 list-disc space-y-1 pl-5" data-component="edition-checks">
          {edition.publication.checks.map((c) => <li>{c.ok ? 'Passou' : 'Falhou'}: {c.name}. {c.detail}</li>)}
        </ul>
      )}
    </section>

    <section class="mt-2 border-t border-border pt-[7px] pb-2" aria-labelledby="arquivos">
      <h2 class="font-serif text-step-3 font-normal" id="arquivos">Arquivos congelados</h2>
      <ul class="mt-[5px] list-none p-0" data-component="edition-files">
        {Object.entries(edition.files).map(([name, f]) => (
          <li class="border-t border-border py-2 first:border-t-0 first:pt-0" data-file={name}>
            <span class="font-bold break-all">{name}</span>
            <span class="block text-step-1">{formatInt(f.bytes)} bytes · SHA-256 <span title={f.sha256}>{shortHash(f.sha256)}</span></span>
          </li>
        ))}
      </ul>
      <p class="mt-1 text-step-1 text-muted-foreground">Dados de {formatUtc(edition.date)}. Impressão digital dos dados: {edition.fingerprint}.</p>
    </section>
  </PageMain>
  {/* The #113 shared footer with this page's variant (#115): the source note with no about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    aboutLink={false}
    class={footerClass({ md: '760' })}
  />
</Base>
