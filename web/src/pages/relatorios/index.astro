---
// The reports hub (frame "6 Relatórios", ticket #12). Seven rows, each with its headline figure,
// computed at build time from the dataset (nothing here is a copied constant). Six are built reports
// and link through (cidades-que-viraram #12; the four of #13; como-cada-grupo-votou #15); the row of
// #14 stays a stub and shows "Em breve".
import Base from '@/layouts/Base.astro'
import { computeReports } from '@/lib/reports/compute'
import { hubRows } from '@/lib/reports/hub'
import { loadReportsData } from '@/lib/reports/load'
import { DEFAULT_MIN } from '@/lib/reports/outliers'
import { loadOutliers } from '@/lib/reports/outliers-load'
import { normalizeBase, withBase } from '@/paths'
import Seal from '@/components/Seal.astro'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const input = await loadReportsData()
const outliers = await loadOutliers()
const rows = hubRows(computeReports(input), input, { n: outliers.counts.find((k) => k.uf === undefined && k.min === DEFAULT_MIN)!.n, min: DEFAULT_MIN })
// Fact records (#62): the figure of each headline has its record; the link sits beside the row (a link cannot nest in the row's own link).
const facts = await getFactPage('relatorios', 'resumo')
const links = factLinks(facts.facts, '/relatorios/', base)
const seal = await sealOf(facts)
const has = (id: string) => facts.facts.some((f) => f.anchor === id)
const chevron =
  '<svg class="mx-px flex-none text-primary" viewBox="0 0 6 10" width="5" height="8.5" aria-hidden="true" focusable="false"><path d="M0.7 0.5 4 4.6 0.7 8.7" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"></path></svg>'
---

<Base title="Relatórios · Voto a Voto">
  <main class="mx-auto min-w-0 w-full max-w-[430px] md:max-w-[760px] flex-1 px-5 pb-2 pt-16 lg:pt-8" id="main" data-page="relatorios">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px] lg:min-h-8 lg:border-0 lg:px-0 lg:text-[14px] lg:font-normal" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[36px] lg:text-[44px] lg:leading-[52px]">Relatórios</h1>
    <p class="mt-0.5 text-small leading-[16px] text-muted-foreground">2º turno de 2026 e comparação com 2022</p>

    <nav aria-label="Relatórios">
      <ul class="mt-3 list-none p-0">
        {rows.map((row) => (
          <li class="border-t border-border">
            {row.to ? (
              <a
                class="flex min-h-14 items-center py-2"
                href={href(row.to)}
                data-report={row.id}
              >
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <strong class="text-body font-bold leading-[18px]">{row.title}</strong>
                  <span class="text-small leading-[15px] text-muted-foreground">{row.headline}</span>
                </span>
                <Fragment set:html={chevron} />
              </a>
            ) : (
              <div class="flex min-h-14 items-center py-2" aria-disabled="true">
                <span class="flex min-w-0 flex-1 flex-col gap-1">
                  <span class="flex flex-wrap items-center gap-2">
                    <strong class="text-body font-bold leading-[18px]">{row.title}</strong>
                    <span class="rounded-full border border-border px-1.5 text-[11px] font-medium leading-[16px] text-muted-foreground">Em breve</span>
                  </span>
                  {row.headline && <span class="text-small leading-[15px] text-muted-foreground">{row.headline}</span>}
                </span>
                <Fragment set:html={chevron} />
              </div>
            )}
            {has(row.id) && <Fragment set:html={calcLink(links(row.id))} />}
          </li>
        ))}
      </ul>
    </nav>
    <Seal lines={seal} />
  </main>
  <footer class="mx-auto mt-2 w-full max-w-[430px] md:max-w-[760px] border-t border-border px-5 pb-6 pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</Base>