---
// "Votos ganhos e perdidos vs. 2022" (ticket #13): one section per candidate — the computed net
// total of the hub as its heading and, below it, the ranked per-city gains and losses (biggest
// delta first), under the 5 mil+ valid-vote filter like the other reports. Votes are already
// volumes, so the volume is paired by showing the candidate's absolute 2026 votes next to the delta.
// Cities without the 2022 runoff round (and the overseas posts) take no part; a tie in the number
// of votes between cycles counts in neither list and is labelled.
// Shell, tables, notice and share: ReportLayout (#118).
import ReportLayout from '@/layouts/ReportLayout.astro'
import ReportTable from '@/components/ReportTable.astro'
import { MIN_FLIP_VALIDOS, rankedVoteDeltas } from '@/lib/reports/compute'
import { formatInt, formatSignedInt, loadReports, reportFacts } from '@/lib/reports/page'
import { DELTAS_SHOWN } from '@/lib/facts/pages'

/** Rows shown per ranked list; everything else stays in the computed counts of the caption. */
const SHOWN = DELTAS_SHOWN

const { voteDeltas, netVotes, lula, flavio } = await loadReports()
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const { calc, seal } = await reportFacts('relatorios/votos-ganhos-e-perdidos', 'cidades')
const minMilhares = `${formatInt(MIN_FLIP_VALIDOS / 1000)} mil`

/** One candidate's section markup: list rows are built here so both sections share the pattern. */
interface CandidateSection {
  key: 'primeiro' | 'segundo'
  candidate: string
  total: number
  gained: number
  lost: number
  unchanged: number
  compared: number
  gains: { nome: string; uf: string; slug: string; delta: number; votos2026: number }[]
  losses: { nome: string; uf: string; slug: string; delta: number; votos2026: number }[]
}
const sectionOf = (key: 'primeiro' | 'segundo', candidate: string): CandidateSection => {
  const ranked = rankedVoteDeltas(voteDeltas[key])
  return {
    key,
    candidate,
    total: netVotes[key].total,
    gained: netVotes[key].cities.gained,
    lost: netVotes[key].cities.lost,
    unchanged: ranked.unchanged,
    compared: voteDeltas[key].length,
    gains: ranked.gains.slice(0, SHOWN),
    losses: ranked.losses.slice(0, SHOWN),
  }
}
const sections = [sectionOf('primeiro', lula), sectionOf('segundo', flavio)]
const totalLine = (s: CandidateSection): string => {
  const unchanged =
    s.unchanged === 0
      ? ''
      : s.unchanged === 1
        ? ' · 1 cidade manteve o mesmo número de votos em 2022'
        : ` · ${formatInt(s.unchanged)} cidades mantiveram o mesmo número de votos em 2022`
  return `${formatSignedInt(s.total)} votos no país: ganhou em ${formatInt(s.gained)} ${s.gained === 1 ? 'cidade' : 'cidades'}, perdeu em ${formatInt(s.lost)} ${s.lost === 1 ? 'cidade' : 'cidades'} (de ${formatInt(s.compared)} comparadas)${unchanged}.`
}
const deltaLine = (delta: number): string => `${formatSignedInt(delta)} ${Math.abs(delta) === 1 ? 'voto' : 'votos'}`
const rowsOf = (list: CandidateSection['gains']) =>
  list.map((r, j) => ({ id: j, uf: r.uf, slug: r.slug, name: `${r.nome}/${r.uf.toUpperCase()}`, detail: `${deltaLine(r.delta)} · ${formatInt(r.votos2026)} em 2026`, factKey: `${r.uf}-${r.slug}` }))
---

<ReportLayout
  title="Votos ganhos e perdidos vs. 2022 · Voto a Voto"
  heading="Votos ganhos e perdidos vs. 2022"
  report="votos-ganhos-e-perdidos"
  seal={seal}
  notice="Votos absolutos favorecem as cidades grandes; veja também as maiores viradas em pp"
  share
>
  <p class="mt-2 text-step-2">
    Quanto {lula} e {flavio} ganharam ou perderam de votos entre o 2º turno de 2022 e o 2º turno de 2026. A comparação é
    pelo número de candidato: cada um dos dois disputou os dois 2º turnos no mesmo número.
  </p>
  <p class="mt-1 text-step-1 text-muted-foreground" data-sized>
    Listas com o filtro de {minMilhares}+ votos válidos de 2026; sem os postos do exterior e sem as cidades que não tiveram 2º turno em 2022.
  </p>

  {sections.map((s) => (
    <section class="mt-3 border-t border-border pt-2" data-candidate-section={s.key}>
      <h2 class="text-step-2 font-bold">{s.candidate}</h2>
      <p class="mt-[3px] text-step-1 text-muted-foreground" data-total>{totalLine(s)}</p>
      <Fragment set:html={calc(`${s.key}-total`)} />

      <h3 class="mt-2 text-step-1 font-bold" data-gains-heading>Maiores altas ({Math.min(SHOWN, s.gains.length)} de {formatInt(s.gained)})</h3>
      <ReportTable
        class="mt-1"
        tight
        rows={rowsOf(s.gains)}
        calc={calc}
        factPrefix={`${s.key}-alta-`}
        tableAttr="data-gains-table"
        rowAttr="data-gain"
        caption="As cidades onde o candidato mais ganhou votos em relação a 2022"
      />
      {s.gains.length === 0 && <p class="mt-1 text-step-1 text-muted-foreground" data-no-gains>Entre as cidades do filtro, nenhuma ganhou votos de {s.candidate}.</p>}

      <h3 class="mt-2 text-step-1 font-bold" data-losses-heading>Maiores perdas ({Math.min(SHOWN, s.losses.length)} de {formatInt(s.lost)})</h3>
      <ReportTable
        class="mt-1"
        tight
        rows={rowsOf(s.losses)}
        calc={calc}
        factPrefix={`${s.key}-perda-`}
        tableAttr="data-losses-table"
        rowAttr="data-loss"
        caption="As cidades onde o candidato mais perdeu votos em relação a 2022"
      />
      {s.losses.length === 0 && <p class="mt-1 text-step-1 text-muted-foreground" data-no-losses>Entre as cidades do filtro, nenhuma perdeu votos de {s.candidate}.</p>}
    </section>
  ))}
</ReportLayout>
