---
// "Comparecimento mais alto e mais baixo" (ticket #13): the ranked turnout of the runoff, both ways,
// among cities with 5 mil+ eleitores aptos (the same minimum the hub headlines). Every rate carries
// its volume: "4769 de 5272 eleitores aptos" under the percentage (Lean Analytics).
// Shell, tables, notice and share: ReportLayout (#118).
import ReportLayout from '@/layouts/ReportLayout.astro'
import ReportTable from '@/components/ReportTable.astro'
import { MIN_TURNOUT_APTOS, rankedTurnout, type TurnoutExtreme } from '@/lib/reports/compute'
import { formatFixedPct, formatInt, loadReports, reportFacts } from '@/lib/reports/page'
import { displayName, ufLabel } from '@/shared/city-search'
import { TURNOUT_SHOWN } from '@/lib/facts/pages'

/** Rows shown per table; the caption states how many cities the filter compared (computed). */
const SHOWN = TURNOUT_SHOWN

const { input } = await loadReports()
const { highest, lowest, compared } = rankedTurnout(input)
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const { calc, seal } = await reportFacts('relatorios/comparecimento', 'cidades')
const minMilhares = `${formatInt(MIN_TURNOUT_APTOS / 1000)} mil`
const volume = (r: TurnoutExtreme): string => `${formatFixedPct(r.rate)} · ${formatInt(r.comparecimento)} de ${formatInt(r.aptos)} eleitores aptos`
const rowsOf = (list: TurnoutExtreme[]) =>
  list.slice(0, SHOWN).map((r) => ({
    id: `${r.nome.toLowerCase()}-${r.uf}`,
    uf: r.uf,
    slug: r.slug,
    name: `${displayName(r.nome)}/${ufLabel(r.uf)}`,
    detail: volume(r),
    factKey: `${r.uf}-${r.slug}`,
  }))
---

<ReportLayout
  title="Comparecimento mais alto e mais baixo · Voto a Voto"
  heading="Comparecimento mais alto e mais baixo"
  report="comparecimento"
  seal={seal}
  notice="Cada taxa com o seu volume: uma taxa de 90% pode ser 9 de 10 eleitores aptos"
  share
>
  <p class="mt-2 text-step-2">
    O comparecimento no 2º turno de 2026, entre as cidades com {minMilhares}+ eleitores aptos: as {formatInt(Math.min(SHOWN, highest.length))} maiores
    e as {formatInt(Math.min(SHOWN, lowest.length))} menores taxas.
  </p>
  <p class="mt-1 text-step-1 text-muted-foreground" data-sized>
    Comparecimento = quem votou dividido pelo eleitorado apto, em % · {formatInt(compared)} cidades no filtro, de cada uma o volume embaixo da taxa.
  </p>
  <p class="mt-1 text-step-1" data-count-links><Fragment set:html={calc('filtro')} /></p>

  <section class="mt-2" aria-label="Comparecimento mais alto">
    <h2 class="text-step-2 font-bold">Mais alto</h2>
    <ReportTable
      class="mt-1"
      rows={rowsOf(highest)}
      calc={calc}
      factPrefix="alto-"
      tableAttr="data-turnout-high"
      rowAttr="data-turnout"
      caption="As maiores taxas de comparecimento do 2º turno de 2026"
    />
  </section>

  <section class="mt-3" aria-label="Comparecimento mais baixo">
    <h2 class="text-step-2 font-bold">Mais baixo</h2>
    <ReportTable
      class="mt-1"
      rows={rowsOf(lowest)}
      calc={calc}
      factPrefix="baixo-"
      tableAttr="data-turnout-low"
      rowAttr="data-turnout"
      caption="As menores taxas de comparecimento do 2º turno de 2026"
    />
    {compared === 0 && <p class="mt-2 text-step-1 text-muted-foreground" data-empty>Nenhuma cidade de {minMilhares}+ eleitores aptos.</p>}
  </section>
</ReportLayout>
