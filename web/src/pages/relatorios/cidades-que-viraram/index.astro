---
// "Cidades que viraram no 2º turno" (frame "7", ticket #12): the ranked list of the viradas toward
// the first candidate of the runoff, with the minimum-size filter and the volume next to every rate
// (Lean Analytics). Every figure is computed at build time from the dataset (web/src/lib/reports).
import { candidateName } from '@/shared/candidate-name'
import Base from '@/layouts/Base.astro'
import { MIN_FLIP_VALIDOS, computeReports, rankedFlipsToLula } from '@/lib/reports/compute'
import { formatInt, formatSignedPp } from '@/lib/reports/format'
import { loadReportsData } from '@/lib/reports/load'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { displayName, ufLabel } from '@/shared/city-search'
import { normalizeBase, withBase } from '@/paths'
import Seal from '@/components/Seal.astro'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const input = await loadReportsData()
const { margins, pair } = computeReports(input)
const lula = candidateName(pair.nomePrimeiro)
const flavio = candidateName(pair.nomeSegundo)
const rows = rankedFlipsToLula(margins)
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const facts = await getFactPage('relatorios/cidades-que-viraram', 'cidades')
const links = factLinks(facts.facts, '/relatorios/cidades-que-viraram/', base)
const seal = await sealOf(facts)
const minMil = `${formatInt(MIN_FLIP_VALIDOS / 1000)} mil`
const share = cn(buttonVariants({ variant: 'default' }), 'min-h-11 w-full rounded-md text-step-2 font-bold text-primary-foreground')
const badge = 'flex size-8 flex-none items-center justify-center rounded-full bg-primary pb-px text-step-1 font-bold text-primary-foreground'
---

<Base title="Cidades que viraram no 2º turno · Voto a Voto">
  <main class="mx-auto min-w-0 w-full max-w-[430px] md:max-w-[760px] flex-1 px-5 pb-2 pt-16 lg:pt-8" id="main" data-page="relatorios" data-report="cidades-que-viraram">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-step-2 font-bold lg:min-h-8 lg:border-0 lg:px-0 lg:text-step-1 lg:font-normal" href={href('/relatorios/')}>‹ Relatórios</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Cidades que viraram no 2º turno</h1>
    <p class="mt-2 text-step-2">
      Maiores viradas para {lula}, cidades com {minMil}+ votos válidos. Margem = % de {lula} menos % de {flavio},
      em pontos percentuais (pp) dos votos válidos.
    </p>

    <section class="mt-2" aria-label="Cidades que viraram">
      <table class="w-full border-collapse text-left" data-flip-table>
        <caption class="sr-only">Margem no 1º turno e margem no 2º turno de cada cidade</caption>
        <thead>
          <tr>
            <th class="hidden" scope="col">#</th>
            <th class="text-step-1 font-normal text-muted-foreground" scope="col" colspan="2">Margem no 1º turno&nbsp; → &nbsp;margem no 2º turno</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r, i) => (
            <tr class="border-t border-border" data-flip={`${r.nome.toLowerCase()}-${r.uf}`}>
              <td class="w-12 py-3.5 align-middle">
                <span class={badge}>{i + 1}</span>
              </td>
              <td class="py-3.5 align-middle">
                <a class="block min-h-11 min-w-0" href={href(`/${r.uf}/${r.slug}/`)}>
                  <span class="block text-step-2 font-bold text-foreground">{displayName(r.nome)}/{ufLabel(r.uf)}</span>
                  <span class="mt-[6px] block text-step-1 text-muted-foreground">
                    Margem {formatSignedPp(r.margin1)} → {formatSignedPp(r.margin2)} · {formatInt(r.validos2)} votos válidos
                  </span>
                </a>
                <Fragment set:html={calcLink(links(`${r.uf}-${r.slug}`))} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {rows.length === 0 && <p class="mt-2 text-step-1 text-muted-foreground">Nenhuma cidade passou do filtro de votos válidos.</p>}
    </section>

    <Seal lines={seal} />

    <p class="mt-2 rounded-lg bg-secondary px-3 py-3 text-center text-step-1 font-bold text-secondary-foreground" data-notice>
      <svg class="mr-1 inline-block -translate-y-px" viewBox="0 0 12 13" width="10" height="11" aria-hidden="true" focusable="false">
        <circle cx="6" cy="6.5" r="5.8" fill="none" stroke="currentColor" stroke-width="1.4" />
        <circle cx="6" cy="3.9" r="0.9" fill="currentColor" /><rect x="5.2" y="5.6" width="1.6" height="3.9" fill="currentColor" />
      </svg>
      Compare por pontos percentuais, não por votos absolutos
    </p>

    <div class="mt-6 flex min-h-11 flex-col gap-2" data-share>
      <button class={share} type="button" data-share-report>Compartilhar</button>
      <span class="text-center text-step-1 text-muted-foreground" role="status" aria-live="polite" data-share-feedback></span>
    </div>
  </main>
  <footer class="mx-auto mt-2 w-full max-w-[430px] md:max-w-[760px] border-t border-border px-5 pb-6 pt-2 text-center text-step-1 text-primary" data-component="source-footer">
    Fonte: TSE, dados finais · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
  <script>
    import '@/scripts/report-analytics'
  </script>
</Base>