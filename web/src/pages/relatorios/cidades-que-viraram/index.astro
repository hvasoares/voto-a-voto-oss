---
// "Cidades que viraram no 2º turno" (frame "7", ticket #12): the ranked list of the viradas toward
// the first candidate of the runoff, with the minimum-size filter and the volume next to every rate
// (Lean Analytics). Every figure is computed at build time from the dataset (web/src/lib/reports).
// Shell, table, notice and share: ReportLayout (#118).
import ReportLayout from '@/layouts/ReportLayout.astro'
import ReportTable from '@/components/ReportTable.astro'
import { MIN_FLIP_VALIDOS, rankedFlipsToLula } from '@/lib/reports/compute'
import { formatInt, formatSignedPp, loadReports, reportFacts } from '@/lib/reports/page'
import { displayName, ufLabel } from '@/shared/city-search'

const { margins, lula, flavio } = await loadReports()
const flips = rankedFlipsToLula(margins)
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const { calc, seal } = await reportFacts('relatorios/cidades-que-viraram', 'cidades')
const minMil = `${formatInt(MIN_FLIP_VALIDOS / 1000)} mil`
const rows = flips.map((r) => ({
  id: `${r.nome.toLowerCase()}-${r.uf}`,
  uf: r.uf,
  slug: r.slug,
  name: `${displayName(r.nome)}/${ufLabel(r.uf)}`,
  detail: `Margem ${formatSignedPp(r.margin1)} → ${formatSignedPp(r.margin2)} · ${formatInt(r.validos2)} votos válidos`,
  factKey: `${r.uf}-${r.slug}`,
}))
---

<ReportLayout
  title="Cidades que viraram no 2º turno · Voto a Voto"
  heading="Cidades que viraram no 2º turno"
  report="cidades-que-viraram"
  seal={seal}
  notice="Compare por pontos percentuais, não por votos absolutos"
  share
>
  <p class="mt-2 text-step-2">
    Maiores viradas para {lula}, cidades com {minMil}+ votos válidos. Margem = % de {lula} menos % de {flavio},
    em pontos percentuais (pp) dos votos válidos.
  </p>

  <section class="mt-2" aria-label="Cidades que viraram">
    <ReportTable
      rows={rows}
      calc={calc}
      tableAttr="data-flip-table"
      rowAttr="data-flip"
      caption="Margem no 1º turno e margem no 2º turno de cada cidade"
    >
      <thead slot="head">
        <tr>
          <th class="hidden" scope="col">#</th>
          <th class="text-step-1 font-normal text-muted-foreground" scope="col" colspan="2">Margem no 1º turno&nbsp; → &nbsp;margem no 2º turno</th>
        </tr>
      </thead>
    </ReportTable>
    {rows.length === 0 && <p class="mt-2 text-step-1 text-muted-foreground">Nenhuma cidade passou do filtro de votos válidos.</p>}
  </section>
</ReportLayout>
