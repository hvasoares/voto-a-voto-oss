---
// "Maiores viradas, cidades de 100 mil+ votos" (ticket #13): the same ranked-list pattern as
// /relatorios/cidades-que-viraram/ (ticket #12), under the bigger minimum-size rule. Only the swing
// of the 100 mil+ cities toward the first candidate is listed; the ones that moved away are a
// computed count the lead labels (a ranking of "biggest swing toward the other side" only lists
// the cities that moved least — runoff highlights note). Fixture state renders the empty list.
// Shell, table, notice and share: ReportLayout (#118).
import ReportLayout from '@/layouts/ReportLayout.astro'
import ReportTable from '@/components/ReportTable.astro'
import { MIN_BIG_SWING_VALIDOS, rankedBigSwings } from '@/lib/reports/compute'
import { formatInt, formatSignedPp, loadReports, reportFacts } from '@/lib/reports/page'
import { displayName, ufLabel } from '@/shared/city-search'

const { margins, lula, flavio } = await loadReports()
const { toward, awayCount } = rankedBigSwings(margins)
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const { calc, seal } = await reportFacts('relatorios/maiores-viradas', 'cidades')
const minMilhares = `${formatInt(MIN_BIG_SWING_VALIDOS / 1000)} mil`
const awayLine =
  awayCount > 0 ? `${formatInt(awayCount)} dessas cidades viraram no sentido contrário (${flavio}) e não estão na lista` : `Nenhuma dessas cidades virou no sentido contrário (${flavio})`
/** Where the 2º turno ended: still lost, won or tied (every row's margin2 carries its sign). */
const outcome = (margin2: number): string => (margin2 > 0 ? `venceu no 2º turno` : margin2 < 0 ? `perdeu no 2º turno` : `empatou no 2º turno`)
const rows = toward.map((r) => ({
  id: `${r.nome.toLowerCase()}-${r.uf}`,
  uf: r.uf,
  slug: r.slug,
  name: `${displayName(r.nome)}/${ufLabel(r.uf)}`,
  detail: `Virada ${formatSignedPp(r.swing)} · Margem ${formatSignedPp(r.margin1)} → ${formatSignedPp(r.margin2)} (${outcome(r.margin2)}) · ${formatInt(r.validos2)} votos válidos`,
  factKey: `${r.uf}-${r.slug}`,
}))
---

<ReportLayout
  title="Maiores viradas, cidades de 100 mil+ votos · Voto a Voto"
  heading="Maiores viradas, cidades de 100 mil+ votos"
  report="maiores-viradas"
  seal={seal}
  notice="Compare por pontos percentuais, não por votos absolutos"
  share
>
  <p class="mt-2 text-step-2">
    As viradas mais fortes para {lula}, entre as cidades com {minMilhares}+ votos válidos — cidades grandes, cuja
    variação pesa mais. Virada = a variação da margem entre o 1º e o 2º turno de 2026, em pontos percentuais (pp).
  </p>
  <p class="mt-1 text-step-1 text-muted-foreground" data-sized>
    {formatInt(toward.length)} cidades no filtro · {awayLine}. Margem = % de {lula} menos % de {flavio} dos votos válidos.
  </p>
  <p class="mt-1 text-step-1" data-count-links><Fragment set:html={calc('filtro')} /> <Fragment set:html={calc('contrario')} /></p>

  <section class="mt-2" aria-label="Maiores viradas">
    <ReportTable
      rows={rows}
      calc={calc}
      tableAttr="data-swing-table"
      rowAttr="data-swing"
      caption="Virada (pp), margem no 1º e no 2º turno e votos válidos de cada cidade"
    />
    {toward.length === 0 && <p class="mt-2 text-step-1 text-muted-foreground" data-empty>Nenhuma cidade de {minMilhares}+ votos válidos.</p>}
  </section>
</ReportLayout>
