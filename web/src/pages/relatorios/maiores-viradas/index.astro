---
// "Maiores viradas, cidades de 100 mil+ votos" (ticket #13): the same ranked-list pattern as
// /relatorios/cidades-que-viraram/ (ticket #12), under the bigger minimum-size rule. Only the swing
// of the 100 mil+ cities toward the first candidate is listed; the ones that moved away are a
// computed count the lead labels (a ranking of "biggest swing toward the other side" only lists
// the cities that moved least — runoff highlights note). Fixture state renders the empty list.
import { candidateName } from '@/shared/candidate-name'
import Base from '@/layouts/Base.astro'
import { MIN_BIG_SWING_VALIDOS, computeReports, rankedBigSwings } from '@/lib/reports/compute'
import { formatInt, formatSignedPp } from '@/lib/reports/format'
import { loadReportsData } from '@/lib/reports/load'
import { buttonVariants } from '@/components/ui/button'
import { cn } from '@/lib/utils'
import { displayName, ufLabel } from '@/shared/city-search'
import { normalizeBase, siteHref } from '@/paths'
import Seal from '@/components/Seal.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { calcLink } from '@/lib/facts/link'
import { factLinks } from '@/lib/facts/gate'
import { getFactPage, sealOf } from '@/lib/facts/pages'

const base = normalizeBase(import.meta.env.BASE_URL)
// The #113 base-path helper (`base` stays for `factLinks`, which takes the base argument).
const href = siteHref
const input = await loadReportsData()
const { margins, pair } = computeReports(input)
const lula = candidateName(pair.nomePrimeiro)
const flavio = candidateName(pair.nomeSegundo)
const { toward, awayCount } = rankedBigSwings(margins)
// Fact records (#62): every listed figure links to its record; the seal is written from the build's checks.
const facts = await getFactPage('relatorios/maiores-viradas', 'cidades')
const links = factLinks(facts.facts, '/relatorios/maiores-viradas/', base)
const seal = await sealOf(facts)
const minMilhares = `${formatInt(MIN_BIG_SWING_VALIDOS / 1000)} mil`
const share = cn(buttonVariants({ variant: 'default' }), 'min-h-11 w-full rounded-md text-step-2 font-bold text-primary-foreground')
const badge = 'flex size-8 flex-none items-center justify-center rounded-full bg-primary pb-px text-step-1 font-bold text-primary-foreground'
const awayLine =
  awayCount > 0 ? `${formatInt(awayCount)} dessas cidades viraram no sentido contrário (${flavio}) e não estão na lista` : `Nenhuma dessas cidades virou no sentido contrário (${flavio})`
/** Where the 2º turno ended: still lost, won or tied (every row's margin2 carries its sign). */
const outcome = (margin2: number): string => (margin2 > 0 ? `venceu no 2º turno` : margin2 < 0 ? `perdeu no 2º turno` : `empatou no 2º turno`)
---

<Base title="Maiores viradas, cidades de 100 mil+ votos · Voto a Voto">
  <main class="mx-auto min-w-0 w-full max-w-[430px] md:max-w-[760px] flex-1 px-5 pb-2 pt-16 lg:pt-8" id="main" data-page="relatorios" data-report="maiores-viradas">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-step-2 font-bold lg:min-h-8 lg:border-0 lg:px-0 lg:text-step-1 lg:font-normal" href={href('/relatorios/')}>‹ Relatórios</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Maiores viradas, cidades de 100 mil+ votos</h1>
    <p class="mt-2 text-step-2">
      As viradas mais fortes para {lula}, entre as cidades com {minMilhares}+ votos válidos — cidades grandes, cuja
      variação pesa mais. Virada = a variação da margem entre o 1º e o 2º turno de 2026, em pontos percentuais (pp).
    </p>
    <p class="mt-1 text-step-1 text-muted-foreground" data-sized>
      {formatInt(toward.length)} cidades no filtro · {awayLine}. Margem = % de {lula} menos % de {flavio} dos votos válidos.
    </p>
    <p class="mt-1 text-step-1" data-count-links><Fragment set:html={calcLink(links('filtro'))} /> <Fragment set:html={calcLink(links('contrario'))} /></p>

    <section class="mt-2" aria-label="Maiores viradas">
      <table class="w-full border-collapse text-left" data-swing-table>
        <caption class="sr-only">Virada (pp), margem no 1º e no 2º turno e votos válidos de cada cidade</caption>
        <tbody>
          {toward.map((r, i) => (
            <tr class="border-t border-border" data-swing={`${r.nome.toLowerCase()}-${r.uf}`}>
              <td class="w-12 py-3.5 align-middle">
                <span class={badge}>{i + 1}</span>
              </td>
              <td class="py-3.5 align-middle">
                <a class="block min-h-11 min-w-0" href={href(`/${r.uf}/${r.slug}/`)}>
                  <span class="block text-step-2 font-bold text-foreground">{displayName(r.nome)}/{ufLabel(r.uf)}</span>
                  <span class="mt-[6px] block text-step-1 text-muted-foreground">
                    Virada {formatSignedPp(r.swing)} · Margem {formatSignedPp(r.margin1)} → {formatSignedPp(r.margin2)} ({outcome(r.margin2)}) · {formatInt(r.validos2)} votos válidos
                  </span>
                </a>
                <Fragment set:html={calcLink(links(`${r.uf}-${r.slug}`))} />
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      {toward.length === 0 && <p class="mt-2 text-step-1 text-muted-foreground" data-empty>Nenhuma cidade de {minMilhares}+ votos válidos.</p>}
    </section>

    <Seal lines={seal} />

    <p class="mt-2 rounded-lg bg-secondary px-3 py-3 text-center text-step-1 font-bold text-secondary-foreground" data-notice>
      <svg class="mr-1 inline-block -translate-y-px" viewBox="0 0 12 13" width="10" height="11" aria-hidden="true" focusable="false">
        <circle cx="6" cy="6.5" r="5.8" fill="none" stroke="currentColor" stroke-width="1.4" />
        <circle cx="6" cy="3.9" r="0.9" fill="currentColor" /><rect x="5.2" y="5.6" width="1.6" height="3.9" fill="currentColor" />
      </svg>
      Compare por pontos percentuais, não por votos absolutos
    </p>

    <div class="mt-6 flex min-h-11 flex-col gap-2" data-share>
      <button class={share} type="button" data-share-report>Compartilhar</button>
      <span class="text-center text-step-1 text-muted-foreground" role="status" aria-live="polite" data-share-feedback></span>
    </div>
  </main>
  {/* The #113 shared footer with this page's variant (#115): the " · " separator and the plain about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    separator=" · "
    aboutClass=""
    class="mx-auto mt-2 w-full max-w-[430px] md:max-w-[760px] border-t border-border px-5 pb-6 pt-2 text-center text-step-1 text-primary"
  />
  <script>
    import '@/scripts/report-analytics'
  </script>
</Base>