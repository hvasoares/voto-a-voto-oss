---
/**
 * Meu Brasil sticker (the Sketch frame "23 Adesivo Meu Brasil", ticket #37): from the places of a Meu Brasil card (the address carries
 * them), a transparent PNG with the card's one-line headline and a QR code to the card, for a story or a poster. The way in is the
 * "Baixar adesivo" button of the Meu Brasil card, which carries the places in the address.
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import MeuBrasilSticker from '@/components/MeuBrasilSticker'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-meu-brasil'
import PageMain from '@/components/PageMain.astro'

const base = siteBase()
const fixture = await datasetFixture()
const edition = await currentEdition()
---
<Base title={`${message(DEFAULT_VOICE, 'mb.sticker.title')} · Voto a Voto`} description={message(DEFAULT_VOICE, 'mb.sticker.sub')}>
  <PhoneHeader />
  <PageMain md="480" data-page="meu-brasil-adesivo">
    <h1 class="mt-2 font-serif text-step-4 font-normal">{message(DEFAULT_VOICE, 'mb.sticker.title')}</h1>
    <p class="mt-1 text-step-1 text-muted-foreground">{message(DEFAULT_VOICE, 'mb.sticker.sub')}</p>
    <MeuBrasilSticker client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} />
    <noscript><p class="mt-2 text-step-1" data-nojs>O adesivo é desenhado no seu navegador e precisa de JavaScript.</p></noscript>
    {/* The #113 shared footer with this page's variant (#116): the " · " separator and the plain about link. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </PageMain>
</Base>
