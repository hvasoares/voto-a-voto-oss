---
/**
 * Meu Brasil (the Sketch frame "16 Meu Brasil", ticket #27): up to three places and ONE card comparing them across 2018, 2022 and
 * 2026, with one generated headline. The places live in the address, so reloading or forwarding the link reproduces the card; the card
 * shares through the existing share flow. Reached from the task block of the home.
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import MeuBrasil from '@/components/MeuBrasil'
import { normalizeBase, withBase } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const fixture = await datasetFixture()
const edition = await currentEdition()
---
<Base title={`${message(DEFAULT_VOICE, 'mb.title')} · Voto a Voto`} description={message(DEFAULT_VOICE, 'mb.sub')}>
  <PhoneHeader />
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[480px] lg:max-w-[1240px] lg:pt-8" id="main" data-page="meu-brasil">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px] lg:min-h-8 lg:border-0 lg:px-0 lg:text-[14px] lg:font-normal lg:text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px] lg:text-[46px] lg:leading-[56px]">{message(DEFAULT_VOICE, 'mb.title')}</h1>
    <p class="mt-1 text-small leading-[14px] text-muted-foreground lg:text-[15px] lg:leading-[20px]">{message(DEFAULT_VOICE, 'mb.sub')}</p>
    <MeuBrasil client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} />
    <noscript><p class="mt-2 text-small leading-[17px]" data-nojs>O Meu Brasil monta o cartão no seu navegador e precisa de JavaScript.</p></noscript>
    <footer class="mt-2 border-t border-border pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
      {fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'} · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </main>
</Base>
