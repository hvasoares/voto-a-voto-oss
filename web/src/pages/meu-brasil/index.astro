---
/**
 * Meu Brasil (the Sketch frame "16 Meu Brasil", ticket #27): up to three places and ONE card comparing them across 2018, 2022 and
 * 2026, with one generated headline. The places live in the address, so reloading or forwarding the link reproduces the card; the card
 * shares through the existing share flow. Reached from the "Comparar" chooser of the home.
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import MeuBrasil from '@/components/MeuBrasil'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-meu-brasil'
import PageMain from '@/components/PageMain.astro'

const base = siteBase()
const fixture = await datasetFixture()
const edition = await currentEdition()
---
<Base title={`${message(DEFAULT_VOICE, 'mb.title')} · Voto a Voto`} description={message(DEFAULT_VOICE, 'mb.sub')}>
  <PhoneHeader />
  <PageMain md="480" lg="1240" data-page="meu-brasil">
    <h1 class="mt-2 font-serif text-step-4 font-normal">{message(DEFAULT_VOICE, 'mb.title')}</h1>
    <p class="mt-1 text-step-1 text-muted-foreground lg:text-step-2">{message(DEFAULT_VOICE, 'mb.sub')}</p>
    <MeuBrasil client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} />
    <noscript><p class="mt-2 text-step-1" data-nojs>O Meu Brasil monta o cartão no seu navegador e precisa de JavaScript.</p></noscript>
    {/* The #113 shared footer with this page's variant (#116): the " · " separator and the plain about link. */}
    <SiteFooter
      source={fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'}
      separator=" · "
      aboutClass=""
      class="mt-2 border-t border-border pt-2 text-center text-step-1 text-primary"
    />
  </PageMain>
</Base>
