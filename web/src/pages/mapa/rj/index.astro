---
/**
 * Screen frame "5 Estado"'s map slot (ticket #16): the margin of the runoff round per MUNICIPALITY
 * of Rio de Janeiro. The municipality page pattern of the state map (/mapa/, #11): the island
 * pre-renders the list of the 92 municipalities (plain links), and the map view loads the committed
 * mesh (public/geo/municipios-rj.json) only when a visitor opens it. The state page of ticket #50
 * will host this island under `data-placeholder="state-map"`; until then this is the state's route.
 */
import Base from '@/layouts/Base.astro'
import CityMapMap from '@/components/CityMapMap'
import { normalizeBase, withBase } from '@/paths'
import { loadCityMapData } from '@/lib/city-map-data'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const uf = 'rj'
const ufNome = 'Rio de Janeiro'
const data = await loadCityMapData(uf)
if (data.rows.length === 0) throw new Error(`${uf}: o dataset deste build nao tem o estado (ciclos ausentes?)`)
---

<Base title={`Mapa por município · ${ufNome} · Voto a Voto`}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-16" id="main" data-page="mapa-rj">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px]" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px]">Mapa por município · {ufNome}</h1>
    <p class="mt-1 font-serif text-lead leading-[22px] wrap-anywhere">Margem de {data.ladoANome} sobre {data.ladoBNome} no 2º turno de {data.ano}, em pontos percentuais (pp), nos {data.rows.length} municípios do estado.</p>
    <nav class="mt-2 flex gap-3 text-body font-bold" aria-label="Voltar ao mapa por estado">
      <a href={href('/mapa/')}>‹ Mapa por estado</a>
    </nav>
    <CityMapMap client:interaction base={base} data={data} geoUrl={href(`/geo/municipios-${uf}.json`)} ufNome={ufNome} />
    <noscript>
      <p class="mt-1.5 text-small leading-[14px] text-muted-foreground">A vista de mapa precisa de JavaScript. A lista acima funciona sem.</p>
    </noscript>
    <p class="mt-1.5 text-small leading-[14px]" data-island-failed hidden>O mapa por município não está disponível agora. A lista acima continua.</p>
  </main>
  <footer class="mx-5 mt-2 border-t border-border pb-6 pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
    Fonte: TSE, dados finais · fronteiras: malhas do IBGE · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
  <script>
    import '@/scripts/map-pending'
  </script>
</Base>