---
/**
 * Screen 10 (Sketch frame "10 Mapa por estado"): the margin of the runoff round per state,
 * in the mosaic presentation by default. The island renders the frame's whole body.
 */
import Base from '@/layouts/Base.astro'
import StateMapMap from '@/components/StateMapMap'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { FOOTER_LINK } from '@/shared/link-classes'
import { loadStateMapData } from '@/lib/state-map-data'
import PageMain from '@/components/PageMain.astro'

const base = siteBase()
// The #113 base-path helper (`base` stays for the StateMapMap island, which takes the base argument).
const href = siteHref
const data = await loadStateMapData()
---

<Base title="Mapa por estado · Voto a Voto">
  <PageMain md="720" grid lg="1240" data-page="mapa">
    <div class="lg:relative lg:z-10 lg:col-start-1 lg:row-start-1 lg:w-[610px] lg:self-start">
    <h1 class="mt-2 font-serif text-step-4 font-normal">Mapa por estado</h1>
    <p class="mt-1 font-serif text-step-2 wrap-anywhere lg:text-muted-foreground">Margem de {data.ladoANome} sobre {data.ladoBNome} no 2º turno de {data.ano}, em pontos percentuais (pp), por estado.</p>
    </div>
    {/* The phone layout (tile mosaic, #11): not drawn from 1024 px up, where the map document below takes its place (#54). */}
    <div class="lg:hidden">
    <StateMapMap client:interaction kind="margin" base={base} data={data} />
    <noscript><p class="mt-1.5 text-step-1 text-muted-foreground">A vista de mapa precisa de JavaScript. O mosaico acima funciona sem.</p></noscript>
    {/* Drill-down (ticket #17): every state now has the municipality map -- on its own state page
        (the tile taps lead there) and at /mapa/<uf>/ (linked from the state page). */}
    <p class="mt-2" data-mapa-municipio>Mapa por município: toque num estado no mosaico acima — a página do estado traz o mapa dos municípios.</p>
    <p class="mt-1.5 text-step-1" data-island-failed hidden>O mapa por estado não está disponível agora. Escolha um estado na página inicial.</p>
  
    </div>
    {/* 1024 px and up: the SVG map, scale, panel and table as the document of a lazy iframe; a phone never requests it (docs/checkpoints/issue-53.md). */}
    <iframe class="hidden h-[760px] w-full border-0 lg:col-start-1 lg:row-start-1 lg:block" src={href('/fragmentos/mapa-por-estado/margem/')} title="Mapa por estado: o mapa, a escala, o estado selecionado e a tabela" loading="lazy" data-mapa-frame></iframe>
</PageMain>
  {/* The #113 shared footer with this page's variant (#116): the " · " separator and the tap-target about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    separator=" · "
    aboutClass={FOOTER_LINK}
    class="mx-5 mt-2 border-t border-border pb-2 text-center text-step-1 text-primary md:mx-auto md:w-full md:max-w-[680px] lg:mt-6 lg:max-w-[1200px] lg:border-t-0 lg:text-left"
  />
  <script>
    import '@/scripts/island-pending'
  </script>
</Base>