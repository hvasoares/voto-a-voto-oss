---
/**
 * Screen 10b (Sketch frame "10b Mapa por estado: virada"): how the margin moved between the
 * rounds, per state. Same island as /mapa/, different tab active and different legend.
 */
import Base from '@/layouts/Base.astro'
import StateMapMap from '@/components/StateMapMap'
import SiteFooter from '@/components/SiteFooter.astro'
import { siteBase, siteHref } from '@/paths'
import { FOOTER_LINK, NAV_CHIP_QUIET } from '@/shared/link-classes'
import { loadStateMapData } from '@/lib/state-map-data'
import PageMain from '@/components/PageMain.astro'

const base = siteBase()
// The #113 base-path helper (`base` stays for the StateMapMap island, which takes the base argument).
const href = siteHref
const data = await loadStateMapData()
---

<Base title="Mapa por estado: virada · Voto a Voto">
  <PageMain top="bar" md="720" grid lg="1240" data-page="mapa-virada">
    <div class="lg:relative lg:z-10 lg:col-start-1 lg:row-start-1 lg:w-[610px] lg:self-start">
    <a class={NAV_CHIP_QUIET} href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Mapa por estado: virada</h1>
    <p class="mt-1 font-serif text-step-2 wrap-anywhere lg:text-muted-foreground">Variação da margem entre o 1º e o 2º turno de {data.ano}, em pontos percentuais (pp), por estado.</p>
    </div>
    {/* The phone layout (tile mosaic, #11): not drawn from 1024 px up, where the map document below takes its place (#54). */}
    <div class="lg:hidden">
    <StateMapMap client:interaction kind="swing" base={base} data={data} />
    <noscript><p class="mt-1.5 text-step-1 text-muted-foreground">A vista de mapa precisa de JavaScript. O mosaico acima funciona sem.</p></noscript>
    <p class="mt-1.5 text-step-1" data-island-failed hidden>O mapa da virada não está disponível agora. Escolha um estado na página inicial.</p>
  
    </div>
    {/* 1024 px and up: the SVG map, scale, panel and table as the document of a lazy iframe; a phone never requests it (docs/checkpoints/issue-53.md). */}
    <iframe class="hidden h-[760px] w-full border-0 lg:col-start-1 lg:row-start-1 lg:block" src={href('/fragmentos/mapa-por-estado/virada/')} title="Mapa por estado: o mapa, a escala, o estado selecionado e a tabela" loading="lazy" data-mapa-frame></iframe>
</PageMain>
  {/* The #113 shared footer with this page's variant (#116): the " · " separator and the tap-target about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    separator=" · "
    aboutClass={FOOTER_LINK}
    class="mx-5 mt-2 border-t border-border pb-2 text-center text-step-1 text-primary md:mx-auto md:w-full md:max-w-[680px] lg:mt-6 lg:max-w-[1200px] lg:border-t-0 lg:text-left"
  />
  <script>
    import '@/scripts/island-pending'
  </script>
</Base>