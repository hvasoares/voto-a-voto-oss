---
/**
 * Screen frame "5 Estado"'s map slot as its own page (tickets #16+#17): the margin of the runoff
 * round per MUNICIPALITY, for every UF. One dynamic route (getStaticPaths over the UFs that have
 * both a state in the dataset and a committed mesh: public/geo/municipios-<uf>.json) pre-renders
 * `/mapa/rj/`, `/mapa/sp/`, ... -- the same page file is the only per-state piece, and #16's
 * `/mapa/rj/` URL is kept exactly. The state page (`/:uf/`, #50) hosts the same island under
 * `data-placeholder="state-map"`; this page is the focused drill-down linked from there.
 */
import Base from '@/layouts/Base.astro'
import CityMapMap from '@/components/CityMapMap'
import SiteFooter from '@/components/SiteFooter.astro'
import { normalizeBase, siteHref } from '@/paths'
import { FOOTER_LINK } from '@/shared/link-classes'
import { loadCityMapData, semContornoOf } from '@/lib/city-map-data'
import { loadStateUfs } from '@/lib/shard-files'
import { UF_NOME } from '@/lib/uf-names'
import { existsSync } from 'node:fs'
import { resolve } from 'node:path'

export async function getStaticPaths() {
  // The mesh file is the committed artifact of the data task; a state without one has no map page.
  const ufs = (await loadStateUfs()).filter((uf) => existsSync(resolve('./public/geo', `municipios-${uf}.json`)))
  return ufs.map((uf) => ({ params: { uf }, props: { uf } }))
}

const { uf } = Astro.props as { uf: string }
const base = normalizeBase(import.meta.env.BASE_URL)
// The #113 base-path helper (`base` stays for the CityMapMap island, which takes the base argument).
const href = siteHref
const ufNome = UF_NOME[uf] ?? uf.toUpperCase()
const data = await loadCityMapData(uf)
if (data.rows.length === 0) throw new Error(`${uf}: o dataset deste build nao tem o estado (ciclos ausentes?)`)
---

<Base title={`Mapa por município · ${ufNome} · Voto a Voto`}>
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-16" id="main" data-page="mapa-uf" data-uf={uf}>
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-step-2 font-bold" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">Mapa por município · {ufNome}</h1>
    <p class="mt-1 font-serif text-step-2 wrap-anywhere">Margem de {data.ladoANome} sobre {data.ladoBNome} no 2º turno de {data.ano}, em pontos percentuais (pp), {data.rows.length === 1 ? 'no 1 município' : `nos ${data.rows.length} municípios`} do estado.</p>
    <nav class="mt-2 flex gap-3 text-step-2 font-bold" aria-label="Voltar ao mapa por estado">
      <a href={href('/mapa/')}>‹ Mapa por estado</a>
    </nav>
    <CityMapMap client:interaction base={base} data={data} geoUrl={href(`/geo/municipios-${uf}.json`)} ufNome={ufNome} semContorno={semContornoOf(uf, data.rows)} />
    <noscript>
      <p class="mt-1.5 text-step-1 text-muted-foreground">A vista de mapa precisa de JavaScript. A lista acima funciona sem.</p>
    </noscript>
    <p class="mt-1.5 text-step-1" data-island-failed hidden>O mapa por município não está disponível agora. A lista acima continua.</p>
  </main>
  {/* The #113 shared footer with this page's variant (#116): the IBGE credit, the " · " separator and the tap-target about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais · fronteiras: malhas do IBGE"
    separator=" · "
    aboutClass={FOOTER_LINK}
    class="mx-5 mt-2 border-t border-border pb-2 text-center text-step-1 text-primary"
  />
  <script>
    import '@/scripts/island-pending'
  </script>
</Base>