---
/**
 * The reference of the static JSON API (ticket #64): endpoints, fields and the edition. Plain HTML, no island.
 */
import Base from '@/layouts/Base.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { LATEST_PATH, shardEndpoints } from '@/lib/api'
import { loadCityRoutes } from '@/lib/city-routes'
import { editionLabel, editionPath } from '@/lib/editions'
import { currentEdition } from '@/lib/editions-load'
import { siteHref } from '@/paths'
import { NAV_CHIP_QUIET } from '@/shared/link-classes'

// The #113 base-path helper.
const href = siteHref
const edition = await currentEdition()
const endpoints = shardEndpoints(edition.fingerprint)
const sample = (await loadCityRoutes()).find((c) => c.uf !== 'zz')
const rows: { name: string; path: string; what: string; fields: string }[] = [
  { name: 'Cidade', path: endpoints.city, what: 'Uma cidade: identificação e, por ciclo e turno, comparecimento e votos.', fields: 'city (uf, slug, nome, regiao, cdMunicipio, cdIbge, ciclos), cycles[ano][turno] (aptos, comparecimento, abstencoes, brancos, nulos, anuladosApuSep, validos, votes[número]), candidates[ano][turno][número] = [nome_urna, partido]' },
  { name: 'Estado', path: endpoints.state, what: 'As cidades de um estado.', fields: 'uf, regiao, cities[] (nome, slug)' },
  { name: 'Totais', path: endpoints.totals, what: 'Somas nacionais e por região, por ciclo e turno.', fields: 'national, regions[região], cada um com os mesmos campos de cycles[ano][turno]' },
  { name: 'Busca', path: endpoints.search, what: 'Todas as cidades, uma linha cada.', fields: '[nome, slug, uf]' },
  { name: 'Centros', path: endpoints.centroids, what: 'O centro IBGE de cada município, por estado.', fields: '{ uf: [[slug, lat, lon], ...] }' },
]
---

<Base title="API de dados abertos · Voto a Voto">
  <main class="mx-auto min-w-0 w-full max-w-[430px] md:max-w-[760px] flex-1 px-5 pt-16 lg:pt-8" id="main" data-page="api">
    <a class={NAV_CHIP_QUIET} href={href('sobre-os-dados/')}>‹ Sobre os dados</a>
    <h1 class="mt-2 font-serif text-step-4 font-normal">API de dados abertos</h1>
    <p class="mt-[5px]">Os mesmos arquivos JSON que as páginas leem, abertos a qualquer site ou programa, sem servidor nosso e sem chave. Só leitura: GET.</p>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="edicao">
      <h2 class="font-serif text-step-3 font-normal" id="edicao">Edição</h2>
      <p class="mt-[5px]" data-api-edition={edition.id}>Os arquivos abaixo são da edição <a href={href(editionPath(edition.id))}>{editionLabel(edition)}</a> (<code>{edition.id}</code>). O nome da pasta, <code>v{edition.fingerprint}</code>, muda quando os dados mudam; para achar a pasta atual leia <a href={href(LATEST_PATH)} data-latest-link>api/latest.json</a>. O <a href={href(editionPath(edition.id) + 'edition.json')}>edition.json</a> de cada edição, inclusive as antigas, não muda nunca.</p>
    </section>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="endpoints">
      <h2 class="font-serif text-step-3 font-normal" id="endpoints">Endereços e campos</h2>
      <ul class="mt-[5px] list-none p-0" data-component="api-endpoints">
        {rows.map((r) => (
          <li class="border-t border-border py-2 first:border-t-0 first:pt-0" data-endpoint={r.name}>
            <span class="font-bold">{r.name}</span>
            <code class="block break-all text-step-1">{href(r.path)}</code>
            <span class="block">{r.what}</span>
            <span class="block text-step-1 text-muted-foreground">{r.fields}</span>
          </li>
        ))}
      </ul>
      {sample && <p class="mt-1">Exemplo: <a href={href(`data/v${edition.fingerprint}/city/${sample.uf}/${sample.slug}.json`)} data-api-example>{sample.nome}</a>.</p>}
      <p class="mt-1 text-step-1 text-muted-foreground">Uma ausência significa sem dados, nunca zero: um ciclo ou turno sem linhas não tem chave. Votos de candidatos usam o número da urna, que se repete entre ciclos: leia sempre junto com o ano. O arquivo <code>peers.json</code> é entrada interna do site e não faz parte da API pública. Para as tabelas inteiras, veja os <a href={href(editionPath(edition.id))}>dados abertos da edição</a> (CSV e NDJSON).</p>
    </section>

    <section class="mt-2 border-t border-border pt-[7px]" aria-labelledby="regras">
      <h2 class="font-serif text-step-3 font-normal" id="regras">Uso</h2>
      <ul class="mt-[5px] list-disc space-y-1 pl-5" data-component="api-rules">
        <li><strong>CORS aberto:</strong> os arquivos são servidos com <code>Access-Control-Allow-Origin: *</code>, então qualquer página pode lê-los com <code>fetch</code>.</li>
        <li><strong>Sem medição:</strong> pedir um arquivo não aciona nenhuma análise de uso; os arquivos são só dados.</li>
        <li><strong>Licença:</strong> CC BY 4.0, citando o TSE como origem dos resultados e o projeto pela compilação; veja <a href={href('sobre-os-dados/#edicoes')}>Edições dos dados</a>.</li>
        <li><strong>Sem aviso de mudança de formato:</strong> o formato dos arquivos acompanha <a href="https://github.com/hvasoares/voto-a-voto-oss/blob/main/web/docs/shards.md">web/docs/shards.md</a>.</li>
      </ul>
    </section>
  </main>
  {/* The #113 shared footer with this page's variant (#116): the source note without the about link. */}
  <SiteFooter
    source="Fonte: TSE, dados finais"
    aboutLink={false}
    class="mx-auto w-full max-w-[430px] md:max-w-[760px] mt-2 border-t border-border px-5 pb-6 pt-2 text-center text-step-1 text-primary"
  />
</Base>
