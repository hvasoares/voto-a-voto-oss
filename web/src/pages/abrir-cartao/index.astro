---
/**
 * Reopen a card from its file (ticket #38): the visitor drops the SVG or the PNG of a card and the site draws the same view
 * again from its own data, or says that the keys do not match or that the file was altered. Nothing is uploaded: the file
 * is read in the browser and never inserted into the page. No entry point is linked yet (the address is the way in).
 */
import Base from '@/layouts/Base.astro'
import PhoneHeader from '@/components/PhoneHeader.astro'
import CardDrop from '@/components/CardDrop'
import { normalizeBase, withBase } from '@/paths'
import { datasetFixture } from '@/lib/shard-files'
import { siteOrigin } from '@/lib/share-url'
import { currentEdition } from '@/lib/editions-load'

const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const fixture = await datasetFixture()
const edition = await currentEdition()
---
<Base title="Abrir um cartão · Voto a Voto" description="Solte o arquivo de um cartão do Voto a Voto para abrir a mesma vista, refeita com os dados do site.">
  <PhoneHeader />
  <main class="mx-auto min-w-0 w-full max-w-[430px] flex-1 px-5 pt-3 md:max-w-[480px] lg:pt-8" id="main" data-page="abrir-cartao">
    <a class="inline-flex min-h-11 items-center rounded-md border border-border px-3 text-body font-bold leading-[18px] lg:min-h-8 lg:border-0 lg:px-0 lg:text-[14px] lg:font-normal lg:text-primary" href={href('/')}>‹ Início</a>
    <h1 class="mt-2 font-serif text-title font-normal leading-[30px]">Abrir um cartão</h1>
    <p class="mt-1 text-small leading-[14px] text-muted-foreground">Solte o arquivo de um cartão. O site refaz a mesma vista com os próprios dados e confere se o arquivo bate.</p>
    <CardDrop client:load base={base} origin={siteOrigin()} fixture={fixture} edition={edition.id} />
    <noscript><p class="mt-2 text-small leading-[17px]" data-nojs>Abrir um cartão precisa de JavaScript: o arquivo é lido no seu navegador.</p></noscript>
    <p class="mt-3 text-center text-[11px] leading-[14px] text-muted-foreground" data-note>O arquivo não sai do seu aparelho e nunca é colocado na página: o cartão mostrado é sempre o refeito pelo site. Imagens de aplicativos de mensagem costumam perder as chaves; o endereço impresso nelas é o caminho de volta.</p>
    <footer class="mt-2 border-t border-border pt-2 text-center text-[12.3px] leading-[15px] text-primary" data-component="source-footer">
      {fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'} · <a href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
    </footer>
  </main>
</Base>
