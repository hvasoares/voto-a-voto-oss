---
/**
 * The one layout of the report pages (ticket #118): everything the pages under `src/pages/relatorios/` shared and
 * repeated -- the document, the `<main>` shell, the back chip, the title, the seal, the notice, the share block and
 * the page footer. A page brings its DATA and COPY (title, lead, rows, notice words); it draws no shell of its own.
 *
 * The app header (the Voto a Voto link home and the city search, #153) comes from `Base`, like every page's: this layout draws none of its own.
 *
 * Input contract (typed; `assertReportPage` fails the build with the page named when a field is malformed):
 *  - `title`, `heading`  the document title and the h1; `description` the meta description (optional);
 *  - `calc`              `reportFacts().calc`, the page's one calculation entry (#155), drawn beside the title;
 *  - `seal`              `reportFacts().seal`, the "conferido" lines (an empty list draws nothing);
 *  - `report`            the `data-report` key the analytics and the specs read (absent on the hub and the cohorts page);
 *  - `page`              the `data-page` key (default "relatorios");
 *  - `notice`            the sentence of the notice box (absent → no notice); `noticeVariant` its alignment;
 *  - `share`             draw the share block (default false); `shareText` / `shareLabel` its words;
 *  - `back`              the back chip: `{ label, to }` (default "‹ Relatórios" to /relatorios/);
 *  - `wide`              the 1200 px desktop shell of the outlier list (default: the 760 px column);
 *  - `bottomPad`         the `pb-2` under the content (default true; the cohorts page has none);
 *  - `aboutLabel`        the footer's about-link words (default "Sobre os dados ›");
 *  - `main`              extra attributes of `<main>` (`data-uf`, `data-min`).
 * Slots: default (the page's content, under the title), `banner` (above the title), `after-notice` (under the notice).
 *
 * The transformation of data to rows, notices and lead copy STAYS in each page (it is the report's own content).
 * A new report is: a folder `src/pages/relatorios/<slug>/index.astro` that loads `loadReports()` + `reportFacts()` and
 * hands this layout its copy and `ReportTable` its rows. Proven on a scratch branch (an eighth report built from its
 * data and copy). The registers it still needed, because they are the report's records and listings, not layout:
 *  - `lib/facts/pages.ts` (`loadFactPages`): the report's fact records, one `swingFacts(...)` / `raceFacts(...)` style call
 *    (a new SHAPE of record goes in `lib/facts/other.ts`); without it the build fails with "no fact page /fato/...";
 *  - `e2e/routes-inventory.ts` (`KNOWN_ROUTES`, examples, type-scale screen): the route inventory test names the missing line;
 *  - `lib/reports/hub.ts`: the hub row, only if the report is to be listed on /relatorios/ (an editorial choice).
 * Nothing else: `lib/fallback.ts` already holds `/relatorios/:report/`, and the perf budget (`report` class) reads built routes.
 */
import Base from '@/layouts/Base.astro'
import ReportNotice from '@/components/ReportNotice.astro'
import ReportShare from '@/components/ReportShare.astro'
import Seal from '@/components/Seal.astro'
import PageMain from '@/components/PageMain.astro'
import SiteFooter from '@/components/SiteFooter.astro'
import { assertReportPage } from '@/lib/reports/layout'
import { siteHref } from '@/paths'
import type { Raw } from '@/shared/html'
import { NAV_CHIP_QUIET } from '@/shared/link-classes'
import { footerClass } from '@/shared/page-shell'

interface Props {
  title: string
  heading: string
  calc: Raw
  seal: string[]
  description?: string
  report?: string
  page?: string
  notice?: string
  noticeVariant?: 'centered' | 'plain'
  share?: boolean
  shareText?: string
  shareLabel?: string
  back?: { label: string; to: string }
  wide?: boolean
  bottomPad?: boolean
  aboutLabel?: string
  main?: Record<string, string | number>
}
const {
  title,
  heading,
  calc,
  seal,
  description,
  report,
  page = 'relatorios',
  notice,
  noticeVariant,
  share = false,
  shareText,
  shareLabel,
  back = { label: '‹ Relatórios', to: '/relatorios/' },
  wide = false,
  bottomPad = true,
  aboutLabel,
  main = {},
} = Astro.props
assertReportPage({ title, heading, seal, report, notice })
const footerShell = footerClass(wide ? { md: '760', lg: '1200', leftFromDesktop: true } : { md: '760' })
---
<Base title={title} description={description}>
  <PageMain md="760" lg={wide ? '1200' : undefined} padBottom={bottomPad} extra={wide ? 'lg:px-0' : undefined} data-page={page} data-report={report} {...main}>
    <a class={NAV_CHIP_QUIET} href={siteHref(back.to)}>{back.label}</a>
    <slot name="banner" />
    <div class="mt-2 flex items-center justify-between gap-2">
      <h1 class="font-serif text-step-4 font-normal">{heading}</h1>
      <Fragment set:html={calc} />
    </div>
    <slot />
    <Seal lines={seal} />
    {notice && <ReportNotice text={notice} variant={noticeVariant} />}
    <slot name="after-notice" />
    {share && <ReportShare text={shareText} label={shareLabel} wide={wide} />}
  </PageMain>
  {/* The #113 shared footer with the report variant (#115): the " · " separator and the plain about link. */}
  <SiteFooter source="Fonte: TSE, dados finais" separator=" · " aboutClass="" aboutLabel={aboutLabel} class={footerShell} />
  {share && (
    <script>
      import '@/scripts/report-analytics'
    </script>
  )}
</Base>
