---
/**
 * The shell of a "fragment" document (G10 desktop): a small page that the desktop layout embeds in an <iframe loading="lazy">
 * which is only drawn from 1024 px up. A lazy iframe that is not drawn is never requested, so a phone downloads none of it
 * (ticket #53: the inline SVG map would have added about 5 KB gzip to the phone's Home HTML). No script, no analytics, no top bar;
 * its links open in the parent window (`<base target="_top">`). Not an entry point: noindex, linked from nowhere.
 */
import 'virtual:theme.css'
import '../styles/scale.css'
import '../styles/uf-map.css'
import '../styles/map-fragment.css'
import DocHead from '@/components/DocHead.astro'

interface Props {
  title: string
}
const { title } = Astro.props
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <DocHead title={title} noindex baseTarget="_top" />
  </head>
  <body style="margin:0;background:transparent;font-family:var(--sketch-font-sans)">
    <slot />
  </body>
</html>
