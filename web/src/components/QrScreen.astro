---
/**
 * The Mostrar QR screen + printable poster for the demo (/qr/) and Brasil (/brasil/qr/) routes (#137): it draws the config it is handed
 * (`lib/screen-scopes.ts` builds one per scope) and never looks at which scope it is. The markup is `qrScreenHtml` of `lib/qr-screen.ts`, the
 * ONE template of the screen: the city route (`/:uf/:slug/qr/`) is a stub whose script draws the same string from its data file (private#208).
 * The QR is a deterministic build-time glyph from src/lib/qr-code.ts (its SVG arrives built), the poster is CSS (@media print / @page A4) and
 * printing comes from the browser's own print command. The analytics events (qr_screen_shown, poster_printed, ticket #20) are wired by the
 * dedicated script src/scripts/qr-analytics.ts, which the pages carrying this template import; they only reach a provider after the consent boot (#20).
 */
import Base from '@/layouts/Base.astro'
import { qrScreenHtml } from '@/lib/qr-screen'
import { shortAddress } from '@/lib/short-address'
import type { QrScreenConfig } from '@/lib/screen-scopes'

interface Props {
  /** The screen's config for its scope (the demo or Brasil): `qrScreenConfig(scope)` of `lib/screen-scopes.ts` builds everything that differs, as data. */
  config: QrScreenConfig
}
const { cityName, url, qr, fixture, closeHref, backHref, noindex } = Astro.props.config
const screen = qrScreenHtml({ cityName, url, address: shortAddress(url), fixture, closeHref, backHref, qr, brand: true })
---
<Base title={`Mostrar QR · ${cityName}`} noindex={noindex} header="none">
  <main class="min-w-0 flex-1" id="main">
    <Fragment set:html={screen} />

    <style is:global>
      /* The one-page poster (ticket #9): every screen layer hides on print and this section is the page. */
      @page {
        size: A4 portrait;
        margin: 12mm;
      }
    </style>
    {/* The two QR events are a tiny dedicated script (ticket #20): still no island — the screen stays static. */}
    <script>
      import '@/scripts/qr-analytics'
    </script>
  </main>
</Base>
