---
/**
 * The desktop top bar (ticket #51, then #103, Sketch "1 Home (desktop, top bar por tarefa)"): wordmark, the city search ("Ver minha cidade")
 * and three task links (Comparar, Conferir, Usar os dados), each a plain anchor into a section of Home or of Sobre os dados. Relatórios and Mapa
 * por estado left the bar: Home's "Entender o país e os estados" block and the footer line keep them reachable.
 * Pre-rendered HTML, readable and usable without scripts (the search needs them, as everywhere); the search is the
 * existing CitySearch component, but it is NOT an Astro island: an island would put the island runtime and its props in the
 * HTML of every page, phones included. The bar draws a plain field instead (`HeaderSearch.astro`, the same one the phone header draws, #153); on a 1024 px and wider viewport
 * `scripts/desktop-shell.ts` mounts the real CitySearch (React, cmdk) into it on first focus, so nothing of it downloads
 * before the first interaction, and a phone never downloads it at all. Hidden below 1024 px: a phone keeps each page's
 * own header, and the bar costs it a few hundred HTML bytes (no script of its own).
 */
import { siteHref } from '@/paths'
import HeaderSearch from '@/components/HeaderSearch.astro'

const links = [
  { label: 'Comparar', to: '/#comparar' },
  { label: 'Conferir', to: 'sobre-os-dados/#confira-voce-mesmo' },
  { label: 'Usar os dados', to: 'sobre-os-dados/#usar-os-dados' },
].map((l) => ({ ...l, href: siteHref(l.to) }))
---
<header class="hidden h-16 border-b border-border lg:block" data-component="top-bar">
  <div class="mx-auto flex h-full w-full max-w-[1240px] items-center px-5">
    <a class="flex min-h-11 w-[280px] flex-none items-center rounded-sm font-serif text-step-4 text-foreground focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary" href={siteHref('/')} data-wordmark>Voto a Voto</a>
    <div class="w-[420px] flex-none"><HeaderSearch kbd /></div>
    <nav class="ml-auto flex items-center gap-1" aria-label="Principal">
      {links.map((l) => (
        <a class="inline-flex min-h-11 items-center rounded-sm px-4 text-step-2 text-foreground underline-offset-8 hover:underline focus-visible:outline-2 focus-visible:outline-offset-1 focus-visible:outline-primary" href={l.href}>{l.label}</a>
      ))}
    </nav>
  </div>
</header>
