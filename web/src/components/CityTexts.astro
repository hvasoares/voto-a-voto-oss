---
/**
 * "Textos prontos" (#65) on a page: the one block is `CityTextsBlock` (the share sheet's stub draws it from its data file, private#210); this prints it
 * as static markup, with the build's exceptions for place words (`lib/place-except.ts`), where a page still carries the block.
 */
import CityTextsBlock from '@/components/CityTextsBlock'
import { placeExceptions } from '@/lib/place-except'
import type { CityTexts } from '@/lib/city-texts-build'

interface Props {
  texts: CityTexts
  stateHref: string
}
const { texts, stateHref } = Astro.props
---
<CityTextsBlock texts={texts} stateHref={stateHref} except={await placeExceptions()} />
