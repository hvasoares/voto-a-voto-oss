---
/**
 * "Textos prontos" (#65): the WhatsApp/SMS block and the read-aloud bulletin of a city, printed in the page (readable without scripts; both registers
 * are printed in plain language, the card's one text, #157). The copy buttons are an enhancement: they stay hidden until the small script below runs.
 */
import { DEFAULT_VOICE, message } from '@/lib/sentences/catalog'
import '@/lib/sentences/catalog-texts'
import type { CityTexts } from '@/lib/city-texts-build'
import { CARD_REGISTER } from '@/lib/sentences/register'
import PlaceText from '@/components/PlaceText.astro'

interface Props {
  texts: CityTexts
  stateHref: string
}
const { texts, stateHref } = Astro.props
const say = (key: string) => message(DEFAULT_VOICE, key as never)
const blocks = [
  { id: 'whatsapp', title: say('text.wa.title'), note: '', body: texts.whatsapp },
  { id: 'radio', title: say('text.radio.title'), note: say('text.radio.note'), body: texts.bulletin },
] as const
---
<section class="mt-3 border-t border-border pt-3" data-city-texts aria-labelledby="textos-prontos">
  <h2 id="textos-prontos" class="font-serif text-step-3">{say('text.section.title')}</h2>
  <p class="mt-1 text-step-1 text-muted-foreground">{say('text.section.note')}</p>
  {blocks.map((b) => (
    <div class="mt-3" data-text-block={b.id}>
      <h3 class="text-step-2 font-bold">{b.title}</h3>
      {b.note && <p class="text-step-1 text-muted-foreground">{b.note}</p>}
      <p class="mt-1 whitespace-pre-line rounded-md border border-border bg-[var(--c-paper-2)] p-3 text-step-2 wrap-anywhere" data-text={b.id}><PlaceText text={b.body[CARD_REGISTER]} /></p>
      <button type="button" class="mt-2 min-h-11 w-full rounded-md border border-border bg-background text-step-2 font-bold text-foreground" data-copy={b.id} data-copied={say('text.copied')} data-failed={say('text.copy.failed')} hidden>{say('text.copy')}</button>
    </div>
  ))}
  <p class="min-h-6 text-step-1 text-muted-foreground" role="status" aria-live="polite" data-copy-status></p>
  <a class="mt-1 flex min-h-11 items-center text-step-2 font-bold text-primary" href={stateHref} data-state-texts>{say('text.state.link')}</a>
</section>
<script>
  // Copy buttons: shown only here; the text copied is the one on screen.
  const root = document.querySelector('[data-city-texts]')
  const status = root?.querySelector('[data-copy-status]')
  root?.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    if (!navigator.clipboard) return
    button.hidden = false
    button.addEventListener('click', () => {
      const shown = root.querySelector<HTMLElement>(`[data-text="${button.dataset.copy}"]`)
      void navigator.clipboard.writeText(shown?.textContent ?? '').then(
        () => status && (status.textContent = button.dataset.copied ?? ''),
        () => status && (status.textContent = button.dataset.failed ?? ''),
      )
    })
  })
</script>
