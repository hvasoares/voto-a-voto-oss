---
/**
 * THE app header (tickets #136, #153): the Voto a Voto wordmark as a link home, a hairline divider, the scope, and the city search
 * ("Ver minha cidade", `HeaderSearch.astro`: a plain field that becomes the real search on the first interaction). Every public page
 * carries it: `Base.astro` and `QuietDoc.astro` draw it for the pages, `ReportLayout.astro` through `Base`; no page draws a header of its own.
 * Hidden from 1024 px, where the shell's top bar (`TopBar.astro`, the same field) carries the wordmark and the search.
 *
 *  - `phone`   (default) the Tailwind header of the 430 px column the pages draw in;
 *  - `screen`  the same header drawn with the screen stylesheet (`.app-header` in `styles/screens.css`), for the pages of that stylesheet
 *              (the city card, the state page, the three-cycles page, the fact record), which place it inside their own `.screen`.
 * `data-app-header` marks it for the route guard (`e2e/app-header.spec.ts`).
 */
import { siteHref } from '@/paths'
import HeaderSearch from '@/components/HeaderSearch.astro'

interface Props {
  variant?: 'phone' | 'screen'
}
const { variant = 'phone' } = Astro.props
---
{variant === 'screen' ? (
  <>
    <header class="app-header" data-app-header>
      <a class="brand" href={siteHref('/')}>Voto a Voto</a>
      <span class="app-header__sep" aria-hidden="true"></span>
      <span class="app-header__context">Presidente 2026</span>
    </header>
    <div class="px-5 pb-2 pt-2 lg:hidden"><HeaderSearch /></div>
  </>
) : (
  <header class="mx-auto w-full max-w-[430px] border-b border-border px-5 pb-2 md:max-w-[480px] lg:hidden" data-component="phone-header" data-app-header>
    <div class="flex h-11 items-center">
      {/* The #113 base-path helper. */}
      <a class="inline-flex min-h-11 items-center font-serif text-step-3 text-foreground" href={siteHref('/')}>Voto a Voto</a>
      <span class="mx-3 h-4 w-px bg-border" aria-hidden="true"></span>
      <span class="text-step-1 text-muted-foreground">Presidente 2026</span>
    </div>
    <HeaderSearch />
  </header>
)}
