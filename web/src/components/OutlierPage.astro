---
/**
 * "Cidades fora da curva" (Sketch frames "22 Cidades fora da curva", phone and desktop, ticket #34): a SCREENING list of the cities furthest from their peer
 * cities on turnout and on the swing since 2022, under a Relatórios hub row. The text that says it is a screening list and not a conclusion is the first
 * thing under the title and the share text. One static page per state and minimum (the filters are links, so the list works without JavaScript); every row
 * shows the valid-vote count next to the rate, links to the city card and has its fact record (the calculation link) and the page its "conferido" seal.
 */
import { candidateName } from '@/shared/candidate-name'
import ReportLayout from '@/layouts/ReportLayout.astro'
import ReportShare from '@/components/ReportShare.astro'
import { siteBase, siteHref } from '@/paths'
import { siteOrigin } from '@/lib/share-url'
import { outlierPath } from '@/lib/reports/outliers'
import { loadOutliers } from '@/lib/reports/outliers-load'
import { outlierShare, outlierView } from '@/lib/reports/outliers-view'
import { RANK_BADGE, reportFacts } from '@/lib/reports/page'
import { getOutlierFacts } from '@/lib/facts/pages'

interface Props {
  uf?: string
  min: number
}
const { uf, min } = Astro.props
const base = siteBase()
// The #113 base-path helper (`base` stays for outlierView and the fact links, which take the base argument).
const href = siteHref
const set = await loadOutliers()
const filter = { uf, min }
const picked = set.pick(filter)
const view = outlierView({ filter, shown: picked.shown, compared: picked.compared, names: { primeiro: candidateName(set.pair.nomePrimeiro), segundo: candidateName(set.pair.nomeSegundo) }, states: set.states, base })
const { calc, seal } = await reportFacts('relatorios/cidades-fora-da-curva', 'cidades', await getOutlierFacts())
const share = outlierShare(`${siteOrigin()}${href(outlierPath(uf, min))}`)
const summary = 'flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 rounded-md border border-border bg-background px-3 text-step-1 font-bold [&::-webkit-details-marker]:hidden'
const menu = 'absolute left-0 right-0 z-10 mt-1 max-h-72 overflow-auto rounded-md border border-border bg-background p-1 shadow-md'
const item = 'flex min-h-11 items-center rounded px-2 text-step-1 aria-[current=true]:bg-secondary aria-[current=true]:font-bold'
const cols = 'lg:grid lg:grid-cols-[2rem_minmax(0,1.7fr)_repeat(5,minmax(0,1fr))_5.5rem] lg:items-center lg:gap-x-4'
---

<ReportLayout
  title="Cidades fora da curva · Voto a Voto"
  description={view.screening}
  heading="Cidades fora da curva"
  report="cidades-fora-da-curva"
  main={{ 'data-uf': uf ?? 'todos', 'data-min': min }}
  seal={seal}
  wide
  notice={view.note}
  noticeVariant="plain"
  share
  shareText={view.screening}
  shareLabel={share.label}
>
    <p class="mt-1 text-step-1 text-muted-foreground wrap-anywhere lg:font-serif lg:text-step-2" data-screening>{view.screening}</p>

<div class="mt-3 lg:flex lg:items-start lg:justify-between lg:gap-6">
    <nav class="grid grid-cols-2 gap-2 lg:w-[640px]" aria-label={view.filters.label} data-filters>
      <details class="relative" data-filter="uf">
        <summary class={summary}><span>{view.filters.uf.label}</span><span aria-hidden="true">▾</span></summary>
        <ul class={`${menu} list-none`}>
          {view.filters.uf.options.map((o) => <li><a class={item} href={o.href} aria-current={o.current ? 'true' : undefined}>{o.label}</a></li>)}
        </ul>
      </details>
      <details class="relative" data-filter="min">
        <summary class={summary}><span>{view.filters.min.label}</span><span aria-hidden="true">▾</span></summary>
        <ul class={`${menu} list-none`}>
          {view.filters.min.options.map((o) => <li><a class={item} href={o.href} aria-current={o.current ? 'true' : undefined}>{o.label}</a></li>)}
        </ul>
      </details>
    </nav>

      <ReportShare placement="head" text={view.screening} label={share.label} />
    </div>

    <p class="mt-3 text-step-1 text-muted-foreground lg:hidden" data-legend>{view.legend}</p>
    <p class="mt-1 text-step-1 text-muted-foreground" data-count>{view.count} <Fragment set:html={calc(`filtro-${uf ?? 'todos'}-${min}`)} /></p>

    {view.empty && <p class="mt-3 text-step-2" data-empty>{view.empty}</p>}
    {view.rows.length > 0 && (
      <>
        <div class={`mt-3 hidden border-b border-foreground pb-1 text-step-1 font-bold uppercase tracking-wide text-muted-foreground ${cols}`} aria-hidden="true">
          <span>{view.columns.rank}</span>
          <span>{view.columns.city}</span>
          <span class="text-center">{view.columns.turnout}</span>
          <span class="text-center">{view.columns.typical}</span>
          <span class="text-center">{view.columns.gap}</span>
          <span class="text-center">{view.columns.swing}</span>
          <span class="text-center">{view.columns.validos}</span>
          <span></span>
        </div>
        <ol class="mt-1 list-none p-0 lg:mt-0" data-outliers>
          {view.rows.map((r) => (
            <li class="border-t border-border first:border-t-0 lg:border-t" data-outlier={r.anchor}>
              <div class={`flex gap-3 py-3 ${cols}`}>
                <span class={RANK_BADGE}>{r.rank}</span>
                <div class="min-w-0 flex-1 lg:contents">
                  <a class="block min-h-11 min-w-0 lg:min-h-0" href={r.href}>
                    <span class="block text-step-2 font-bold text-foreground">{r.name}</span>
                    <span class="mt-[5px] block text-step-1 text-muted-foreground lg:hidden">{r.turnoutLine} · {r.validosLine}</span>
                    <span class="mt-[2px] block text-step-1 text-muted-foreground lg:hidden">{r.swingLine}</span>
                  </a>
                  <span class="hidden text-center text-step-2 lg:block">{r.turnout}</span>
                  <span class="hidden text-center text-step-2 text-muted-foreground lg:block">{r.typical}</span>
                  <span class="hidden text-center text-step-2 font-bold lg:block">{r.gap}</span>
                  <span class="hidden text-center text-step-2 lg:block">{r.swing}</span>
                  <span class="hidden text-center text-step-2 text-muted-foreground lg:block">{r.validos}</span>
                  <span class="hidden whitespace-nowrap text-center lg:block"><Fragment set:html={calc(r.anchor)} /></span>
                  <span class="block lg:hidden"><Fragment set:html={calc(r.anchor)} /></span>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </>
    )}

    <Fragment slot="after-notice">
      <p class="mt-2 text-step-1 text-muted-foreground" data-sign>{view.sign}</p>
      <p class="mt-1 text-step-1 text-muted-foreground" data-method>{view.method}</p>
    </Fragment>
</ReportLayout>
