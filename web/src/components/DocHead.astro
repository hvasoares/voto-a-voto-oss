---
/**
 * What goes inside the `<head>` of every document the site builds (ticket #136): Base, QuietDoc, EmbedDoc and FragmentDoc all draw it, so the charset, the viewport,
 * the robots and base tags, the title, the description and the link-preview tags are written once. A layout hands it what its document needs;
 * the stylesheet imports stay in each layout (they decide which CSS a document links, which is the layout's job, not the head's).
 *
 *  - `title`        the document title;
 *  - `description`  the meta description (absent on pages that describe themselves nowhere);
 *  - `preview`      the page's link-preview contract (og/twitter tags), absent on pages that have none;
 *  - `importMap`    the JSON of the CDN import map when the build configures one ('' or absent: no script); Base and QuietDoc pass `virtual:cdn-importmap`,
 *                   imported by the layout itself (a module the head imported would move the order Astro inlines the stylesheets in);
 *  - `noindex`      `<meta name="robots" content="noindex">`: embeds and fragments are parts of other pages, not pages to be found;
 *  - `baseTarget`   `<base target>`: where the document's links open (embed: a new tab, fragment: the parent window).
 * The layout writes the `<head>` element itself and draws this inside it (Astro puts the stylesheets of the page at the layout's `<head>`).
 * A component that imports a module the layout used to import moves the order the page's inline styles come in: measured by the all-pages comparison.
 * The tags come out in this order: charset, viewport, robots, base, import map, title, description, preview.
 */
import type { PreviewHead } from '@/lib/link-preview'

interface Props {
  title: string
  description?: string
  preview?: PreviewHead
  importMap?: string
  noindex?: boolean
  baseTarget?: '_blank' | '_top'
}
const { title, description, preview, importMap, noindex = false, baseTarget } = Astro.props
---
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  {noindex && <meta name="robots" content="noindex" />}
  {baseTarget && <base target={baseTarget} />}
  {importMap && <script type="importmap" is:inline set:html={importMap} />}
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  {preview && (
    <>
      <meta property="og:type" content="website" />
      <meta property="og:title" content={preview.ogTitle} />
      <meta property="og:description" content={preview.description} />
      <meta property="og:url" content={preview.url} />
      {preview.image && (
        <>
          <meta property="og:image" content={preview.image.url} />
          <meta property="og:image:type" content={preview.image.type} />
          <meta property="og:image:width" content={String(preview.image.width)} />
          <meta property="og:image:height" content={String(preview.image.height)} />
          <meta property="og:image:alt" content={preview.image.alt} />
        </>
      )}
      <meta name="twitter:card" content={preview.image ? 'summary_large_image' : 'summary'} />
      <meta name="twitter:title" content={preview.ogTitle} />
      <meta name="twitter:description" content={preview.description} />
      {preview.image && <meta name="twitter:image" content={preview.image.url} />}
      {preview.image && <meta name="twitter:image:alt" content={preview.image.alt} />}
    </>
  )}
