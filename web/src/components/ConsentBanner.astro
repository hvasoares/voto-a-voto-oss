---
/**
 * The metrics banner (Base.astro, every page): a fixed, quiet bottom bar, following the screen tokens
 * (text-small, border-border, min-h-11 tap targets). The Notice model, 2026-10-27 — g1/Globo style:
 * the text is informational ("ao utilizar nossos serviços, você está ciente dessa funcionalidade") and
 * the single "Prosseguir" button only records the acknowledgment (localStorage) so it does not
 * reappear; the boot script (src/scripts/analytics-boot.ts) reveals it to fresh visitors only.
 * Measurement itself does not wait for the banner — it is implied by the use of the site (see the
 * privacy section). It sits at z-40, BELOW the page's own bottom overlays (the share sheet and dialogs
 * are z-50): a first visit can still use those screens — the banner reappears once the overlay closes.
 */
interface Props {
  /** Absolute base path of the site (the "Privacidade" detail link points at /sobre-os-dados/#privacidade). */
  privacyHref: string
}
const { privacyHref } = Astro.props
---
<div
  id="consent-banner"
  data-consent-banner
  role="region"
  aria-label="Aviso sobre métricas de uso"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-border bg-background"
  hidden
>
  <div class="mx-auto flex w-full max-w-[430px] flex-col gap-2 px-5 py-3">
    <p class="text-small leading-[16px]">
      Para saber como o site é usado, este site usa o Google Analytics — páginas vistas, buscas e
      compartilhamentos, com dados gerais apenas, nada pessoal. Ao utilizar nossos serviços, você está
      ciente dessa funcionalidade. <a class="underline" href={privacyHref}>Detalhes em Sobre os dados</a>.
    </p>
    <div class="flex">
      <button
        type="button"
        data-consent-continue
        class="flex-1 rounded-md bg-primary px-4 text-body text-primary-foreground min-h-11"
      >Prosseguir</button>
    </div>
  </div>
</div>