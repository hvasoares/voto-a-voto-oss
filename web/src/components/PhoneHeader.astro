---
/**
 * The phone's page header of the card pages (the frames' "Voto a Voto | Presidente 2026" line under the status bar): wordmark,
 * a hairline divider and the scope. Hidden from 1024 px, where the shell's top bar carries the wordmark.
 */
import { siteHref } from '@/paths'
---
<header class="mx-auto flex h-11 w-full max-w-[430px] items-center border-b border-border px-5 md:max-w-[480px] lg:hidden" data-component="phone-header">
  {/* The #113 base-path helper. */}
  <a class="font-serif text-step-3 text-foreground" href={siteHref('/')}>Voto a Voto</a>
  <span class="mx-3 h-4 w-px bg-border" aria-hidden="true"></span>
  <span class="text-step-1 text-muted-foreground">Presidente 2026</span>
</header>
