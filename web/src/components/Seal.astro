---
/**
 * The "conferido" seal (#62): what the numbers of the page were checked against, one line per check and round, written by `lib/facts/checks.ts` from what
 * the build measured (never typed). The markup is `lib/facts/seal-markup.ts` (the calculation page's client draws the same block from the data file);
 * nothing here but the catalog's title and note: the lines arrive finished.
 */
import '@/lib/sentences/catalog-facts'
import { message } from '@/lib/sentences/catalog'
import { sealMarkup } from '@/lib/facts/seal-markup'

interface Props {
  lines: string[]
}
const { lines } = Astro.props
const voice = { locale: 'pt-BR', register: 'standard' } as const
---
<Fragment set:html={sealMarkup(lines, { title: message(voice, 'seal.title'), note: message(voice, 'seal.note') })} />
