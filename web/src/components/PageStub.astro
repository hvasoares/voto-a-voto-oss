---
/**
 * THE stub page (private#206, the lighter-site milestone): a real page of a few KB that says what is loading. The page of a family whose content is
 * drawn on the client (the QR page first) wraps this and draws no header, footer or head of its own: the layout `Base.astro` gives the head
 * (title, `noindex`, the canonical link), the top bar, the app header and the shared footer; this draws the column with the title, the loading area, the
 * sentence for a visitor without scripts and the link back. It has no family-specific content: the family hands in only its words and addresses.
 *
 *  - `title`          the document title and the `<h1>` (the family's, unchanged from the page it replaces);
 *  - `what`           the noun phrase of what loads, from the family's catalog ("o QR da cidade"): it fills the `{what}` slot of `stub.loading` and `stub.needsScripts`;
 *  - `path`           the site path of this page ("sp/sao-paulo/qr/"): the canonical link is the site origin plus `siteHref(path)`;
 *  - `backHref`       the site path of the page the visitor came from; the link back is `siteHref(backHref)` with the words of `stub.back` (or the family's `backLabel`);
 *  - `data-*` markers `data-page` and the like go to the `<main>`.
 * The loading area (`[data-stub-area]`, a polite status) holds the loading sentence, which a visitor without scripts does not see (`scripting: none`
 * hides it); the default slot lands inside it, for the loader (`lib/page-data-loader.ts`, private#207) to draw into; the area carries the loader's three sentences
 * as `data-arrived`, `data-failed-text` and `data-retry-text`, so the shipped script holds no catalog. The `<noscript>` sentence says the page needs scripts and the
 * link back stays: no blank page. The page is `noindex`: the stubs are parts of the city's pages, not pages to be found.
 */
import '@/lib/sentences/catalog-shell'
import { message } from '@/lib/sentences/catalog'
import Base from '@/layouts/Base.astro'
import PageMain from '@/components/PageMain.astro'
import { siteHref } from '@/paths'
import { siteOrigin } from '@/lib/share-url'

interface Props {
  title: string
  what: string
  path: string
  backHref: string
  backLabel?: string
  [attr: string]: unknown
}
const { title, what, path, backHref, backLabel, ...attrs } = Astro.props
const voice = { locale: 'pt-BR', register: 'standard' } as const
const canonical = new URL(siteHref(path), siteOrigin()).href
---
<Base title={title} noindex canonical={canonical}>
  <PageMain {...attrs}>
    <h1 class="mt-2 font-serif text-step-4 font-normal">{title}</h1>
    <div class="mt-3" data-stub-area role="status" aria-live="polite" data-arrived={message(voice, 'stub.arrived', { what })} data-failed-text={message(voice, 'stub.failed', { what })} data-retry-text={message(voice, 'stub.retry')}>
      <p class="text-step-2 text-muted-foreground [@media(scripting:none)]:hidden" data-stub-loading>{message(voice, 'stub.loading', { what })}</p>
      <slot />
    </div>
    <noscript><p class="mt-3 text-step-2" data-stub-needs-scripts>{message(voice, 'stub.needsScripts', { what })}</p></noscript>
    <a class="mt-4 inline-flex min-h-11 items-center text-step-2 text-primary underline" href={siteHref(backHref)} data-stub-back>{backLabel ?? message(voice, 'stub.back')}</a>
  </PageMain>
</Base>
