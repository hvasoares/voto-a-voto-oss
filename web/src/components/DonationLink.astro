---
import { donationUrl } from '@/lib/donation'

/**
 * "Apoie o projeto": the donation link of ticket #36. It opens the donation page in a new tab and is drawn only
 * when an address is configured (PUBLIC_DONATION_URL); with none, nothing is rendered. `variant="button"` is the
 * outlined 30 px button of the Sketch frame (its tap area is 44 px: a pseudo-element extends the hit area, the #19 rule) on the data page, the default is the quiet link of the footer line shown on every page.
 */
interface Props {
  variant?: 'link' | 'button'
}
const { variant = 'link' } = Astro.props
const url = donationUrl()
---
{url && variant === 'link' && (
  <>
    <span aria-hidden="true"> · </span>
    <a href={url} target="_blank" rel="noopener noreferrer" data-donation-link>Apoie o projeto ↗<span class="sr-only"> (abre em nova aba)</span></a>
  </>
)}
{url && variant === 'button' && (
  <a class="relative mt-[7px] flex h-[30px] items-center justify-center rounded-lg border border-primary bg-background px-3 text-[13px] font-bold leading-4 text-primary before:absolute before:inset-x-0 before:-inset-y-[8px] before:content-['']" href={url} target="_blank" rel="noopener noreferrer" data-donation-link>
    Apoie o projeto ↗&nbsp; (abre em nova aba)
  </a>
)}
