---
/**
 * The notice of a report page (ticket #118): the secondary-colour box with the info mark and one sentence, drawn
 * under the seal. `plain` is the left-aligned box of the wide outlier list; the default is the centred one.
 */
interface Props {
  text: string
  variant?: 'centered' | 'plain'
}
const { text, variant = 'centered' } = Astro.props
const box = variant === 'plain' ? 'mt-3 rounded-lg bg-secondary px-3 py-3 text-step-1 font-bold text-secondary-foreground' : 'mt-2 rounded-lg bg-secondary px-3 py-3 text-center text-step-1 font-bold text-secondary-foreground'
---
<p class={box} data-notice>
  <svg class="mr-1 inline-block -translate-y-px" viewBox="0 0 12 13" width="10" height="11" aria-hidden="true" focusable="false">
    <circle cx="6" cy="6.5" r="5.8" fill="none" stroke="currentColor" stroke-width="1.4" />
    <circle cx="6" cy="3.9" r="0.9" fill="currentColor" /><rect x="5.2" y="5.6" width="1.6" height="3.9" fill="currentColor" />
  </svg>
  {text}
</p>
