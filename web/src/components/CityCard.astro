---
/**
 * The city card of one city (the approved Sketch frame "2 Cartão da cidade", the port of site/src/slots/city/slot.ts).
 * Used as the page body of /:uf/:slug/ and — inert, aria-hidden — as the backdrop of /:uf/:slug/compartilhar/ (#50).
 * Pre-rendered with all six cycle/round panels in the HTML (no scripts needed to have every cycle) straight from the
 * city's own shard; the card script switches panels client-side and the page then loads nothing — no /data/ request.
 */
import { normalizeBase, withBase } from '@/paths'
import PageDataDownload from '@/components/PageDataDownload.astro'
import { cityDataPath, stateDataPath } from '@/lib/api'
import { SHARD_VERSION } from 'virtual:data-shards'
import { registerBootScript } from '@/lib/sentences/register-store'
import { loadCityShard, datasetFixture, loadPeersFile, loadCityNames, loadCuriositiesFile } from '@/lib/shard-files'
import { factsOf } from '@/lib/curiosities'
import { twinOf } from '@/lib/peers'
import { cityShardResult } from '@/lib/city-shard'
import { pickQuestion } from '@/lib/question'
import { displayName, ufLabel } from '@/shared/city-search'
import { CYCLES, type CityResult } from '@/shared/city-model'
import { cycleTabs, roundTabs } from '@/shared/components'
import { viewFigures, viewSentence, viewMargin, viewQuestion, viewTwin, headlineId } from '@/slots/city/card'
import { curiosityCard } from '@/slots/city/curiosities'
import { loadCityFacts } from '@/lib/facts/load'
import { factLinks } from '@/lib/facts/gate'
import { CURIOSITIES_PAGE, LATEST_CYCLE } from '@/lib/facts/model'
import { OLDER_ANCHORS } from '@/lib/facts/other'
import { getFactPage } from '@/lib/facts/pages'
import { defaultView, viewHref, viewId, type View } from '@/slots/city/city-view'

interface Props {
  uf: string
  slug: string
  /** The view to open; the card's own default (latest round of the latest cycle) when omitted. */
  view?: View
  /** Inert backdrop of the share sheet (#50): duplicates the card's landmarks, so it drops the shared #main id. */
  backdrop?: boolean
}

const { uf, slug, view: asked, backdrop = false } = Astro.props
const base = normalizeBase(import.meta.env.BASE_URL)
const href = (path: string) => withBase(base, path)
const here = href(`/${uf}/${slug}/`)
const shard = (await loadCityShard(uf, slug))!
const city = shard.city
const name = displayName(city.nome)
const fixture = await datasetFixture()
const overseas = city.uf === 'zz'
const question = pickQuestion(shard)
// Curiosities (#33): up to three rank facts; a city with too few peers has none, and then no card.
const curio = await loadCuriositiesFile()
const facts = curio && !backdrop ? factsOf(curio, uf, slug) : []
// The twin (#31): the closest comparable city of another state, from peers.json; none for an overseas post or a city without one.
const peers = await loadPeersFile()
const twinKey = peers && twinOf(peers, uf, slug)
const twinName = twinKey ? (await loadCityNames()).get(twinKey) : undefined
const twin = twinKey && twinName ? { name: displayName(twinName), uf: ufLabel(twinKey.split('/')[0]!), href: href(`/${twinKey}/`) } : undefined

// Every cycle and round the city has data in, pre-rendered; nothing here can be zeros.
const results = new Map<string, CityResult | undefined>()
for (const ano of CYCLES) for (const turno of [1, 2] as const) results.set(viewId({ ano, turno }), cityShardResult(shard, ano, turno))
const has = (ano: number, turno: 1 | 2) => !!results.get(viewId({ ano, turno }))
const view = asked ?? defaultView(has)

// The fact records (#61): every figure below links to its record ("ver cálculo"); factLinks fails the build for a figure with no record
// or a record with no source or no calculation, so no number of the card is published unexplained.
const cityFacts = (await loadCityFacts(uf, slug))!
// The earlier cycles have no fact page per city (it would triple the site): their links open the one page of the rules (`olderCyclesFacts`).
const olderLinks = factLinks((await getFactPage('metodo', 'ciclos-anteriores')).facts, `the city card /${uf}/${slug}/ (earlier cycles)`, base)
const linksOf = (page: string) => {
  if (page !== CURIOSITIES_PAGE && Number(page.split('-')[0]) < LATEST_CYCLE) return (anchor: string) => olderLinks(OLDER_ANCHORS[anchor] ?? anchor)
  return factLinks(cityFacts.pages.get(page) ?? [], `the city card /${uf}/${slug}/ (${page})`, base)
}

const banner = fixture ? 'EXEMPLO · DADOS FICTÍCIOS, NÃO SÃO RESULTADOS REAIS'.replace(' · ', '  ·  ') : undefined
const title = `${name} · ${ufLabel(city.uf)}`
const sub = overseas ? 'Voto no exterior' : `${fixture ? 'Município fictício' : 'Município'} · ${ufLabel(city.uf)}`
const shareBase = href(`/${uf}/${slug}/compartilhar/`)
const footer = fixture ? 'Dados fictícios para ilustrar o layout. Fonte real: TSE.' : 'Fonte: TSE, dados finais'
---
<div class="screen city-page">
  <script is:inline set:html={registerBootScript} />
  <header class="app-header">
    <a class="brand" href={href('/')}>Voto a Voto</a>
    <span class="app-header__sep" aria-hidden="true"></span>
    <span class="app-header__context">Presidente 2026</span>
  </header>
  <main class="page__main" id={backdrop ? undefined : 'main'}>
    {/* One column on a phone; from 1024 px two (#52): the card on the left, the sentence, Compartilhar and the links on the right. */}
    <div class="city-body">
      {banner && <div class="banner" role="note">{banner}</div>}
      <div class="city-left">
        <a class="back" href={href('/')}>‹ Início</a>
        <h1 class="page__title">{name}</h1>
        <p class="page__subtitle">{sub}</p>
        <Fragment set:html={viewQuestion(question, { cityName: name, overseas })} />
        <Fragment set:html={cycleTabs({ cycles: [...CYCLES], active: view.ano, hrefFor: (c) => viewHref(here, { ano: c, turno: view.turno }) })} />
        <Fragment set:html={roundTabs({ active: view.turno, hrefFor: (t) => viewHref(here, { ano: view.ano, turno: t }) })} />
        <div
          class="city-card"
          data-city-card
          data-view={viewId(view)}
          data-path={here}
          data-uf={city.uf}
          data-slug={city.slug}
        >
          {[...results].map(([id, r]) => <div class="city-panel" data-view={id} hidden={id !== viewId(view)} role={r ? 'group' : undefined} aria-describedby={r ? headlineId(id) : undefined} set:html={viewFigures(r, { cityName: name, overseas }, linksOf(id))} />)}
        </div>
        {/* Under the figures from 1024 px; on a phone the CSS orders it after the twin line, before Compartilhar. A city with no fact has no card. */}
        {facts.length > 0 && <div class="city-curio" set:html={curiosityCard(facts, 'card', linksOf(CURIOSITIES_PAGE))} />}
      </div>
      <div class="city-right">
        <div class="city-words" data-city-words>
          {[...results].map(([id, r]) => <div class="city-panel" data-view={id} hidden={id !== viewId(view)} set:html={viewSentence(r, { cityName: name, overseas }, id, linksOf(id))} />)}
        </div>
        <div class="city-margin-lines" data-city-words>
          {[...results].map(([id, r]) => <div class="city-panel" data-view={id} hidden={id !== viewId(view)} set:html={viewMargin(r, { cityName: name, overseas }, linksOf(id))} />)}
        </div>
        <Fragment set:html={viewTwin(twin, { cityName: name, overseas })} />
        <a class="city-share" href={`${shareBase}?ciclo=${view.ano}&turno=${view.turno}`} data-share data-base={shareBase}>Compartilhar</a>
        <nav class="city-links" aria-label="Mais sobre a cidade">
          <a href={href('/comparar/2022/')}>Comparar com 2022 e 2018 ›<span class="city-links__sub">Margem e virada, por estado</span></a>
          <a href={here + 'tres-ciclos/'}>Ver os três ciclos ›<span class="city-links__sub">2018, 2022 e 2026 lado a lado</span></a>
          <a href={href(`/cara-a-cara/?nivel=cidade&a=${uf}/${slug}`)} data-link="duel">Comparar com outra cidade ›<span class="city-links__sub">Cara a cara, lado a lado</span></a>
          {overseas ? '' : <a href={href(`/${uf}/`)}>Ver o estado ›<span class="city-links__sub">Municípios do estado e mapa</span></a>}
        </nav>
      </div>
    </div>
  </main>
  {!backdrop && <PageDataDownload href={href(cityDataPath(SHARD_VERSION, uf, slug))} filename={`${uf}-${slug}.json`} />}
  <footer class="source-footer" data-component="source-footer">
    {footer}<a class="source-footer__about" href={href('/sobre-os-dados/')}>Sobre os dados ›</a>
  </footer>
</div>
<slot />