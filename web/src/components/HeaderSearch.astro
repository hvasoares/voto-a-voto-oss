---
/**
 * The pre-rendered city-search field of the app header (ticket #153; the markup the desktop top bar drew alone since #51). Readable and
 * usable without scripts (the search itself needs them, as everywhere). It is NOT an Astro island: an island would put the island runtime
 * and its props in the HTML of every page. `scripts/desktop-shell.ts` mounts the real CitySearch (React, cmdk) into `[data-topbar-search]`
 * on the first interaction, on a phone as on a desktop, so nothing of it downloads before that. `kbd` draws the "/" shortcut hint (desktop). The field is 44 px high on a phone (a finger target), 40 px in the top bar.
 */
import { siteBase } from '@/paths'

interface Props {
  /** The "/" key hint inside the field (the desktop bar). */
  kbd?: boolean
}
const { kbd = false } = Astro.props
---
<div class="relative">
  <div data-topbar-search data-base={siteBase()}>
    <div class="relative" data-city-search="bar">
      <svg class="hs-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false"><circle cx="6.5" cy="6.5" r="6" fill="none" stroke="currentColor" stroke-width="1.9"></circle><path d="M16.2 12.2 12.4 16.8" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
      <input class="hs-input" type="text" aria-label="Ver minha cidade" placeholder="Ver minha cidade" autocomplete="off" />
    </div>
  </div>
  {kbd && <kbd class="pointer-events-none absolute right-3 top-[10px] rounded-sm border border-border bg-secondary px-2 text-step-1 text-muted-foreground" aria-hidden="true">/</kbd>}
</div>
