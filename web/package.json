{
  "name": "voto-a-voto-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "jsqr": "^1.4.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "serve": "tsx scripts/serve.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:shards": "tsx scripts/shard-check.ts",
    "check:perf": "tsx scripts/perf-budgets.ts",
    "check:peers": "tsx scripts/peers-check.ts",
    "check:shards:real": "DATA_DIR=../data tsx scripts/shard-check.ts",
    "check:tse-live": "DATA_DIR=../data tsx scripts/verify-tse-live.ts",
    "test:e2e": "playwright test --project=phone",
    "test:real": "DATA_DIR=../data E2E_PORT=4176 playwright test --project=real",
    "capture": "playwright test --project=capture",
    "build:production": "BUILD_TARGET=production OUT_DIR=dist-production astro build",
    "test:cdn": "playwright test -c playwright.cdn.config.ts",
    "test:e2e:donation": "PUBLIC_DONATION_URL=https://doacao.example.test/apoie playwright test --project=phone donation",
    "test:e2e:production": "E2E_MODE=production playwright test --project=phone"
  }
}
